#!/usr/bin/env bash
# smriti pr-title-rewrite — prefix a PR title with `v<VERSION> ` deterministically.
#
# Idempotent:
#   - If title already starts with "v<VERSION> ", returned unchanged.
#   - If title starts with "v<other-version> ", the old prefix is replaced.
#   - Otherwise, "v<VERSION> " is prepended.
#
# Usage:
#   smriti pr-title-rewrite <version> <title>
#
# Examples:
#   smriti pr-title-rewrite 1.2.3 "fix(ship): drift"        → "v1.2.3 fix(ship): drift"
#   smriti pr-title-rewrite 1.2.3 "v1.2.3 fix(ship): drift" → "v1.2.3 fix(ship): drift"
#   smriti pr-title-rewrite 1.2.3 "v1.0.0 fix(ship): drift" → "v1.2.3 fix(ship): drift"
#
# Exit codes:
#   0   success
#   2   missing args, or version not 3-part semver
#
# Defense: uses literal `case` prefix matching, NOT bash's parameter-expansion
# `${var#pattern}` operator. Glob metacharacters in version strings (e.g.
# someone passes "1.*.0" by mistake) would otherwise mismatch silently.
set -e

SEMVER_RE='^[0-9]+\.[0-9]+\.[0-9]+$'

VERSION="${1:-}"
TITLE="${2:-}"

if [ -z "$VERSION" ] || [ -z "$TITLE" ]; then
  echo "usage: smriti pr-title-rewrite <version> <title>" >&2
  exit 2
fi

if [[ ! "$VERSION" =~ $SEMVER_RE ]]; then
  echo "smriti-pr-title-rewrite: '$VERSION' is not a valid 3-part semver (X.Y.Z)" >&2
  exit 2
fi

# Strip an existing "v<old-version> " prefix if present.
# We can't use ${TITLE#v*\ } because that's a glob and would mismatch on
# titles containing spaces in unexpected ways. Walk character-by-character
# instead — only strip if the prefix is literally "v" + digits + "." +
# digits + "." + digits + " ".
if [[ "$TITLE" =~ ^v[0-9]+\.[0-9]+\.[0-9]+\  ]]; then
  STRIPPED="${TITLE#${BASH_REMATCH[0]}}"
else
  STRIPPED="$TITLE"
fi

printf 'v%s %s\n' "$VERSION" "$STRIPPED"
