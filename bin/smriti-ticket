#!/usr/bin/env bash
# smriti ticket — the work layer: work items and the index of documents about them.
# State: $SMRITI_HOME/factory.db   (schema: lib/factory-schema.sql)
#
# Subcommands:
#   smriti ticket add <title> [--repo S] [--project P] [--body T] [--priority N] [--ready]
#   smriti ticket list [--repo S] [--project P] [--status S] [--all] [--json]
#                      [--unblocked | --blocked]
#   smriti ticket show <id> [--json]
#   smriti ticket start <id> [--force]        cut/attach a worktree; prints its path
#   smriti ticket dep <id> --blocks <id> | --blocked-by <id> | --rm <id>
#   smriti ticket deps [--json]               the whole dependency graph
#   smriti ticket edit <id> [--title T] [--body T] [--priority N] [--repo S]
#                           [--project P | --no-project]
#   smriti ticket cancel <id>                 park it out of the way, reversibly
#   smriti ticket rm <id> [--yes]             delete it and its document rows
#   smriti ticket pr <id> <url>               record the PR and move to in_review
#   smriti ticket move <id> --before <id>|--after <id>|--top|--bottom
#   smriti ticket status <id> <status>        idea|ready|in_progress|in_review|shipped|cancelled
#   smriti ticket done <id>                   shorthand for `status <id> shipped`
#   smriti ticket doc <id|-> --type T --path P [--branch B]
#   smriti ticket docs [--json]               the whole document index
#   smriti ticket current [--json]            the ticket for this branch, as `KEY=value`
#
# Exit codes:
#   0  ok
#   2  usage error
#   3  sqlite3 or schema missing
#   4  no such ticket
#   5  could not create or attach the worktree
#   6  a reorder named a target in another app or project
#   7  refused: the ticket is blocked, or the edge would close a cycle
#
# A ticket belongs to a project, or to an app directly (a one-off bug), or to
# neither — an idea, capturable from anywhere, including outside a git repo.
# Both edges are optional on purpose; see lib/factory-schema.sql.
#
# Documents are *indexed*, never stored: `doc` records where a markdown file
# lives so a ticket can carry its paper trail, while the file on disk under
# ~/.smriti/projects/<slug>/ stays the source of truth. This deliberately does
# not touch the filename contract in bin/smriti-latest-doc.

set -e

SMRITI_TOOL=smriti-ticket

# Resolve our own dir through the full symlink chain before dirname: the install
# puts a symlink on PATH, and a multi-hop chain would otherwise resolve
# SMRITI_LIB to the wrong directory, making every call here hard-exit with
# "schema not found". Same loop as bin/smriti.
_self="$0"
while [ -L "$_self" ]; do
  _target=$(readlink "$_self")
  case "$_target" in
    /*) _self="$_target" ;;
    *)  _self="$(cd "$(dirname "$_self")" && pwd -P)/$_target" ;;
  esac
done
SMRITI_BIN="$(cd "$(dirname "$_self")" && pwd -P)"
SMRITI_LIB="$(cd "$SMRITI_BIN/../lib" && pwd -P)"
unset _self

# shellcheck source=../lib/factory-db.sh
. "$SMRITI_LIB/factory-db.sh"

VALID_STATUSES="idea ready in_progress in_review shipped cancelled"
VALID_DOC_TYPES="plan debug design audit"

usage() {
  cat <<'USAGE' >&2
usage:
  smriti ticket add <title> [--repo S] [--project P] [--body T] [--priority N] [--ready]
  smriti ticket list [--repo S] [--project P] [--status S] [--all] [--json]
                     [--unblocked | --blocked]
  smriti ticket show <id> [--json]
  smriti ticket start <id> [--force]
  smriti ticket edit <id> [--title T] [--body T] [--priority N] [--repo S]
                          [--project P | --no-project]
  smriti ticket move <id> <--before <id> | --after <id> | --top | --bottom>
  smriti ticket cancel <id>
  smriti ticket rm <id> [--yes]
  smriti ticket pr <id> <url>
  smriti ticket status <id> <idea|ready|in_progress|in_review|shipped|cancelled>
  smriti ticket done <id>
  smriti ticket dep <id> <--blocks <id> | --blocked-by <id> | --rm <id>>
  smriti ticket deps [--json]
  smriti ticket doc <id|-> --type <plan|debug|design|audit> --path P [--branch B]
  smriti ticket docs [--json]
  smriti ticket current [--json]
USAGE
  exit 2
}

# ─── helpers ────────────────────────────────────────────────────────────────
# die, require_num, current_slug and current_branch come from factory-db.sh.

require_id() { require_num "$1" "ticket id"; }

ticket_exists() {
  [ "$(db "SELECT count(*) FROM tickets WHERE id = $1;")" = "1" ]
}

# ── the scope a position lives in ───────────────────────────────────────────
# One (app, project) pair — the group the board draws as one grid, and the only
# set a position is ever compared against. Written once here because it is the
# invariant that must not drift: `add`, `edit`'s re-file and `move` all have to
# agree on what a group IS, and three hand-written copies of the same predicate
# is three chances for them to stop agreeing.
#
# coalesce on both halves because NULL = NULL is not true in SQL. Without it
# every app-less idea would count as a group of one, and they would all be born
# at position 1 with nothing to order them against.
#
# Both arguments are SQL fragments, already quoted or the literal NULL.
scope_sql() {
  printf "coalesce(repo_slug, '') = coalesce(%s, '') AND coalesce(project_id, -1) = coalesce(%s, -1)" "$1" "$2"
}

# One past the last position in that scope — where a new or newly re-filed
# ticket lands. $3, when given, is a ticket id to exclude, so a row being moved
# never counts itself.
bottom_of_scope() {
  printf "(SELECT coalesce(max(position), 0) + 1 FROM tickets WHERE %s%s)" \
    "$(scope_sql "$1" "$2")" "${3:+ AND id <> $3}"
}

# ─── dependencies ───────────────────────────────────────────────────────────
#
# One row in ticket_deps says blocker_id must land before blocked_id can start.
# Nothing about that is stored on the tickets themselves; every question below
# is answered by joining, so a status change anywhere is immediately reflected
# everywhere and there is no derived column to fall out of date.

# A blocker stops blocking once it is shipped OR cancelled. Cancelled matters:
# it is a decision that the work will not happen, and if it still blocked, then
# cancelling a ticket would strand everything downstream of it with no way out.
# in_review is deliberately NOT satisfied — a PR that has not merged has not
# landed, and `ticket pr` sets in_review long before `smriti clean` confirms it.
#
# Takes the table alias, because several queries below join `tickets` twice and
# an unqualified `status` in those is a bug waiting to be written.
dep_satisfied() { printf "%s.status IN ('shipped','cancelled')" "$1"; }

# The blockers of $1 that have not landed yet, one `#id  status  title` per line.
# Empty output means nothing is in the way.
open_blockers() {
  db "SELECT '#' || t.id || char(9) || t.status || char(9) || t.title
        FROM ticket_deps d JOIN tickets t ON t.id = d.blocker_id
       WHERE d.blocked_id = $1 AND NOT ($(dep_satisfied t))
       ORDER BY t.id;"
}

# How many blockers of $1 are still open. The scalar form, for the hot paths
# that only need to know whether to refuse.
open_blocker_count() {
  db "SELECT count(*) FROM ticket_deps d JOIN tickets t ON t.id = d.blocker_id
       WHERE d.blocked_id = $1 AND NOT ($(dep_satisfied t));"
}

# Cycles are refused rather than tolerated because the frontier query is the
# whole point of this feature: inside a cycle, "what can I start" has no answer
# at all, and a dispatcher looping on it would either spin or stall. The check
# itself lives inside cmd_dep's INSERT, so that it and the write share one lock.

# Tickets that were waiting on $1 and now have nothing left in the way. Called
# after $1 becomes shipped or cancelled, so its own row already reads satisfied.
# Started tickets are excluded: they are already being worked, and announcing
# them as newly available would be noise.
freed_by() {
  db "SELECT '#' || t.id || char(9) || t.title
        FROM ticket_deps d JOIN tickets t ON t.id = d.blocked_id
       WHERE d.blocker_id = $1
         AND NOT ($(dep_satisfied t))
         AND t.branch IS NULL
         AND NOT EXISTS (
           SELECT 1 FROM ticket_deps d2 JOIN tickets b ON b.id = d2.blocker_id
            WHERE d2.blocked_id = t.id AND NOT ($(dep_satisfied b)))
       ORDER BY t.id;"
}

# Say what shipping or cancelling $1 just made startable. Best-effort narration
# on stdout: this is the moment the graph pays for itself, and finding out a
# week later that something was unblocked is the failure it exists to prevent.
announce_freed() {
  local freed; freed=$(freed_by "$1")
  [ -n "$freed" ] || return 0
  local ids; ids=$(printf '%s\n' "$freed" | cut -f1 | paste -sd' ' -)
  echo "  unblocks $ids"
}

validate_status() {
  case " $VALID_STATUSES " in
    *" $1 "*) ;;
    *) die "invalid status '$1' (expected: $VALID_STATUSES)" ;;
  esac
}

validate_doc_type() {
  case " $VALID_DOC_TYPES " in
    *" $1 "*) ;;
    *) die "invalid --type '$1' (expected: $VALID_DOC_TYPES)" ;;
  esac
}

# Resolve the app for a write. Explicit --repo wins; otherwise derive from the
# repo we're standing in. An empty result is FINE and means "no app yet" — an
# idea. This used to refuse outside a git repo, which made a stray thought
# impossible to capture at the moment you had it.
resolve_repo() {
  local explicit="$1"
  if [ "$explicit" = "-" ]; then printf ''; return 0; fi
  if [ -n "$explicit" ]; then
    validate_slug_shape "$explicit" "--repo"
    printf '%s' "$explicit"
    return 0
  fi
  current_slug
}

# Resolve a project reference (id or slug) to an id, scoped to an app when one
# is known. A slug is only unique within an app, so an ambiguous one is an
# error rather than a guess.
resolve_project_ref() {
  local ref="$1" repo="${2:-}"
  [ -n "$ref" ] || { printf ''; return 0; }
  case "$ref" in
    ''|*[!0-9]*) ;;
    *) local hit; hit=$(db "SELECT id FROM projects WHERE id = $ref;")
       [ -n "$hit" ] || die "no project #$ref" 4
       printf '%s' "$hit"; return 0 ;;
  esac
  validate_slug_shape "$ref" "--project"
  local where="WHERE slug = $(sql_quote "$ref")"
  [ -n "$repo" ] && where="$where AND repo_slug IS $(sql_quote_or_null "$repo")"
  local hits; hits=$(db "SELECT count(*) FROM projects $where;")
  if [ "$hits" = "0" ]; then
    die "no project '$ref'${repo:+ in $repo}" 4
  elif [ "$hits" != "1" ]; then
    die "'$ref' names $hits projects across apps — pass --repo <slug> to say which"
  fi
  db "SELECT id FROM projects $where;"
}

# The app a project lives in. A ticket filed into a project inherits it, so
# `--project` alone is enough and cannot disagree with the project's own app.
repo_of_project() {
  [ -n "$1" ] || { printf ''; return 0; }
  db "SELECT coalesce(repo_slug,'') FROM projects WHERE id = $1;"
}

# ─── add ────────────────────────────────────────────────────────────────────

cmd_add() {
  local title="" body="" repo="" project="" priority=0 status="idea"
  [ $# -gt 0 ] || usage
  title="$1"; shift
  case "$title" in -*) usage ;; esac

  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)     [ $# -ge 2 ] && [ -n "$2" ] || die "--repo requires a value (use '-' for no app)";    repo="$2";    shift 2 ;;
      --project)  [ $# -ge 2 ] && [ -n "$2" ] || die "--project requires a value (use --no-project to detach)"; project="$2"; shift 2 ;;
      --body)     [ $# -ge 2 ] || die "--body requires a value";    body="$2";    shift 2 ;;
      --priority) [ $# -ge 2 ] || die "--priority requires a value"; priority="$2"; shift 2 ;;
      --ready)    status="ready"; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  require_num "$priority" "--priority"
  [ -n "$title" ] || die "title must not be empty"
  # A title is one line. Multi-line titles broke the tab-delimited reads that
  # `list` and `start` rely on — put the detail in --body instead.
  # $'\n' and not "$(printf '\n')": command substitution strips trailing
  # newlines, so that form is an empty pattern that matches every title.
  case "$title" in
    *$'\n'*) die "title must be a single line — put detail in --body" ;;
  esac

  local slug ts project_id
  slug=$(resolve_repo "$repo")
  project_id=$(resolve_project_ref "$project" "$slug")
  # A project knows its own app; filing into one settles the question.
  if [ -n "$project_id" ]; then
    slug=$(repo_of_project "$project_id")
  fi
  ts=$(now_utc)

  # last_insert_rowid() is per-connection, so it has to ride along inside the
  # same db_write rather than being fetched by a second invocation.
  #
  # position lands at the BOTTOM of the group it joins — capture is a quick,
  # frequent act and it must never disturb an order you arranged by hand.
  local id
  id=$(db_write "INSERT INTO tickets (repo_slug, project_id, title, body, status, priority, position, created_at, updated_at)
            VALUES ($(sql_quote_or_null "$slug"), ${project_id:-NULL}, $(sql_quote "$title"), $(sql_quote_or_null "$body"),
                    $(sql_quote "$status"), $priority,
                    $(bottom_of_scope "$(sql_quote_or_null "$slug")" "${project_id:-NULL}"),
                    $(sql_quote "$ts"), $(sql_quote "$ts"));
            SELECT last_insert_rowid();")

  local where="${slug:-no app yet}"
  [ -n "$project_id" ] && where="$where / $(db "SELECT name FROM projects WHERE id = $project_id;")"
  echo "added: #$id  $title  ($where, $status)"
}

# ─── list ───────────────────────────────────────────────────────────────────

cmd_list() {
  local repo="" project="" status="" all=0 json=0 repo_given=0 dep_filter=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)    [ $# -ge 2 ] && [ -n "$2" ] || die "--repo requires a value (use '-' for no app)"; repo="$2"; repo_given=1; shift 2 ;;
      --project) [ $# -ge 2 ] && [ -n "$2" ] || die "--project requires a value"; project="$2"; shift 2 ;;
      --status)  [ $# -ge 2 ] || die "--status requires a value";  status="$2";  shift 2 ;;
      --all)  all=1; shift ;;
      --json) json=1; shift ;;
      --unblocked) [ -z "$dep_filter" ] || die "--unblocked and --blocked are opposites; pass one"; dep_filter=unblocked; shift ;;
      --blocked)   [ -z "$dep_filter" ] || die "--unblocked and --blocked are opposites; pass one"; dep_filter=blocked;   shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  if ! factory_db_exists; then
    [ "$json" -eq 1 ] && { echo '[]'; return 0; }
    echo "no tickets yet — add one with: smriti ticket add \"<what you want>\""
    return 0
  fi

  local where="WHERE 1=1"
  if [ -n "$project" ]; then
    local pid; pid=$(resolve_project_ref "$project" "$([ "$repo_given" -eq 1 ] && printf '%s' "$repo" || current_slug)")
    where="$where AND project_id = $pid"
  elif [ "$repo_given" -eq 1 ]; then
    if [ "$repo" = "-" ]; then
      where="$where AND repo_slug IS NULL"
    else
      where="$where AND repo_slug = $(sql_quote "$repo")"
    fi
  elif [ "$all" -eq 0 ]; then
    local slug; slug=$(current_slug)
    [ -n "$slug" ] && where="$where AND repo_slug = $(sql_quote "$slug")"
  fi
  if [ -n "$status" ]; then
    validate_status "$status"
    where="$where AND status = $(sql_quote "$status")"
  elif [ "$all" -eq 0 ]; then
    # Shipped work is history; it clutters the working view unless asked for.
    where="$where AND status NOT IN ('shipped','cancelled')"
  fi

  # The frontier. `--unblocked` means STARTABLE, not merely un-blocked, and the
  # difference is what keeps an autonomous dispatcher honest:
  #
  #   - every blocker shipped or cancelled, and
  #   - the ticket itself still open, and
  #   - it has not already been started.
  #
  # That last clause is the load-bearing one. `ticket start` is idempotent: on a
  # ticket that already has a worktree it attaches and exits 0. So a frontier
  # defined only as "blockers satisfied" would hand a dispatcher work that is
  # already running, forever, and start would keep saying yes. Excluding started
  # tickets is what actually prevents a double-start; idempotence is the net
  # underneath, not the check itself.
  local unblocked_sql="NOT EXISTS (
        SELECT 1 FROM ticket_deps d JOIN tickets b ON b.id = d.blocker_id
         WHERE d.blocked_id = tickets.id AND NOT ($(dep_satisfied b)))"
  case "$dep_filter" in
    unblocked)
      where="$where AND $unblocked_sql
             AND status NOT IN ('shipped','cancelled')
             AND branch IS NULL AND worktree_path IS NULL" ;;
    # The complement, over the same open-and-unstarted population, so that no
    # open ticket is in both lists and none is in neither.
    blocked)
      where="$where AND NOT ($unblocked_sql)
             AND status NOT IN ('shipped','cancelled')
             AND branch IS NULL AND worktree_path IS NULL" ;;
  esac

  # The order you dragged. This used to be `priority DESC, id ASC` while the
  # board sorted by status band first — two surfaces answering the same question
  # differently. `position` is now the one answer, seeded at migration from what
  # the board was already showing, so the board is unchanged and this listing is
  # the one that moved.
  #
  # Grouped by scope BEFORE position, because a position is only comparable
  # within one (app, project) — the group the board draws. Sorting a flat,
  # multi-scope listing on position alone interleaves them into nonsense: an
  # app with a project and some loose tickets came out 1, 3, 2, 4 as the two
  # scopes' independent numbering took turns. The grouping mirrors the board:
  # apps first with app-less ideas last, and within an app its projects before
  # its loose work.
  local order="ORDER BY (repo_slug IS NULL), repo_slug,
                        (project_id IS NULL), coalesce(project_id, 0),
                        position ASC, id ASC"

  if [ "$json" -eq 1 ]; then
    # Deliberately NOT called project_slug: that key existed in v1.2 and held
    # the REPOSITORY. Reusing the name for a different entity would break every
    # existing reader silently, one wrong value at a time.
    db_json "SELECT id, repo_slug, project_id,
                    (SELECT slug FROM projects p WHERE p.id = tickets.project_id) AS project_ref,
                    (SELECT name FROM projects p WHERE p.id = tickets.project_id) AS project_name,
                    title, body, status, priority, position, branch,
                    worktree_path, pr_url, origin, created_at, updated_at
             FROM tickets $where $order;"
    return 0
  fi

  # char(9), not '\t' — SQLite string literals have no backslash escapes, so
  # '\t' would be a literal backslash-t and the awk split below would never fire.
  local rows
  rows=$(db "SELECT id || char(9) || status || char(9) || coalesce(repo_slug,'—') || char(9) || title
             FROM tickets $where $order;")
  if [ -z "$rows" ]; then
    # An empty frontier is a real answer about a full backlog, not an empty
    # store — saying "no tickets yet" there would be a lie.
    case "$dep_filter" in
      unblocked) echo "nothing startable — every open ticket is blocked or already started" ;;
      blocked)   echo "nothing is blocked" ;;
      *)         echo "no tickets yet — add one with: smriti ticket add \"<what you want>\"" ;;
    esac
    return 0
  fi
  printf '%s\n' "$rows" | awk -F'\t' '{ printf "%-5s %-12s %-22s %s\n", "#" $1, $2, $3, $4 }'
}

# ─── show ───────────────────────────────────────────────────────────────────

cmd_show() {
  local id="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || usage
  require_id "$id"
  ticket_exists "$id" || die "no ticket #$id" 4

  if [ "$json" -eq 1 ]; then
    local t d by bl
    t=$(db_json_one "SELECT * FROM tickets WHERE id = $id;")
    d=$(db_json "SELECT id, type, path, branch, created_at FROM documents WHERE ticket_id = $id ORDER BY id;")
    # Both directions inline, so asking about ONE ticket never means fetching
    # the whole graph to find out what it is waiting on.
    by=$(db_json "SELECT t.id, t.title, t.status, t.repo_slug,
                         CASE WHEN $(dep_satisfied t) THEN 0 ELSE 1 END AS blocking
                    FROM ticket_deps d JOIN tickets t ON t.id = d.blocker_id
                   WHERE d.blocked_id = $id ORDER BY t.id;")
    bl=$(db_json "SELECT t.id, t.title, t.status, t.repo_slug
                    FROM ticket_deps d JOIN tickets t ON t.id = d.blocked_id
                   WHERE d.blocker_id = $id ORDER BY t.id;")
    printf '{"ticket":%s,"documents":%s,"blocked_by":%s,"blocks":%s}\n' "$t" "$d" "$by" "$bl"
    return 0
  fi

  db "SELECT '#' || id || '  ' || title || char(10) ||
             'app:      ' || coalesce(repo_slug, '— (an idea, no app yet)') || char(10) ||
             'project:  ' || coalesce((SELECT name FROM projects p WHERE p.id = tickets.project_id),
                                      '— (loose in the app)') || char(10) ||
             'status:   ' || status || char(10) ||
             'priority: ' || priority || char(10) ||
             'branch:   ' || coalesce(branch, '—') || char(10) ||
             'worktree: ' || coalesce(worktree_path, '—') || char(10) ||
             'pr:       ' || coalesce(pr_url, '—') || char(10) ||
             'created:  ' || created_at ||
             coalesce(char(10) || char(10) || body, '')
      FROM tickets WHERE id = $id;"

  # An open blocker is marked, a satisfied one is not, so the section answers
  # "can I start this" at a glance rather than making you cross-reference the
  # statuses yourself. The far end names its app when it lives in another one —
  # a bare #41 is not something you can place.
  local by bl
  by=$(db "SELECT '  ' || CASE WHEN $(dep_satisfied t) THEN '  ' ELSE '• ' END
                  || '#' || t.id || '  ' || t.status
                  || CASE WHEN coalesce(t.repo_slug,'') <> coalesce(
                              (SELECT repo_slug FROM tickets WHERE id = $id), '')
                          THEN '  (' || coalesce(t.repo_slug, 'no app') || ')' ELSE '' END
                  || '  ' || t.title
             FROM ticket_deps d JOIN tickets t ON t.id = d.blocker_id
            WHERE d.blocked_id = $id ORDER BY t.id;")
  if [ -n "$by" ]; then
    echo
    echo "blocked by:"
    printf '%s\n' "$by"
  fi

  bl=$(db "SELECT '  #' || t.id || '  ' || t.status
                  || CASE WHEN coalesce(t.repo_slug,'') <> coalesce(
                              (SELECT repo_slug FROM tickets WHERE id = $id), '')
                          THEN '  (' || coalesce(t.repo_slug, 'no app') || ')' ELSE '' END
                  || '  ' || t.title
             FROM ticket_deps d JOIN tickets t ON t.id = d.blocked_id
            WHERE d.blocker_id = $id ORDER BY t.id;")
  if [ -n "$bl" ]; then
    echo
    echo "blocks:"
    printf '%s\n' "$bl"
  fi

  local docs
  docs=$(db "SELECT '  ' || type || '  ' || path FROM documents WHERE ticket_id = $id ORDER BY id;")
  if [ -n "$docs" ]; then
    echo
    echo "documents:"
    printf '%s\n' "$docs"
  fi
}

# ─── dep / deps (what has to land before what) ──────────────────────────────

cmd_dep() {
  [ $# -ge 1 ] || usage
  local id="$1"; shift
  require_id "$id"
  ticket_exists "$id" || die "no ticket #$id" 4

  # Collected as parallel arrays of (blocker, blocked) so a single invocation
  # can draw several edges, and so BOTH flags can appear in one call.
  local -a add_blocker=() add_blocked=() drop=()
  local n=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --blocks)
        [ $# -ge 2 ] || die "--blocks requires a ticket id"
        require_id "$2"; add_blocker+=("$id"); add_blocked+=("$2"); n=$((n+1)); shift 2 ;;
      --blocked-by)
        [ $# -ge 2 ] || die "--blocked-by requires a ticket id"
        require_id "$2"; add_blocker+=("$2"); add_blocked+=("$id"); n=$((n+1)); shift 2 ;;
      --rm)
        [ $# -ge 2 ] || die "--rm requires a ticket id"
        require_id "$2"; drop+=("$2"); n=$((n+1)); shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  [ "$n" -gt 0 ] || die "say which way it goes: --blocks <id>, --blocked-by <id> or --rm <id>"

  local i other
  for i in "${drop[@]:-}"; do
    [ -n "$i" ] || continue
    ticket_exists "$i" || die "no ticket #$i" 4
    # Either direction, because you should not have to remember which way you
    # drew it to be able to undo it.
    local gone
    gone=$(db_write "DELETE FROM ticket_deps
                      WHERE (blocker_id = $id AND blocked_id = $i)
                         OR (blocker_id = $i AND blocked_id = $id);
                     SELECT changes();")
    if [ "$gone" = "0" ]; then
      echo "smriti-ticket: no dependency between #$id and #$i" >&2
    else
      echo "#$id ⇸ #$i  dependency removed"
    fi
  done

  local k=0
  while [ "$k" -lt "${#add_blocker[@]}" ]; do
    local blocker="${add_blocker[$k]}" blocked="${add_blocked[$k]}"
    k=$((k+1))
    [ "$blocker" = "$blocked" ] && die "#$blocker cannot block itself" 7
    other=$([ "$blocker" = "$id" ] && echo "$blocked" || echo "$blocker")
    ticket_exists "$other" || die "no ticket #$other" 4

    # The cycle guard rides ON the insert rather than preceding it, so the check
    # and the write are one statement under one lock: db_write opens BEGIN
    # IMMEDIATE, so a second worktree cannot slip an edge in between a separate
    # probe and its insert and leave a cycle neither of us would have allowed.
    #
    # Walk forward from `blocked` along the edges that already exist; if
    # `blocker` is reachable that way, this edge would close the loop.
    # INSERT OR IGNORE makes re-drawing an existing edge a no-op, per the
    # primary key.
    local wrote
    wrote=$(db_write "INSERT OR IGNORE INTO ticket_deps (blocker_id, blocked_id, created_at)
                        SELECT $blocker, $blocked, $(sql_quote "$(now_utc)")
                         WHERE NOT EXISTS (
                           WITH RECURSIVE reach(id) AS (
                             SELECT $blocked
                             UNION
                             SELECT d.blocked_id FROM ticket_deps d JOIN reach r ON d.blocker_id = r.id
                           ) SELECT 1 FROM reach WHERE id = $blocker
                         );
                      SELECT changes();")
    if [ "$wrote" = "0" ]; then
      # Nothing written: either the edge was already there, or the guard fired.
      # Only this rare path pays for a second query to tell them apart.
      if [ "$(db "SELECT count(*) FROM ticket_deps
                   WHERE blocker_id = $blocker AND blocked_id = $blocked;")" = "1" ]; then
        echo "#$blocker → #$blocked  already recorded"
        continue
      fi
      die "#$blocker → #$blocked would close a dependency cycle (#$blocked already leads back to #$blocker)" 7
    fi
    echo "#$blocker → #$blocked  must land first"
  done
}

cmd_deps() {
  local json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  # Asking must never CREATE the store, exactly as `list` and `docs` do not.
  if ! factory_db_exists; then
    if [ "$json" -eq 1 ]; then echo "[]"; else echo "no dependencies yet"; fi
    return 0
  fi

  if [ "$json" -eq 1 ]; then
    # The whole graph in one call, so the board joins it client-side per ticket
    # the way it already joins documents — one payload per refresh, never one
    # request per card.
    db_json "SELECT blocker_id, blocked_id, created_at,
                    (SELECT status FROM tickets WHERE id = blocker_id) AS blocker_status
               FROM ticket_deps ORDER BY blocker_id, blocked_id;"
    return 0
  fi

  local rows
  rows=$(db "SELECT '#' || d.blocker_id || char(9) || b.title || char(9)
                    || '#' || d.blocked_id || char(9) || t.title || char(9)
                    || CASE WHEN $(dep_satisfied b) THEN 'landed' ELSE 'waiting' END
               FROM ticket_deps d
               JOIN tickets b ON b.id = d.blocker_id
               JOIN tickets t ON t.id = d.blocked_id
              ORDER BY d.blocker_id, d.blocked_id;")
  if [ -z "$rows" ]; then
    echo "no dependencies yet — draw one with: smriti ticket dep <id> --blocks <id>"
    return 0
  fi
  printf '%s\n' "$rows" \
    | awk -F'\t' '{ printf "%-5s %-28.28s  blocks  %-5s %-28.28s  %s\n", $1, $2, $3, $4, $5 }'
}

# ─── start ──────────────────────────────────────────────────────────────────

# slugify() and repo_path_for_slug() live in lib/factory-db.sh: smriti-repo
# needs both identically, and one copy is what stops the two from drifting.

# The primary worktree of a repo — the one branch-lifecycle commands must run
# against. `git worktree list --porcelain` lists it first.
primary_worktree() {
  git -C "$1" worktree list --porcelain 2>/dev/null \
    | awk '/^worktree /{print substr($0,10); exit}'
}

# Worktrees live inside the repo, so without this the primary reads as
# permanently dirty (an untracked .claude/worktrees/) and every later
# `smriti clean` refuses. Written to .git/info/exclude rather than .gitignore:
# this is a local tool artifact, not something to commit into someone's repo.
ignore_worktrees_dir() {
  local repo="$1" gitdir exclude
  gitdir=$(git -C "$repo" rev-parse --git-common-dir 2>/dev/null) || return 0
  case "$gitdir" in /*) ;; *) gitdir="$repo/$gitdir" ;; esac
  exclude="$gitdir/info/exclude"
  mkdir -p "$(dirname "$exclude")" 2>/dev/null || return 0
  [ -f "$exclude" ] || : > "$exclude"
  grep -qxF '.claude/worktrees/' "$exclude" 2>/dev/null && return 0
  printf '%s\n' '.claude/worktrees/' >> "$exclude"
}

cmd_start() {
  [ $# -ge 1 ] || usage
  local id="$1"; shift
  require_id "$id"
  ticket_exists "$id" || die "no ticket #$id" 4

  local force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force|-f) force=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  # One sqlite3 process for all four columns; see db_fields for why this is a
  # statement per field rather than a separator-split row.
  local slug title branch existing_wt existing_branch
  db_fields "SELECT coalesce(repo_slug,'') FROM tickets WHERE id = $id;
             SELECT title                  FROM tickets WHERE id = $id;
             SELECT coalesce(worktree_path,'') FROM tickets WHERE id = $id;
             SELECT coalesce(branch,'')    FROM tickets WHERE id = $id;"
  slug="${DB_FIELDS[0]}"; title="${DB_FIELDS[1]}"
  existing_wt="${DB_FIELDS[2]}"; existing_branch="${DB_FIELDS[3]}"

  # Already started and the worktree is still there — attach, don't re-cut.
  if [ -n "$existing_wt" ] && [ -d "$existing_wt" ]; then
    echo "$existing_wt"
    echo "smriti-ticket: #$id already in progress on '$existing_branch'" >&2
    return 0
  fi

  # Refuse to cut a worktree for work that cannot land. The ticket asked for
  # "refuse, or warn loudly": refusal is the half a machine can act on, which
  # matters because an autonomous dispatcher must not start blocked work and
  # cannot be asked to parse a warning off stderr. --force is the way out.
  #
  # Deliberately AFTER the attach above. Re-entering a worktree that already
  # exists is not starting work — the work is already underway — and refusing
  # there would break both `cd "$(smriti ticket start N)"` for a run in flight
  # and the board's restart, which re-attaches through this same path.
  if [ "$force" -ne 1 ] && [ "$(open_blocker_count "$id")" != "0" ]; then
    {
      echo "$SMRITI_TOOL: #$id is blocked by unshipped work:"
      open_blockers "$id" | awk -F'\t' '{ printf "  %-5s %-12s %s\n", $1, $2, $3 }'
      echo "$SMRITI_TOOL: start it anyway with --force"
    } >&2
    exit 7
  fi

  # An idea has no code to cut a branch in. Say what to do rather than failing
  # with a confusing "don't know where project '' lives".
  [ -n "$slug" ] || die "#$id is an idea with no app yet — give it one first: smriti ticket edit $id --repo <slug>" 5

  local repo primary
  repo=$(repo_path_for_slug "$slug")
  if [ -z "$repo" ]; then
    # Only fall back to the cwd when it IS this ticket's project. Without the
    # match, `ticket start` for project A run from inside repo B cut the
    # worktree in B and recorded it, with no warning.
    if [ "$(current_slug)" = "$slug" ]; then
      repo=$(git rev-parse --show-toplevel 2>/dev/null || true)
    fi
    [ -n "$repo" ] || die "don't know where app '$slug' lives — run this from inside that repo once" 5
  fi
  primary=$(primary_worktree "$repo")
  [ -n "$primary" ] || primary="$repo"

  branch="$existing_branch"
  [ -n "$branch" ] || branch="t$id-$(slugify "$title")"

  local wt="$primary/.claude/worktrees/$branch"
  mkdir -p "$(dirname "$wt")"
  ignore_worktrees_dir "$primary"

  if [ -d "$wt" ]; then
    : # directory survived without a db row; adopt it
  elif git -C "$primary" show-ref --verify --quiet "refs/heads/$branch"; then
    # Branch exists already (a re-start after cleanup) — attach, don't recreate.
    git -C "$primary" worktree add "$wt" "$branch" >/dev/null 2>&1 \
      || die "could not attach worktree for existing branch '$branch'" 5
  else
    local base; base=$(base_branch_for "$primary")
    git -C "$primary" worktree add -b "$branch" "$wt" "$base" >/dev/null 2>&1 \
      || die "could not create worktree at $wt (branch '$branch' off '$base')" 5
  fi

  db_write "UPDATE tickets SET status = 'in_progress',
              branch = $(sql_quote "$branch"),
              worktree_path = $(sql_quote "$wt"),
              updated_at = $(sql_quote "$(now_utc)")
            WHERE id = $id;"

  # Path on stdout so a caller can `cd "$(smriti ticket start N)"`; everything
  # else on stderr so that stays machine-usable.
  echo "$wt"
  echo "smriti-ticket: #$id → in_progress on '$branch'" >&2
}

base_branch_for() {
  local repo="$1" b=""
  if [ -x "$SMRITI_BIN/smriti-default-branch" ]; then
    b=$(cd "$repo" && "$SMRITI_BIN/smriti-default-branch" 2>/dev/null || true)
  fi
  [ -n "$b" ] || b=main
  printf '%s' "$b"
}

# ─── status / done ──────────────────────────────────────────────────────────

cmd_status() {
  [ $# -ge 2 ] || usage
  local id="$1" status="$2"
  require_id "$id"
  validate_status "$status"
  ticket_exists "$id" || die "no ticket #$id" 4
  db_write "UPDATE tickets SET status = $(sql_quote "$status"), updated_at = $(sql_quote "$(now_utc)")
            WHERE id = $id;"
  echo "#$id → $status"
  # Landing something is the moment the graph pays for itself: you finish, and
  # you are told what that just made startable, instead of finding out a week
  # later. Only shipped/cancelled can free anything — every other status leaves
  # the blocker blocking, so there is nothing to say.
  case "$status" in
    shipped|cancelled) announce_freed "$id" ;;
  esac
}

# A description is what you write when the title was not enough. Editable
# because the first line you type is rarely the last word on a piece of work.
cmd_edit() {
  [ $# -ge 1 ] || usage
  local id="$1"; shift
  require_id "$id"
  ticket_exists "$id" || die "no ticket #$id" 4

  local sets="" title="" body="" priority="" have=0 clear_body=0
  local repo="" project="" repo_given=0 project_given=0 no_project=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --title)    [ $# -ge 2 ] || die "--title requires a value";    title="$2";    have=1; shift 2 ;;
      --body)     [ $# -ge 2 ] || die "--body requires a value";     body="$2";     have=1; shift 2
                  [ -z "$body" ] && clear_body=1 ;;
      --priority) [ $# -ge 2 ] || die "--priority requires a value"; priority="$2"; have=1; shift 2 ;;
      --repo)     [ $# -ge 2 ] && [ -n "$2" ] || die "--repo requires a value (use '-' for no app)";     repo="$2";     have=1; repo_given=1; shift 2 ;;
      --project)  [ $# -ge 2 ] && [ -n "$2" ] || die "--project requires a value (use --no-project to detach)";  project="$2";  have=1; project_given=1; shift 2 ;;
      --no-project) no_project=1; have=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  [ "$have" -eq 1 ] || die "nothing to change — pass --title, --body, --priority, --repo or --project"
  [ "$project_given" -eq 1 ] && [ "$no_project" -eq 1 ] && die "--project and --no-project contradict each other"

  if [ -n "$title" ]; then
    case "$title" in
      *$'\n'*) die "title must be a single line — put detail in --body" ;;
    esac
    sets="$sets title = $(sql_quote "$title"),"
  fi
  # An explicitly empty --body clears the description rather than storing "".
  if [ "$clear_body" -eq 1 ]; then
    sets="$sets body = NULL,"
  elif [ -n "$body" ]; then
    sets="$sets body = $(sql_quote "$body"),"
  fi
  if [ -n "$priority" ]; then
    require_num "$priority" "--priority"
    sets="$sets priority = $priority,"
  fi

  # ── re-filing ─────────────────────────────────────────────────────────────
  # The app is the part that cannot move under a started ticket: worktree_path
  # points into the OLD app's repo, and `start` would happily reattach that
  # tree under the new slug. Refuse, and say which branch is in the way.
  local move_repo=0 new_repo="" project_sql=""
  local cur_repo="" cur_wt="" cur_branch="" cur_pid=""
  # Read once, for everything below: the destination check, the started-ticket
  # refusal and the stranded-project sweep all want the same row. Skipped
  # entirely for an edit that only touches the title or body.
  if [ "$repo_given" -eq 1 ] || [ "$project_given" -eq 1 ] || [ "$no_project" -eq 1 ]; then
    db_fields "SELECT coalesce(repo_slug,'')     FROM tickets WHERE id = $id;
               SELECT coalesce(worktree_path,'') FROM tickets WHERE id = $id;
               SELECT coalesce(branch,'')        FROM tickets WHERE id = $id;
               SELECT coalesce(project_id,'')    FROM tickets WHERE id = $id;"
    cur_repo="${DB_FIELDS[0]}"; cur_wt="${DB_FIELDS[1]}"; cur_branch="${DB_FIELDS[2]}"
    cur_pid="${DB_FIELDS[3]}"
  fi
  if [ "$repo_given" -eq 1 ]; then
    if [ "$repo" = "-" ]; then new_repo=""; else new_repo=$(resolve_repo "$repo"); fi
    move_repo=1
  fi
  if [ "$project_given" -eq 1 ]; then
    # A slug is only unique within an app, so it is resolved against the app
    # this ticket will END UP in: the one --repo names, or the one it already
    # has. Only a ticket with no app falls back to the app you are standing in,
    # which is what lets a freshly captured idea be filed by slug from inside
    # the repo it belongs to. Scoping to the shell instead meant that running
    # this from a different app silently RELOCATED the ticket whenever the two
    # apps happened to share a project slug. Moving between apps is what --repo
    # is for, and naming it gets the destination check below.
    local scope
    if [ "$move_repo" -eq 1 ]; then scope="$new_repo"
    elif [ -n "$cur_repo" ];  then scope="$cur_repo"
    else scope=$(current_slug); fi
    local pid; pid=$(resolve_project_ref "$project" "$scope")
    project_sql="$pid"
    local p_repo; p_repo=$(repo_of_project "$pid")
    if [ "$move_repo" -eq 1 ]; then
      # Both halves given and disagreeing is a contradiction in one command,
      # not something to guess at. A bare numeric --project skips the slug
      # scoping above entirely, so this is the only thing standing between
      # `--repo a --project <id-in-b>` and a ticket filed across apps.
      [ "$p_repo" = "$new_repo" ] || \
        die "project '$project' lives in ${p_repo:-no app}, not ${new_repo:-no app} — a ticket cannot sit in a project belonging to another app"
    else
      # Filing into a project settles the app too — a ticket cannot sit in a
      # project belonging to a different app than its own.
      new_repo="$p_repo"; move_repo=1
    fi
  elif [ "$no_project" -eq 1 ]; then
    project_sql="NULL"
  fi

  if [ "$move_repo" -eq 1 ]; then
    if [ "$cur_repo" != "$new_repo" ] && { [ -n "$cur_wt" ] || [ -n "$cur_branch" ]; }; then
      die "#$id is started on '$cur_branch' in ${cur_repo:-no app} — its worktree lives there. Finish or cancel it before moving it to another app"
    fi
    # Moving apps strands any project from the OLD one: the ticket ends up
    # filed in a project belonging somewhere else, which every later read then
    # has to defend against. The move settles it — that project is not a
    # project of this app. Only when the caller did not name a project itself;
    # an explicit --project has already been checked against the destination.
    if [ "$cur_repo" != "$new_repo" ] && [ -z "$project_sql" ] && [ -n "$cur_pid" ] &&
       [ "$(repo_of_project "$cur_pid")" != "$new_repo" ]; then
      project_sql="NULL"
    fi
    sets="$sets repo_slug = $(sql_quote_or_null "$new_repo"),"
  fi
  [ -n "$project_sql" ] && sets="$sets project_id = $project_sql,"

  # documents and runs carry their own copy of repo_slug/project_id, so a move
  # that touched only the ticket would leave its paper trail and run history
  # filed under the app it just left.
  local follow=""
  [ "$move_repo" -eq 1 ] && follow="$follow
    UPDATE documents SET repo_slug = $(sql_quote_or_null "$new_repo") WHERE ticket_id = $id;
    UPDATE runs      SET repo_slug = $(sql_quote_or_null "$new_repo") WHERE ticket_id = $id;"
  [ -n "$project_sql" ] && follow="$follow
    UPDATE documents SET project_id = $project_sql WHERE ticket_id = $id;
    UPDATE runs      SET project_id = $project_sql WHERE ticket_id = $id;"

  # A position only means anything inside its own (repo_slug, project_id) scope,
  # so a ticket that changes scope must be given a new one — otherwise it lands
  # in its destination carrying a number from somewhere else and sorts into an
  # arbitrary place. Bottom of the destination, same as a freshly captured one.
  #
  # This belongs HERE rather than in `move`, because `edit` is where scope
  # actually changes — including the quiet path above where naming a project
  # settles the app as well, without --repo ever being passed.
  local cur_pid_sql="${cur_pid:-NULL}"
  local dest_repo="$cur_repo" dest_pid_sql="$cur_pid_sql"
  [ "$move_repo" -eq 1 ] && dest_repo="$new_repo"
  [ -n "$project_sql" ] && dest_pid_sql="$project_sql"
  if [ "$dest_repo" != "$cur_repo" ] || [ "$dest_pid_sql" != "$cur_pid_sql" ]; then
    sets="$sets position = $(bottom_of_scope "$(sql_quote_or_null "$dest_repo")" "$dest_pid_sql" "$id"),"
  fi

  db_write "UPDATE tickets SET $sets updated_at = $(sql_quote "$(now_utc)") WHERE id = $id;$follow"
  echo "#$id updated"
}

# ─── move ───────────────────────────────────────────────────────────────────

# Reorder within a group. The caller says WHERE relative to another card —
# `--before 12`, `--after 12`, `--top`, `--bottom` — and never a raw number:
# the arithmetic lives here, in one place, so the board's drag and its keyboard
# both go through the same reasoning and neither can invent a position.
#
# A dropped card takes the MIDPOINT of its two neighbours, so one row is written
# and no sibling has to shift. When a gap has been halved so many times that the
# midpoint would collide with an endpoint, the scope is renumbered to whole
# numbers first and the move is retried against the fresh spacing.
cmd_move() {
  [ $# -ge 1 ] || usage
  require_id "$1"
  local id="$1"; shift
  ticket_exists "$id" || die "no ticket #$id" 4

  local where="" target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --before) [ $# -ge 2 ] || die "--before requires a ticket id"; where="before"; target="$2"; shift 2 ;;
      --after)  [ $# -ge 2 ] || die "--after requires a ticket id";  where="after";  target="$2"; shift 2 ;;
      --top)    where="top";    shift ;;
      --bottom) where="bottom"; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  [ -n "$where" ] || die "say where it goes: --before <id>, --after <id>, --top or --bottom"

  # The scope key, read from the ticket itself. Everything below compares
  # against these two and nothing else — a position has no meaning outside them.
  local scope_repo scope_pid
  db_fields "SELECT coalesce(repo_slug,'')  FROM tickets WHERE id = $id;
             SELECT coalesce(project_id,'') FROM tickets WHERE id = $id;"
  scope_repo="${DB_FIELDS[0]}"; scope_pid="${DB_FIELDS[1]}"
  local scope; scope=$(scope_sql "$(sql_quote_or_null "$scope_repo")" "${scope_pid:-NULL}")

  if [ "$where" = "before" ] || [ "$where" = "after" ]; then
    require_id "$target"
    [ "$target" = "$id" ] && die "#$id cannot move relative to itself"
    ticket_exists "$target" || die "no ticket #$target" 4
    # Refused rather than silently re-filed: dropping a card into another
    # group means changing which project owns it, and `edit --project` is the
    # verb for that. Two gestures for one operation is worse than one each.
    local same
    same=$(db "SELECT count(*) FROM tickets WHERE id = $target AND $scope;")
    [ "$same" = "1" ] || \
      die "#$target is in a different app or project than #$id — reorder happens within one group; use 'edit --project' to re-file" 6
  fi

  # Two attempts at most. The first can fail only by running out of room
  # between two neighbours; renumbering the scope to 1..N restores whole-number
  # spacing and the second attempt then always has room.
  local attempt=0
  while [ "$attempt" -lt 2 ]; do
    attempt=$((attempt + 1))

    # lo and hi bound the gap the card is landing in; an empty string means
    # "no neighbour on that side", i.e. the end of the list. Both come back
    # from ONE sqlite3 invocation — this is the board's interactive drag path,
    # and every db call here pays for a process plus a version probe.
    local lo="" hi=""
    case "$where" in
      top)
        db_fields "SELECT '';
                   SELECT coalesce(min(position), '') FROM tickets WHERE $scope AND id <> $id;" ;;
      bottom)
        db_fields "SELECT coalesce(max(position), '') FROM tickets WHERE $scope AND id <> $id;
                   SELECT '';" ;;
      before)
        db_fields "SELECT coalesce((SELECT max(position) FROM tickets
                     WHERE $scope AND id <> $id
                       AND position < (SELECT position FROM tickets WHERE id = $target)), '');
                   SELECT position FROM tickets WHERE id = $target;" ;;
      after)
        db_fields "SELECT position FROM tickets WHERE id = $target;
                   SELECT coalesce((SELECT min(position) FROM tickets
                     WHERE $scope AND id <> $id
                       AND position > (SELECT position FROM tickets WHERE id = $target)), '');" ;;
    esac
    lo="${DB_FIELDS[0]}"; hi="${DB_FIELDS[1]}"

    # awk rather than another sqlite3: this is IEEE-754 double arithmetic on two
    # numbers already in hand, and bash cannot do it. Spawning a database to
    # halve two floats was two processes per drag for no reason.
    #
    # The check is that the midpoint landed STRICTLY between both endpoints.
    # Comparing against both is what catches the underflow — once a gap has been
    # subdivided far enough, (lo+hi)/2 rounds onto one of them and the order
    # would quietly stop being a total one.
    local pos
    if   [ -z "$lo" ] && [ -z "$hi" ]; then pos=1                                  # alone in the group
    elif [ -z "$lo" ]; then pos=$(awk -v h="$hi" 'BEGIN{printf "%.17g", h - 1}')   # new first
    elif [ -z "$hi" ]; then pos=$(awk -v l="$lo" 'BEGIN{printf "%.17g", l + 1}')   # new last
    else
      pos=$(awk -v l="$lo" -v h="$hi" 'BEGIN{m=(l+h)/2.0; print (m>l && m<h) ? sprintf("%.17g", m) : ""}')
      if [ -z "$pos" ]; then
        [ "$attempt" -ge 2 ] && die "could not find room to place #$id — the order is too tightly packed to subdivide" 3
        renumber_scope "$scope"
        continue
      fi
    fi

    db_write "UPDATE tickets SET position = $pos,
                                 updated_at = $(sql_quote "$(now_utc)")
              WHERE id = $id;"
    echo "#$id moved"
    warn_order_contradiction "$id"
    return 0
  done
}

# Say when the order just drawn disagrees with the dependency graph — a ticket
# sitting ABOVE something it is waiting on.
#
# It says so and stops. It does NOT reorder: you may be sequencing deliberately
# (about to --force, or about to cancel the blocker), and a board that
# rearranges your work while you are arranging it is the worse tool. Only
# comparable within one scope, since positions mean nothing across them.
warn_order_contradiction() {
  local id="$1" rows
  rows=$(db "SELECT '#' || b.id
               FROM ticket_deps d
               JOIN tickets t ON t.id = d.blocked_id
               JOIN tickets b ON b.id = d.blocker_id
              WHERE d.blocked_id = $id
                AND NOT ($(dep_satisfied b))
                AND coalesce(b.repo_slug,'') = coalesce(t.repo_slug,'')
                AND coalesce(b.project_id,-1) = coalesce(t.project_id,-1)
                AND (t.position < b.position
                     OR (t.position = b.position AND t.id < b.id))
              ORDER BY b.id;" 2>/dev/null || true)
  [ -n "$rows" ] || return 0
  local ids; ids=$(printf '%s\n' "$rows" | paste -sd' ' -)
  echo "$SMRITI_TOOL: heads up — #$id now sits above $ids, which it is blocked by" >&2
}

# Rewrite one group's positions as 1, 2, 3 … preserving the order they are
# already in. Only ever called when a midpoint has run out of room, which takes
# roughly fifty consecutive drops into the same gap.
renumber_scope() {
  local scope="$1"
  db_write "WITH packed AS (
              SELECT id, ROW_NUMBER() OVER (ORDER BY position ASC, id ASC) AS rn
              FROM tickets WHERE $scope
            )
            UPDATE tickets SET position = (SELECT rn FROM packed WHERE packed.id = tickets.id)
            WHERE id IN (SELECT id FROM packed);"
}

# Cancel is reversible and keeps the paper trail; rm is not. Two verbs because
# "I am not doing this" and "this should never have existed" are different
# intentions, and only one of them deserves a confirmation prompt.
cmd_cancel() {
  [ $# -ge 1 ] || usage
  require_id "$1"
  ticket_exists "$1" || die "no ticket #$1" 4
  db_write "UPDATE tickets SET status = 'cancelled', updated_at = $(sql_quote "$(now_utc)") WHERE id = $1;"
  echo "#$1 → cancelled  (smriti ticket status $1 ready brings it back)"
  # Cancelling frees dependents exactly as shipping does — deciding work will
  # not happen releases whatever was waiting on it. Worth saying here too, since
  # this verb writes its own message rather than going through cmd_status.
  announce_freed "$1"
}

cmd_rm() {
  [ $# -ge 1 ] || usage
  local id="$1"; shift
  require_id "$id"
  local yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) yes=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  ticket_exists "$id" || die "no ticket #$id" 4

  local title docs edges
  title=$(db "SELECT title FROM tickets WHERE id = $id;")
  docs=$(db "SELECT count(*) FROM documents WHERE ticket_id = $id;")
  edges=$(db "SELECT count(*) FROM ticket_deps
               WHERE blocker_id = $id OR blocked_id = $id;")

  if [ "$yes" -ne 1 ]; then
    if [ ! -t 0 ]; then
      die "refusing to delete without --yes in a non-interactive shell" 1
    fi
    echo "About to delete #$id  $title"
    [ "$docs" != "0" ] && echo "  $docs document row(s) forgotten (the files stay on disk)"
    # Worth saying out loud: unlike the document rows, this changes OTHER
    # tickets — anything waiting on this one stops being blocked by it.
    [ "$edges" != "0" ] && echo "  $edges dependency edge(s) cut — tickets waiting on this one are freed"
    printf "Delete? [y/N] "
    read -r ans || ans=""
    case "$ans" in y|Y|yes|YES) ;; *) echo "aborted."; exit 1 ;; esac
  fi

  # Only index rows go. The markdown on disk is the source of truth, and
  # deleting a ticket is not a reason to destroy the writing about it.
  db_write "DELETE FROM documents WHERE ticket_id = $id;
            DELETE FROM tickets WHERE id = $id;"
  echo "deleted: #$id  $title"
}

# /begin's ship step calls this once the PR exists. in_review rather than shipped:
# the merge has not happened yet, and `smriti clean` is what confirms it.
cmd_pr() {
  [ $# -ge 2 ] || usage
  local id="$1" url="$2"
  # `-` means "no ticket" — the same sentinel `doc` takes, so callers have one
  # shape for the optional case instead of guarding at every site.
  [ "$id" = "-" ] && return 0
  require_id "$id"
  ticket_exists "$id" || die "no ticket #$id" 4
  db_write "UPDATE tickets SET pr_url = $(sql_quote "$url"), status = 'in_review',
                               updated_at = $(sql_quote "$(now_utc)")
            WHERE id = $id;"
  echo "#$id → in_review  $url"
}

cmd_done() {
  [ $# -ge 1 ] || usage
  cmd_status "$1" shipped
}

# ─── doc ────────────────────────────────────────────────────────────────────

# Registering the same path twice is a no-op rather than an error: /begin may
# re-register its plan on a re-run, and failing there would break the flow for
# a bookkeeping detail.
cmd_doc() {
  [ $# -ge 1 ] || usage
  local id="$1"; shift
  local type="" path="" branch=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --type)   [ $# -ge 2 ] || die "--type requires a value";   type="$2";   shift 2 ;;
      --path)   [ $# -ge 2 ] || die "--path requires a value";   path="$2";   shift 2 ;;
      --branch) [ $# -ge 2 ] || die "--branch requires a value"; branch="$2"; shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  [ -n "$type" ] || die "--type is required"
  [ -n "$path" ] || die "--path is required"
  validate_doc_type "$type"

  local ticket_sql slug project_sql="NULL"
  if [ "$id" = "-" ]; then
    ticket_sql="NULL"
  else
    require_id "$id"
    ticket_exists "$id" || die "no ticket #$id" 4
    ticket_sql="$id"
  fi

  [ -z "$branch" ] && branch=$(current_branch)
  # The ticket is the better authority than the cwd: a doc registered from a
  # worktree still belongs to the app and project the ticket is filed under.
  if [ "$ticket_sql" != "NULL" ]; then
    db_fields "SELECT coalesce(repo_slug,'')      FROM tickets WHERE id = $id;
               SELECT coalesce(project_id,'NULL') FROM tickets WHERE id = $id;"
    slug="${DB_FIELDS[0]}"; project_sql="${DB_FIELDS[1]}"
  fi
  [ -n "$slug" ] || slug=$(current_slug)
  [ -n "$slug" ] || die "not in a git repo and no ticket to infer the app from"

  db_write "INSERT INTO documents (ticket_id, repo_slug, project_id, type, path, branch, created_at)
            VALUES ($ticket_sql, $(sql_quote "$slug"), ${project_sql:-NULL}, $(sql_quote "$type"),
                    $(sql_quote "$path"), $(sql_quote_or_null "$branch"), $(sql_quote "$(now_utc)"))
            ON CONFLICT(path) DO UPDATE SET
              ticket_id  = excluded.ticket_id,
              repo_slug  = excluded.repo_slug,
              project_id = excluded.project_id,
              branch     = excluded.branch;"
  echo "registered: $type → $path${ticket_sql:+ (#$id)}"
}

# The whole index in one call — the board renders paper trails and one
# subprocess per ticket would be an N+1.
cmd_docs() {
  local json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  if ! factory_db_exists; then
    [ "$json" -eq 1 ] && { echo '[]'; return 0; }
    echo "no documents yet"; return 0
  fi
  if [ "$json" -eq 1 ]; then
    db_json "SELECT id, ticket_id, repo_slug, project_id, type, path, branch, created_at
             FROM documents ORDER BY id;"
  else
    db "SELECT type || char(9) || coalesce('#' || ticket_id,'—') || char(9) || path
        FROM documents ORDER BY id;" | awk -F'\t' '{ printf "%-8s %-6s %s\n", $1, $2, $3 }'
  fi
}

# ─── doc-forget ─────────────────────────────────────────────────────────────

# Drop index rows for a branch whose files have been purged. The index must not
# outlive the documents it points at.
cmd_doc_forget() {
  local branch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --branch) [ $# -ge 2 ] || die "--branch requires a value"; branch="$2"; shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  [ -n "$branch" ] || die "--branch is required"

  local slug; slug=$(current_slug)
  local where="WHERE branch = $(sql_quote "$branch")"
  [ -n "$slug" ] && where="$where AND repo_slug = $(sql_quote "$slug")"

  local n; n=$(db "SELECT count(*) FROM documents $where;")
  db_write "DELETE FROM documents $where;"
  echo "forgot $n document(s) for '$branch'"
}

# ─── current ────────────────────────────────────────────────────────────────

# Emits `KEY=value` for `eval "$(smriti ticket current)"` in the skill preamble,
# mirroring the shape smriti-slug and smriti-codex-probe already use.
cmd_current() {
  local json=0 want_branch="" want_project=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)   json=1; shift ;;
      # smriti-clean needs the ticket for a branch it is about to delete, which by
      # then is not the branch it is standing on.
      --branch)  [ $# -ge 2 ] || die "--branch requires a value";  want_branch="$2";  shift 2 ;;
      # The preamble already has SLUG and BRANCH; passing them avoids
      # re-spawning smriti-slug and git on every skill invocation.
      # --project is the old spelling of --repo: this flag has always taken a
      # repository slug. Accepted so an older installed skill keeps working.
      --repo|--project) [ $# -ge 2 ] || die "$1 requires a value"; want_project="$2"; shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  # This runs in the preamble of every skill, so it must be cheap and must not
  # have side effects. Before the store exists there is nothing to answer with,
  # and asking would otherwise CREATE the database just to say "no ticket".
  if ! factory_db_exists; then
    [ "$json" -eq 1 ] && { echo '[]'; return 0; }
    printf 'TICKET=\n'
    return 0
  fi

  local slug branch
  slug="$want_project"
  [ -n "$slug" ] || slug=$(current_slug)
  branch="$want_branch"
  [ -n "$branch" ] || branch=$(current_branch)

  if [ -z "$slug" ] || [ -z "$branch" ]; then
    [ "$json" -eq 1 ] && { echo '[]'; return 0; }
    printf 'TICKET=\n'
    return 0
  fi

  local where="WHERE repo_slug = $(sql_quote "$slug") AND branch = $(sql_quote "$branch")"

  if [ "$json" -eq 1 ]; then
    db_json "SELECT * FROM tickets $where LIMIT 1;"
    return 0
  fi

  # One sqlite3 process for all four fields.
  local id title status project
  db_fields "SELECT id     FROM tickets $where LIMIT 1;
             SELECT title  FROM tickets $where LIMIT 1;
             SELECT status FROM tickets $where LIMIT 1;
             SELECT coalesce((SELECT name FROM projects p WHERE p.id = tickets.project_id),'')
               FROM tickets $where LIMIT 1;"
  if [ "${#DB_FIELDS[@]}" -lt 3 ] || [ -z "${DB_FIELDS[0]}" ]; then
    printf 'TICKET=\n'
    return 0
  fi
  id="${DB_FIELDS[0]}"; title="${DB_FIELDS[1]}"
  status="${DB_FIELDS[2]}"; project="${DB_FIELDS[3]}"
  printf 'TICKET=%s\n' "$id"
  printf 'TICKET_TITLE=%q\n' "$title"
  printf 'TICKET_STATUS=%s\n' "$status"
  printf 'TICKET_PROJECT=%q\n' "$project"
}

# ─── dispatch ───────────────────────────────────────────────────────────────

CMD="${1:-}"
shift || true
case "$CMD" in
  add)          cmd_add "$@" ;;
  list|ls)      cmd_list "$@" ;;
  show)         cmd_show "$@" ;;
  start)        cmd_start "$@" ;;
  edit)         cmd_edit "$@" ;;
  cancel)       cmd_cancel "$@" ;;
  rm)           cmd_rm "$@" ;;
  move)         cmd_move "$@" ;;
  pr)           cmd_pr "$@" ;;
  status)       cmd_status "$@" ;;
  done)         cmd_done "$@" ;;
  dep)          cmd_dep "$@" ;;
  deps)         cmd_deps "$@" ;;
  doc)          cmd_doc "$@" ;;
  docs)         cmd_docs "$@" ;;
  doc-forget)   cmd_doc_forget "$@" ;;
  current)      cmd_current "$@" ;;
  ""|-h|--help) usage ;;
  *) echo "$SMRITI_TOOL: unknown command '$CMD'" >&2; usage ;;
esac
