#!/usr/bin/env bash
# smriti ticket — the work layer: work items and the index of documents about them.
# State: $SMRITI_HOME/factory.db   (schema: lib/factory-schema.sql)
#
# Subcommands:
#   smriti ticket add <title> [--repo S] [--project P] [--body T] [--priority N] [--ready]
#   smriti ticket list [--repo S] [--project P] [--status S] [--all] [--json]
#   smriti ticket show <id> [--json]
#   smriti ticket start <id>                  cut/attach a worktree; prints its path
#   smriti ticket edit <id> [--title T] [--body T] [--priority N] [--repo S]
#                           [--project P | --no-project]
#   smriti ticket cancel <id>                 park it out of the way, reversibly
#   smriti ticket rm <id> [--yes]             delete it and its document rows
#   smriti ticket pr <id> <url>               record the PR and move to in_review
#   smriti ticket status <id> <status>        idea|ready|in_progress|in_review|shipped|cancelled
#   smriti ticket done <id>                   shorthand for `status <id> shipped`
#   smriti ticket doc <id|-> --type T --path P [--branch B]
#   smriti ticket docs [--json]               the whole document index
#   smriti ticket current [--json]            the ticket for this branch, as `KEY=value`
#
# Exit codes:
#   0  ok
#   2  usage error
#   3  sqlite3 or schema missing
#   4  no such ticket
#   5  could not create or attach the worktree
#
# A ticket belongs to a project, or to an app directly (a one-off bug), or to
# neither — an idea, capturable from anywhere, including outside a git repo.
# Both edges are optional on purpose; see lib/factory-schema.sql.
#
# Documents are *indexed*, never stored: `doc` records where a markdown file
# lives so a ticket can carry its paper trail, while the file on disk under
# ~/.smriti/projects/<slug>/ stays the source of truth. This deliberately does
# not touch the filename contract in bin/smriti-latest-doc.

set -e

SMRITI_TOOL=smriti-ticket

# Resolve our own dir through the full symlink chain before dirname: the install
# puts a symlink on PATH, and a multi-hop chain would otherwise resolve
# SMRITI_LIB to the wrong directory, making every call here hard-exit with
# "schema not found". Same loop as bin/smriti.
_self="$0"
while [ -L "$_self" ]; do
  _target=$(readlink "$_self")
  case "$_target" in
    /*) _self="$_target" ;;
    *)  _self="$(cd "$(dirname "$_self")" && pwd -P)/$_target" ;;
  esac
done
SMRITI_BIN="$(cd "$(dirname "$_self")" && pwd -P)"
SMRITI_LIB="$(cd "$SMRITI_BIN/../lib" && pwd -P)"
unset _self

# shellcheck source=../lib/factory-db.sh
. "$SMRITI_LIB/factory-db.sh"

VALID_STATUSES="idea ready in_progress in_review shipped cancelled"
VALID_DOC_TYPES="plan debug design audit"

usage() {
  cat <<'USAGE' >&2
usage:
  smriti ticket add <title> [--repo S] [--project P] [--body T] [--priority N] [--ready]
  smriti ticket list [--repo S] [--project P] [--status S] [--all] [--json]
  smriti ticket show <id> [--json]
  smriti ticket start <id>
  smriti ticket edit <id> [--title T] [--body T] [--priority N] [--repo S]
                          [--project P | --no-project]
  smriti ticket cancel <id>
  smriti ticket rm <id> [--yes]
  smriti ticket pr <id> <url>
  smriti ticket status <id> <idea|ready|in_progress|in_review|shipped|cancelled>
  smriti ticket done <id>
  smriti ticket doc <id|-> --type <plan|debug|design|audit> --path P [--branch B]
  smriti ticket docs [--json]
  smriti ticket current [--json]
USAGE
  exit 2
}

# ─── helpers ────────────────────────────────────────────────────────────────
# die, require_num, current_slug and current_branch come from factory-db.sh.

require_id() { require_num "$1" "ticket id"; }

ticket_exists() {
  [ "$(db "SELECT count(*) FROM tickets WHERE id = $1;")" = "1" ]
}

validate_status() {
  case " $VALID_STATUSES " in
    *" $1 "*) ;;
    *) die "invalid status '$1' (expected: $VALID_STATUSES)" ;;
  esac
}

validate_doc_type() {
  case " $VALID_DOC_TYPES " in
    *" $1 "*) ;;
    *) die "invalid --type '$1' (expected: $VALID_DOC_TYPES)" ;;
  esac
}

# Resolve the app for a write. Explicit --repo wins; otherwise derive from the
# repo we're standing in. An empty result is FINE and means "no app yet" — an
# idea. This used to refuse outside a git repo, which made a stray thought
# impossible to capture at the moment you had it.
resolve_repo() {
  local explicit="$1"
  if [ "$explicit" = "-" ]; then printf ''; return 0; fi
  if [ -n "$explicit" ]; then
    validate_slug_shape "$explicit" "--repo"
    printf '%s' "$explicit"
    return 0
  fi
  current_slug
}

# Resolve a project reference (id or slug) to an id, scoped to an app when one
# is known. A slug is only unique within an app, so an ambiguous one is an
# error rather than a guess.
resolve_project_ref() {
  local ref="$1" repo="${2:-}"
  [ -n "$ref" ] || { printf ''; return 0; }
  case "$ref" in
    ''|*[!0-9]*) ;;
    *) local hit; hit=$(db "SELECT id FROM projects WHERE id = $ref;")
       [ -n "$hit" ] || die "no project #$ref" 4
       printf '%s' "$hit"; return 0 ;;
  esac
  validate_slug_shape "$ref" "--project"
  local where="WHERE slug = $(sql_quote "$ref")"
  [ -n "$repo" ] && where="$where AND repo_slug IS $(sql_quote_or_null "$repo")"
  local hits; hits=$(db "SELECT count(*) FROM projects $where;")
  if [ "$hits" = "0" ]; then
    die "no project '$ref'${repo:+ in $repo}" 4
  elif [ "$hits" != "1" ]; then
    die "'$ref' names $hits projects across apps — pass --repo <slug> to say which"
  fi
  db "SELECT id FROM projects $where;"
}

# The app a project lives in. A ticket filed into a project inherits it, so
# `--project` alone is enough and cannot disagree with the project's own app.
repo_of_project() {
  [ -n "$1" ] || { printf ''; return 0; }
  db "SELECT coalesce(repo_slug,'') FROM projects WHERE id = $1;"
}

# ─── add ────────────────────────────────────────────────────────────────────

cmd_add() {
  local title="" body="" repo="" project="" priority=0 status="idea"
  [ $# -gt 0 ] || usage
  title="$1"; shift
  case "$title" in -*) usage ;; esac

  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)     [ $# -ge 2 ] && [ -n "$2" ] || die "--repo requires a value (use '-' for no app)";    repo="$2";    shift 2 ;;
      --project)  [ $# -ge 2 ] && [ -n "$2" ] || die "--project requires a value (use --no-project to detach)"; project="$2"; shift 2 ;;
      --body)     [ $# -ge 2 ] || die "--body requires a value";    body="$2";    shift 2 ;;
      --priority) [ $# -ge 2 ] || die "--priority requires a value"; priority="$2"; shift 2 ;;
      --ready)    status="ready"; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  require_num "$priority" "--priority"
  [ -n "$title" ] || die "title must not be empty"
  # A title is one line. Multi-line titles broke the tab-delimited reads that
  # `list` and `start` rely on — put the detail in --body instead.
  # $'\n' and not "$(printf '\n')": command substitution strips trailing
  # newlines, so that form is an empty pattern that matches every title.
  case "$title" in
    *$'\n'*) die "title must be a single line — put detail in --body" ;;
  esac

  local slug ts project_id
  slug=$(resolve_repo "$repo")
  project_id=$(resolve_project_ref "$project" "$slug")
  # A project knows its own app; filing into one settles the question.
  if [ -n "$project_id" ]; then
    slug=$(repo_of_project "$project_id")
  fi
  ts=$(now_utc)

  # last_insert_rowid() is per-connection, so it has to ride along inside the
  # same db_write rather than being fetched by a second invocation.
  local id
  id=$(db_write "INSERT INTO tickets (repo_slug, project_id, title, body, status, priority, created_at, updated_at)
            VALUES ($(sql_quote_or_null "$slug"), ${project_id:-NULL}, $(sql_quote "$title"), $(sql_quote_or_null "$body"),
                    $(sql_quote "$status"), $priority, $(sql_quote "$ts"), $(sql_quote "$ts"));
            SELECT last_insert_rowid();")

  local where="${slug:-no app yet}"
  [ -n "$project_id" ] && where="$where / $(db "SELECT name FROM projects WHERE id = $project_id;")"
  echo "added: #$id  $title  ($where, $status)"
}

# ─── list ───────────────────────────────────────────────────────────────────

cmd_list() {
  local repo="" project="" status="" all=0 json=0 repo_given=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo)    [ $# -ge 2 ] && [ -n "$2" ] || die "--repo requires a value (use '-' for no app)"; repo="$2"; repo_given=1; shift 2 ;;
      --project) [ $# -ge 2 ] && [ -n "$2" ] || die "--project requires a value"; project="$2"; shift 2 ;;
      --status)  [ $# -ge 2 ] || die "--status requires a value";  status="$2";  shift 2 ;;
      --all)  all=1; shift ;;
      --json) json=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  if ! factory_db_exists; then
    [ "$json" -eq 1 ] && { echo '[]'; return 0; }
    echo "no tickets yet — add one with: smriti ticket add \"<what you want>\""
    return 0
  fi

  local where="WHERE 1=1"
  if [ -n "$project" ]; then
    local pid; pid=$(resolve_project_ref "$project" "$([ "$repo_given" -eq 1 ] && printf '%s' "$repo" || current_slug)")
    where="$where AND project_id = $pid"
  elif [ "$repo_given" -eq 1 ]; then
    if [ "$repo" = "-" ]; then
      where="$where AND repo_slug IS NULL"
    else
      where="$where AND repo_slug = $(sql_quote "$repo")"
    fi
  elif [ "$all" -eq 0 ]; then
    local slug; slug=$(current_slug)
    [ -n "$slug" ] && where="$where AND repo_slug = $(sql_quote "$slug")"
  fi
  if [ -n "$status" ]; then
    validate_status "$status"
    where="$where AND status = $(sql_quote "$status")"
  elif [ "$all" -eq 0 ]; then
    # Shipped work is history; it clutters the working view unless asked for.
    where="$where AND status NOT IN ('shipped','cancelled')"
  fi

  local order="ORDER BY priority DESC, id ASC"

  if [ "$json" -eq 1 ]; then
    # Deliberately NOT called project_slug: that key existed in v1.2 and held
    # the REPOSITORY. Reusing the name for a different entity would break every
    # existing reader silently, one wrong value at a time.
    db_json "SELECT id, repo_slug, project_id,
                    (SELECT slug FROM projects p WHERE p.id = tickets.project_id) AS project_ref,
                    (SELECT name FROM projects p WHERE p.id = tickets.project_id) AS project_name,
                    title, body, status, priority, branch,
                    worktree_path, pr_url, origin, created_at, updated_at
             FROM tickets $where $order;"
    return 0
  fi

  # char(9), not '\t' — SQLite string literals have no backslash escapes, so
  # '\t' would be a literal backslash-t and the awk split below would never fire.
  local rows
  rows=$(db "SELECT id || char(9) || status || char(9) || coalesce(repo_slug,'—') || char(9) || title
             FROM tickets $where $order;")
  if [ -z "$rows" ]; then
    echo "no tickets yet — add one with: smriti ticket add \"<what you want>\""
    return 0
  fi
  printf '%s\n' "$rows" | awk -F'\t' '{ printf "%-5s %-12s %-22s %s\n", "#" $1, $2, $3, $4 }'
}

# ─── show ───────────────────────────────────────────────────────────────────

cmd_show() {
  local id="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -*) die "unknown flag: $1" ;;
      *) id="$1"; shift ;;
    esac
  done
  [ -n "$id" ] || usage
  require_id "$id"
  ticket_exists "$id" || die "no ticket #$id" 4

  if [ "$json" -eq 1 ]; then
    local t d
    t=$(db_json_one "SELECT * FROM tickets WHERE id = $id;")
    d=$(db_json "SELECT id, type, path, branch, created_at FROM documents WHERE ticket_id = $id ORDER BY id;")
    printf '{"ticket":%s,"documents":%s}\n' "$t" "$d"
    return 0
  fi

  db "SELECT '#' || id || '  ' || title || char(10) ||
             'app:      ' || coalesce(repo_slug, '— (an idea, no app yet)') || char(10) ||
             'project:  ' || coalesce((SELECT name FROM projects p WHERE p.id = tickets.project_id),
                                      '— (loose in the app)') || char(10) ||
             'status:   ' || status || char(10) ||
             'priority: ' || priority || char(10) ||
             'branch:   ' || coalesce(branch, '—') || char(10) ||
             'worktree: ' || coalesce(worktree_path, '—') || char(10) ||
             'pr:       ' || coalesce(pr_url, '—') || char(10) ||
             'created:  ' || created_at ||
             coalesce(char(10) || char(10) || body, '')
      FROM tickets WHERE id = $id;"

  local docs
  docs=$(db "SELECT '  ' || type || '  ' || path FROM documents WHERE ticket_id = $id ORDER BY id;")
  if [ -n "$docs" ]; then
    echo
    echo "documents:"
    printf '%s\n' "$docs"
  fi
}

# ─── start ──────────────────────────────────────────────────────────────────

# slugify() and repo_path_for_slug() live in lib/factory-db.sh: smriti-repo
# needs both identically, and one copy is what stops the two from drifting.

# The primary worktree of a repo — the one branch-lifecycle commands must run
# against. `git worktree list --porcelain` lists it first.
primary_worktree() {
  git -C "$1" worktree list --porcelain 2>/dev/null \
    | awk '/^worktree /{print substr($0,10); exit}'
}

# Worktrees live inside the repo, so without this the primary reads as
# permanently dirty (an untracked .claude/worktrees/) and every later
# `smriti clean` refuses. Written to .git/info/exclude rather than .gitignore:
# this is a local tool artifact, not something to commit into someone's repo.
ignore_worktrees_dir() {
  local repo="$1" gitdir exclude
  gitdir=$(git -C "$repo" rev-parse --git-common-dir 2>/dev/null) || return 0
  case "$gitdir" in /*) ;; *) gitdir="$repo/$gitdir" ;; esac
  exclude="$gitdir/info/exclude"
  mkdir -p "$(dirname "$exclude")" 2>/dev/null || return 0
  [ -f "$exclude" ] || : > "$exclude"
  grep -qxF '.claude/worktrees/' "$exclude" 2>/dev/null && return 0
  printf '%s\n' '.claude/worktrees/' >> "$exclude"
}

cmd_start() {
  [ $# -ge 1 ] || usage
  local id="$1"; shift
  require_id "$id"
  ticket_exists "$id" || die "no ticket #$id" 4

  while [ $# -gt 0 ]; do
    case "$1" in
      *) die "unknown flag: $1" ;;
    esac
  done

  # One sqlite3 process for all four columns; see db_fields for why this is a
  # statement per field rather than a separator-split row.
  local slug title branch existing_wt existing_branch
  db_fields "SELECT coalesce(repo_slug,'') FROM tickets WHERE id = $id;
             SELECT title                  FROM tickets WHERE id = $id;
             SELECT coalesce(worktree_path,'') FROM tickets WHERE id = $id;
             SELECT coalesce(branch,'')    FROM tickets WHERE id = $id;"
  slug="${DB_FIELDS[0]}"; title="${DB_FIELDS[1]}"
  existing_wt="${DB_FIELDS[2]}"; existing_branch="${DB_FIELDS[3]}"

  # Already started and the worktree is still there — attach, don't re-cut.
  if [ -n "$existing_wt" ] && [ -d "$existing_wt" ]; then
    echo "$existing_wt"
    echo "smriti-ticket: #$id already in progress on '$existing_branch'" >&2
    return 0
  fi

  # An idea has no code to cut a branch in. Say what to do rather than failing
  # with a confusing "don't know where project '' lives".
  [ -n "$slug" ] || die "#$id is an idea with no app yet — give it one first: smriti ticket edit $id --repo <slug>" 5

  local repo primary
  repo=$(repo_path_for_slug "$slug")
  if [ -z "$repo" ]; then
    # Only fall back to the cwd when it IS this ticket's project. Without the
    # match, `ticket start` for project A run from inside repo B cut the
    # worktree in B and recorded it, with no warning.
    if [ "$(current_slug)" = "$slug" ]; then
      repo=$(git rev-parse --show-toplevel 2>/dev/null || true)
    fi
    [ -n "$repo" ] || die "don't know where app '$slug' lives — run this from inside that repo once" 5
  fi
  primary=$(primary_worktree "$repo")
  [ -n "$primary" ] || primary="$repo"

  branch="$existing_branch"
  [ -n "$branch" ] || branch="t$id-$(slugify "$title")"

  local wt="$primary/.claude/worktrees/$branch"
  mkdir -p "$(dirname "$wt")"
  ignore_worktrees_dir "$primary"

  if [ -d "$wt" ]; then
    : # directory survived without a db row; adopt it
  elif git -C "$primary" show-ref --verify --quiet "refs/heads/$branch"; then
    # Branch exists already (a re-start after cleanup) — attach, don't recreate.
    git -C "$primary" worktree add "$wt" "$branch" >/dev/null 2>&1 \
      || die "could not attach worktree for existing branch '$branch'" 5
  else
    local base; base=$(base_branch_for "$primary")
    git -C "$primary" worktree add -b "$branch" "$wt" "$base" >/dev/null 2>&1 \
      || die "could not create worktree at $wt (branch '$branch' off '$base')" 5
  fi

  db_write "UPDATE tickets SET status = 'in_progress',
              branch = $(sql_quote "$branch"),
              worktree_path = $(sql_quote "$wt"),
              updated_at = $(sql_quote "$(now_utc)")
            WHERE id = $id;"

  # Path on stdout so a caller can `cd "$(smriti ticket start N)"`; everything
  # else on stderr so that stays machine-usable.
  echo "$wt"
  echo "smriti-ticket: #$id → in_progress on '$branch'" >&2
}

base_branch_for() {
  local repo="$1" b=""
  if [ -x "$SMRITI_BIN/smriti-default-branch" ]; then
    b=$(cd "$repo" && "$SMRITI_BIN/smriti-default-branch" 2>/dev/null || true)
  fi
  [ -n "$b" ] || b=main
  printf '%s' "$b"
}

# ─── status / done ──────────────────────────────────────────────────────────

cmd_status() {
  [ $# -ge 2 ] || usage
  local id="$1" status="$2"
  require_id "$id"
  validate_status "$status"
  ticket_exists "$id" || die "no ticket #$id" 4
  db_write "UPDATE tickets SET status = $(sql_quote "$status"), updated_at = $(sql_quote "$(now_utc)")
            WHERE id = $id;"
  echo "#$id → $status"
}

# A description is what you write when the title was not enough. Editable
# because the first line you type is rarely the last word on a piece of work.
cmd_edit() {
  [ $# -ge 1 ] || usage
  local id="$1"; shift
  require_id "$id"
  ticket_exists "$id" || die "no ticket #$id" 4

  local sets="" title="" body="" priority="" have=0 clear_body=0
  local repo="" project="" repo_given=0 project_given=0 no_project=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --title)    [ $# -ge 2 ] || die "--title requires a value";    title="$2";    have=1; shift 2 ;;
      --body)     [ $# -ge 2 ] || die "--body requires a value";     body="$2";     have=1; shift 2
                  [ -z "$body" ] && clear_body=1 ;;
      --priority) [ $# -ge 2 ] || die "--priority requires a value"; priority="$2"; have=1; shift 2 ;;
      --repo)     [ $# -ge 2 ] && [ -n "$2" ] || die "--repo requires a value (use '-' for no app)";     repo="$2";     have=1; repo_given=1; shift 2 ;;
      --project)  [ $# -ge 2 ] && [ -n "$2" ] || die "--project requires a value (use --no-project to detach)";  project="$2";  have=1; project_given=1; shift 2 ;;
      --no-project) no_project=1; have=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  [ "$have" -eq 1 ] || die "nothing to change — pass --title, --body, --priority, --repo or --project"
  [ "$project_given" -eq 1 ] && [ "$no_project" -eq 1 ] && die "--project and --no-project contradict each other"

  if [ -n "$title" ]; then
    case "$title" in
      *$'\n'*) die "title must be a single line — put detail in --body" ;;
    esac
    sets="$sets title = $(sql_quote "$title"),"
  fi
  # An explicitly empty --body clears the description rather than storing "".
  if [ "$clear_body" -eq 1 ]; then
    sets="$sets body = NULL,"
  elif [ -n "$body" ]; then
    sets="$sets body = $(sql_quote "$body"),"
  fi
  if [ -n "$priority" ]; then
    require_num "$priority" "--priority"
    sets="$sets priority = $priority,"
  fi

  # ── re-filing ─────────────────────────────────────────────────────────────
  # The app is the part that cannot move under a started ticket: worktree_path
  # points into the OLD app's repo, and `start` would happily reattach that
  # tree under the new slug. Refuse, and say which branch is in the way.
  local move_repo=0 new_repo="" project_sql=""
  if [ "$repo_given" -eq 1 ]; then
    if [ "$repo" = "-" ]; then new_repo=""; else new_repo=$(resolve_repo "$repo"); fi
    move_repo=1
  fi
  if [ "$project_given" -eq 1 ]; then
    # Scoped to the destination app when --repo names one. Without it the
    # scope is the app you are STANDING IN, which is what lets a loose ticket
    # be filed by slug from inside the repo it belongs to — and it means a slug
    # that exists in several apps resolves to this one's, moving the ticket
    # here. Long-standing behaviour, left alone; the pair check below is what
    # stops the two halves disagreeing when both are given.
    local pid; pid=$(resolve_project_ref "$project" "$([ "$move_repo" -eq 1 ] && printf '%s' "$new_repo" || current_slug)")
    project_sql="$pid"
    local p_repo; p_repo=$(repo_of_project "$pid")
    if [ "$move_repo" -eq 1 ]; then
      # Both halves given and disagreeing is a contradiction in one command,
      # not something to guess at. A bare numeric --project skips the slug
      # scoping above entirely, so this is the only thing standing between
      # `--repo a --project <id-in-b>` and a ticket filed across apps.
      [ "$p_repo" = "$new_repo" ] || \
        die "project '$project' lives in ${p_repo:-no app}, not ${new_repo:-no app} — a ticket cannot sit in a project belonging to another app"
    else
      # Filing into a project settles the app too — a ticket cannot sit in a
      # project belonging to a different app than its own.
      new_repo="$p_repo"; move_repo=1
    fi
  elif [ "$no_project" -eq 1 ]; then
    project_sql="NULL"
  fi

  if [ "$move_repo" -eq 1 ]; then
    local cur_repo cur_wt cur_branch cur_pid
    db_fields "SELECT coalesce(repo_slug,'')     FROM tickets WHERE id = $id;
               SELECT coalesce(worktree_path,'') FROM tickets WHERE id = $id;
               SELECT coalesce(branch,'')        FROM tickets WHERE id = $id;
               SELECT coalesce(project_id,'')    FROM tickets WHERE id = $id;"
    cur_repo="${DB_FIELDS[0]}"; cur_wt="${DB_FIELDS[1]}"; cur_branch="${DB_FIELDS[2]}"
    cur_pid="${DB_FIELDS[3]}"
    if [ "$cur_repo" != "$new_repo" ] && { [ -n "$cur_wt" ] || [ -n "$cur_branch" ]; }; then
      die "#$id is started on '$cur_branch' in ${cur_repo:-no app} — its worktree lives there. Finish or cancel it before moving it to another app"
    fi
    # Moving apps strands any project from the OLD one: the ticket ends up
    # filed in a project belonging somewhere else, which every later read then
    # has to defend against. The move settles it — that project is not a
    # project of this app. Only when the caller did not name a project itself;
    # an explicit --project has already been checked against the destination.
    if [ "$cur_repo" != "$new_repo" ] && [ -z "$project_sql" ] && [ -n "$cur_pid" ] &&
       [ "$(repo_of_project "$cur_pid")" != "$new_repo" ]; then
      project_sql="NULL"
    fi
    sets="$sets repo_slug = $(sql_quote_or_null "$new_repo"),"
  fi
  [ -n "$project_sql" ] && sets="$sets project_id = $project_sql,"

  # documents and runs carry their own copy of repo_slug/project_id, so a move
  # that touched only the ticket would leave its paper trail and run history
  # filed under the app it just left.
  local follow=""
  [ "$move_repo" -eq 1 ] && follow="$follow
    UPDATE documents SET repo_slug = $(sql_quote_or_null "$new_repo") WHERE ticket_id = $id;
    UPDATE runs      SET repo_slug = $(sql_quote_or_null "$new_repo") WHERE ticket_id = $id;"
  [ -n "$project_sql" ] && follow="$follow
    UPDATE documents SET project_id = $project_sql WHERE ticket_id = $id;
    UPDATE runs      SET project_id = $project_sql WHERE ticket_id = $id;"

  db_write "UPDATE tickets SET $sets updated_at = $(sql_quote "$(now_utc)") WHERE id = $id;$follow"
  echo "#$id updated"
}

# Cancel is reversible and keeps the paper trail; rm is not. Two verbs because
# "I am not doing this" and "this should never have existed" are different
# intentions, and only one of them deserves a confirmation prompt.
cmd_cancel() {
  [ $# -ge 1 ] || usage
  require_id "$1"
  ticket_exists "$1" || die "no ticket #$1" 4
  db_write "UPDATE tickets SET status = 'cancelled', updated_at = $(sql_quote "$(now_utc)") WHERE id = $1;"
  echo "#$1 → cancelled  (smriti ticket status $1 ready brings it back)"
}

cmd_rm() {
  [ $# -ge 1 ] || usage
  local id="$1"; shift
  require_id "$id"
  local yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) yes=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  ticket_exists "$id" || die "no ticket #$id" 4

  local title docs
  title=$(db "SELECT title FROM tickets WHERE id = $id;")
  docs=$(db "SELECT count(*) FROM documents WHERE ticket_id = $id;")

  if [ "$yes" -ne 1 ]; then
    if [ ! -t 0 ]; then
      die "refusing to delete without --yes in a non-interactive shell" 1
    fi
    echo "About to delete #$id  $title"
    [ "$docs" != "0" ] && echo "  $docs document row(s) forgotten (the files stay on disk)"
    printf "Delete? [y/N] "
    read -r ans || ans=""
    case "$ans" in y|Y|yes|YES) ;; *) echo "aborted."; exit 1 ;; esac
  fi

  # Only index rows go. The markdown on disk is the source of truth, and
  # deleting a ticket is not a reason to destroy the writing about it.
  db_write "DELETE FROM documents WHERE ticket_id = $id;
            DELETE FROM tickets WHERE id = $id;"
  echo "deleted: #$id  $title"
}

# /begin's ship step calls this once the PR exists. in_review rather than shipped:
# the merge has not happened yet, and `smriti clean` is what confirms it.
cmd_pr() {
  [ $# -ge 2 ] || usage
  local id="$1" url="$2"
  # `-` means "no ticket" — the same sentinel `doc` takes, so callers have one
  # shape for the optional case instead of guarding at every site.
  [ "$id" = "-" ] && return 0
  require_id "$id"
  ticket_exists "$id" || die "no ticket #$id" 4
  db_write "UPDATE tickets SET pr_url = $(sql_quote "$url"), status = 'in_review',
                               updated_at = $(sql_quote "$(now_utc)")
            WHERE id = $id;"
  echo "#$id → in_review  $url"
}

cmd_done() {
  [ $# -ge 1 ] || usage
  cmd_status "$1" shipped
}

# ─── doc ────────────────────────────────────────────────────────────────────

# Registering the same path twice is a no-op rather than an error: /begin may
# re-register its plan on a re-run, and failing there would break the flow for
# a bookkeeping detail.
cmd_doc() {
  [ $# -ge 1 ] || usage
  local id="$1"; shift
  local type="" path="" branch=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --type)   [ $# -ge 2 ] || die "--type requires a value";   type="$2";   shift 2 ;;
      --path)   [ $# -ge 2 ] || die "--path requires a value";   path="$2";   shift 2 ;;
      --branch) [ $# -ge 2 ] || die "--branch requires a value"; branch="$2"; shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  [ -n "$type" ] || die "--type is required"
  [ -n "$path" ] || die "--path is required"
  validate_doc_type "$type"

  local ticket_sql slug project_sql="NULL"
  if [ "$id" = "-" ]; then
    ticket_sql="NULL"
  else
    require_id "$id"
    ticket_exists "$id" || die "no ticket #$id" 4
    ticket_sql="$id"
  fi

  [ -z "$branch" ] && branch=$(current_branch)
  # The ticket is the better authority than the cwd: a doc registered from a
  # worktree still belongs to the app and project the ticket is filed under.
  if [ "$ticket_sql" != "NULL" ]; then
    db_fields "SELECT coalesce(repo_slug,'')      FROM tickets WHERE id = $id;
               SELECT coalesce(project_id,'NULL') FROM tickets WHERE id = $id;"
    slug="${DB_FIELDS[0]}"; project_sql="${DB_FIELDS[1]}"
  fi
  [ -n "$slug" ] || slug=$(current_slug)
  [ -n "$slug" ] || die "not in a git repo and no ticket to infer the app from"

  db_write "INSERT INTO documents (ticket_id, repo_slug, project_id, type, path, branch, created_at)
            VALUES ($ticket_sql, $(sql_quote "$slug"), ${project_sql:-NULL}, $(sql_quote "$type"),
                    $(sql_quote "$path"), $(sql_quote_or_null "$branch"), $(sql_quote "$(now_utc)"))
            ON CONFLICT(path) DO UPDATE SET
              ticket_id  = excluded.ticket_id,
              repo_slug  = excluded.repo_slug,
              project_id = excluded.project_id,
              branch     = excluded.branch;"
  echo "registered: $type → $path${ticket_sql:+ (#$id)}"
}

# The whole index in one call — the board renders paper trails and one
# subprocess per ticket would be an N+1.
cmd_docs() {
  local json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  if ! factory_db_exists; then
    [ "$json" -eq 1 ] && { echo '[]'; return 0; }
    echo "no documents yet"; return 0
  fi
  if [ "$json" -eq 1 ]; then
    db_json "SELECT id, ticket_id, repo_slug, project_id, type, path, branch, created_at
             FROM documents ORDER BY id;"
  else
    db "SELECT type || char(9) || coalesce('#' || ticket_id,'—') || char(9) || path
        FROM documents ORDER BY id;" | awk -F'\t' '{ printf "%-8s %-6s %s\n", $1, $2, $3 }'
  fi
}

# ─── doc-forget ─────────────────────────────────────────────────────────────

# Drop index rows for a branch whose files have been purged. The index must not
# outlive the documents it points at.
cmd_doc_forget() {
  local branch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --branch) [ $# -ge 2 ] || die "--branch requires a value"; branch="$2"; shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  [ -n "$branch" ] || die "--branch is required"

  local slug; slug=$(current_slug)
  local where="WHERE branch = $(sql_quote "$branch")"
  [ -n "$slug" ] && where="$where AND repo_slug = $(sql_quote "$slug")"

  local n; n=$(db "SELECT count(*) FROM documents $where;")
  db_write "DELETE FROM documents $where;"
  echo "forgot $n document(s) for '$branch'"
}

# ─── current ────────────────────────────────────────────────────────────────

# Emits `KEY=value` for `eval "$(smriti ticket current)"` in the skill preamble,
# mirroring the shape smriti-slug and smriti-codex-probe already use.
cmd_current() {
  local json=0 want_branch="" want_project=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)   json=1; shift ;;
      # smriti-clean needs the ticket for a branch it is about to delete, which by
      # then is not the branch it is standing on.
      --branch)  [ $# -ge 2 ] || die "--branch requires a value";  want_branch="$2";  shift 2 ;;
      # The preamble already has SLUG and BRANCH; passing them avoids
      # re-spawning smriti-slug and git on every skill invocation.
      # --project is the old spelling of --repo: this flag has always taken a
      # repository slug. Accepted so an older installed skill keeps working.
      --repo|--project) [ $# -ge 2 ] || die "$1 requires a value"; want_project="$2"; shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  # This runs in the preamble of every skill, so it must be cheap and must not
  # have side effects. Before the store exists there is nothing to answer with,
  # and asking would otherwise CREATE the database just to say "no ticket".
  if ! factory_db_exists; then
    [ "$json" -eq 1 ] && { echo '[]'; return 0; }
    printf 'TICKET=\n'
    return 0
  fi

  local slug branch
  slug="$want_project"
  [ -n "$slug" ] || slug=$(current_slug)
  branch="$want_branch"
  [ -n "$branch" ] || branch=$(current_branch)

  if [ -z "$slug" ] || [ -z "$branch" ]; then
    [ "$json" -eq 1 ] && { echo '[]'; return 0; }
    printf 'TICKET=\n'
    return 0
  fi

  local where="WHERE repo_slug = $(sql_quote "$slug") AND branch = $(sql_quote "$branch")"

  if [ "$json" -eq 1 ]; then
    db_json "SELECT * FROM tickets $where LIMIT 1;"
    return 0
  fi

  # One sqlite3 process for all four fields.
  local id title status project
  db_fields "SELECT id     FROM tickets $where LIMIT 1;
             SELECT title  FROM tickets $where LIMIT 1;
             SELECT status FROM tickets $where LIMIT 1;
             SELECT coalesce((SELECT name FROM projects p WHERE p.id = tickets.project_id),'')
               FROM tickets $where LIMIT 1;"
  if [ "${#DB_FIELDS[@]}" -lt 3 ] || [ -z "${DB_FIELDS[0]}" ]; then
    printf 'TICKET=\n'
    return 0
  fi
  id="${DB_FIELDS[0]}"; title="${DB_FIELDS[1]}"
  status="${DB_FIELDS[2]}"; project="${DB_FIELDS[3]}"
  printf 'TICKET=%s\n' "$id"
  printf 'TICKET_TITLE=%q\n' "$title"
  printf 'TICKET_STATUS=%s\n' "$status"
  printf 'TICKET_PROJECT=%q\n' "$project"
}

# ─── dispatch ───────────────────────────────────────────────────────────────

CMD="${1:-}"
shift || true
case "$CMD" in
  add)          cmd_add "$@" ;;
  list|ls)      cmd_list "$@" ;;
  show)         cmd_show "$@" ;;
  start)        cmd_start "$@" ;;
  edit)         cmd_edit "$@" ;;
  cancel)       cmd_cancel "$@" ;;
  rm)           cmd_rm "$@" ;;
  pr)           cmd_pr "$@" ;;
  status)       cmd_status "$@" ;;
  done)         cmd_done "$@" ;;
  doc)          cmd_doc "$@" ;;
  docs)         cmd_docs "$@" ;;
  doc-forget)   cmd_doc_forget "$@" ;;
  current)      cmd_current "$@" ;;
  ""|-h|--help) usage ;;
  *) echo "$SMRITI_TOOL: unknown command '$CMD'" >&2; usage ;;
esac
