#!/usr/bin/env bun
// smriti board — the factory's front door, served locally.
//
// Usage:
//   smriti board            start (or reuse) the server and open the browser
//   smriti board --url      print the URL without opening a browser
//   smriti board stop       stop the server
//
// Exit codes: 0=ok 1=usage 2=runtime
//
// A web page instead of the old raw-mode TUI, because the surface you live in
// daily needs typography, a palette, and the paper trail rendered in place —
// none of which a terminal can carry. The original objection ("a browser can't
// hand you an interactive terminal") is answered by THIS PROCESS: the server
// shells out to herdr to create the session, then shows the exact attach
// command rather than pretending it moved your focus.
//
// It holds NO SQL. All reads and writes go through the CLI verbs
// (smriti-ticket / smriti-trace), same as the TUI did. The one exception is
// reading document files to render them, guarded to $SMRITI_HOME/projects/.
//
// AUTH — this server cuts worktrees, spawns agents and reads files, so every
// route is authenticated:
//   - the CLI mints a secret (statedir, mode 0600) and opens /?k=<secret>
//   - that exchange sets an HttpOnly SameSite=Strict cookie; the page's own
//     fetches ride the cookie and never see the secret
//   - Host must be 127.0.0.1:<port> (kills DNS rebinding), and any Origin /
//     Sec-Fetch-Site present must be same-origin (kills cross-site CSRF)
//
// SINGLETON — state lives at $SMRITI_HOME/.server/factory/ (a fixed path, not
// a random session): portfile, pidfile, secret, log. Re-running `smriti`
// reuses a live server; a dead one is swept and restarted.

import { spawn, spawnSync } from 'node:child_process';
import { existsSync, mkdirSync, readFileSync, writeFileSync, rmSync, chmodSync, realpathSync, statSync } from 'node:fs';
import { dirname, join, sep } from 'node:path';
import { homedir } from 'node:os';
import { boardPage } from '../lib/board-ui.ts';
import { renderMarkdown } from '../lib/md.ts';

const SELF = realpathSync(process.argv[1]);
const SMRITI_BIN = dirname(SELF);
const TICKET = join(SMRITI_BIN, 'smriti-ticket');
const TRACE = join(SMRITI_BIN, 'smriti-trace');
const REPO = join(SMRITI_BIN, 'smriti-repo');
const PROJECT = join(SMRITI_BIN, 'smriti-project');
const HTML = join(SMRITI_BIN, 'smriti-html');
const SMRITI_HOME = process.env.SMRITI_HOME || join(homedir(), '.smriti');
const STATE_DIR = join(SMRITI_HOME, '.server', 'factory');
const IDLE_MS = Number(process.env.SMRITI_BOARD_IDLE_MS || 45 * 60 * 1000);
// Ceiling for /api/render. Descriptions are prose typed by one person; two
// orders of magnitude of headroom over the longest ticket in this backlog is
// plenty, and well under the 2 MB the document routes allow for whole files.
const MAX_RENDER_BYTES = 200_000;

function err(msg: string): never {
  process.stderr.write(`smriti-board: ${msg}\n`);
  process.exit(1);
}
function rand(n = 16): string {
  const b = new Uint8Array(n);
  crypto.getRandomValues(b);
  return [...b].map((x) => x.toString(16).padStart(2, '0')).join('');
}
function pidAlive(pid: number): boolean {
  try { process.kill(pid, 0); return true; } catch { return false; }
}
// Read a request body as text, refusing past `max` BYTES. Returns null when
// the body is over the cap — the caller turns that into a 413. Byte-counted
// rather than character-counted on purpose: one emoji is four bytes, so a
// character budget would admit several times the limit it advertises.
async function readCapped(req: Request, max: number): Promise<string | null> {
  if (!req.body) return '';
  const reader = req.body.getReader();
  const chunks: Uint8Array[] = [];
  let n = 0;
  for (;;) {
    const { done, value } = await reader.read();
    if (done) break;
    n += value.byteLength;
    if (n > max) { await reader.cancel(); return null; }
    chunks.push(value);
  }
  const buf = new Uint8Array(n);
  let at = 0;
  for (const c of chunks) { buf.set(c, at); at += c.byteLength; }
  return new TextDecoder().decode(buf);
}
function readState(): { port: number; pid: number; secret: string } | null {
  try {
    const port = parseInt(readFileSync(join(STATE_DIR, 'portfile'), 'utf8').trim(), 10);
    const pid = parseInt(readFileSync(join(STATE_DIR, 'pidfile'), 'utf8').trim(), 10);
    const secret = readFileSync(join(STATE_DIR, 'secret'), 'utf8').trim();
    if (!port || !pid || !secret) return null;
    return { port, pid, secret };
  } catch { return null; }
}
// `code` carries the CLI's own exit code through, because a few of them mean
// something specific enough that the page should react differently: a reorder
// refused for naming another group (6) is the user's mistake and deserves a
// 4xx, not the blanket 500 every other failure collapses to. null when the
// child was killed or never ran.
function sh(bin: string, args: string[], timeoutMs = 15000): { ok: boolean; out: string; errOut: string; code: number | null } {
  const r = spawnSync(bin, args, { encoding: 'utf8', timeout: timeoutMs });
  return { ok: r.status === 0, out: (r.stdout || '').trim(), errOut: (r.stderr || '').trim(), code: r.status };
}
// null means "the read failed", which is NOT the same as "there is nothing".
// Collapsing the two rendered a broken store as an inviting blank page.
function readJsonCmd<T>(args: string[], from = TICKET): T[] | null {
  const r = sh(from, args);
  if (!r.ok) return null;
  try { return JSON.parse(r.out || '[]') as T[]; } catch { return null; }
}
// Non-blocking reads. spawnSync freezes the single event loop for as long as
// the child runs — this file already says so about `shAsync` — and a trace read
// spawns sqlite3, so the timing routes must not use it: opening a ticket with
// twenty runs would otherwise stall SSE, /api/ping and every other tab.
async function shOut(bin: string, args: string[], timeoutMs = 15000): Promise<{ ok: boolean; out: string }> {
  const p = Bun.spawn([bin, ...args], { stdout: 'pipe', stderr: 'ignore' });
  const killer = setTimeout(() => p.kill(), timeoutMs);
  try {
    const out = await new Response(p.stdout).text();
    return { ok: (await p.exited) === 0, out: out.trim() };
  } catch {
    return { ok: false, out: '' };
  } finally {
    clearTimeout(killer);
  }
}
// null still means "the read failed", never "there is nothing".
async function readJsonAsync<T>(args: string[], from = TICKET): Promise<T | null> {
  const r = await shOut(from, args);
  if (!r.ok) return null;
  try { return JSON.parse(r.out || 'null') as T; } catch { return null; }
}
function openInBrowser(url: string): void {
  const opener = process.platform === 'darwin' ? 'open' : process.platform === 'win32' ? 'start' : 'xdg-open';
  spawnSync(opener, [url], { stdio: 'ignore' });
}

// ─── session launcher: herdr → a command you can paste ───────────────────
// herdr is the session backend. It knows a pane holds Claude Code, creates
// worktree workspaces natively, and confirms the agent is actually up before
// returning — none of which a plain multiplexer can do.
//
// There is deliberately no second multiplexer to fall back to: maintaining two
// was the thing being removed, and a silent fallback is worse than an honest
// one. herdr is pre-1.0 with observed CLI churn, so every call is still
// defensive — any failure lands on the printed command, which always works.
// The board never fails a start because the backend did.

type Launch = {
  method: 'herdr' | 'manual';
  attach: string;
  existing?: boolean;
  agentStatus?: string;
  prompting?: boolean;
};

type Session = { name: string; status: string; cwd: string; pane: string };

// Only what this file touches — the payload is passed through to the page
// verbatim, and smriti-trace owns its shape.
type Run = { run_uid: string; status: string; html_session?: string | null; html_url?: string };

// The live review page for a run parked at a gate, or nothing.
//
// Resolved on every read rather than stored, because the port dies with the
// server and a link built from a remembered port is a link to nothing. Only
// `awaiting` runs are asked about — that is the only state where a gate can be
// open — so this is bounded to the handful of rows in "waiting on you", and is
// almost always zero.
//
// The answer is treated as DATA, not gospel: only a plausible numeric port is
// accepted, and the URL is synthesized here rather than taken from the JSON.
// Memoized, because /api/state is not a once-a-minute route: the db-mtime
// watcher broadcasts a change roughly every second while a run is writing, and
// each one drives a refresh. Without this, a gated run means booting a whole
// bun process per second just to ask whether a port is answering. A gate that
// opens or closes within the window is a second late to the board and no more.
const htmlUrlCache = new Map<string, { url: string | null; at: number }>();
const HTML_URL_TTL_MS = 3000;

async function resolveHtmlUrls(runs: Run[]): Promise<void> {
  const gated = runs.filter((r) => r.status === 'awaiting' && r.html_session);
  if (!gated.length) { htmlUrlCache.clear(); return; }
  const now = Date.now();
  // Bounded by the live gates; a session that stops being one is not kept.
  for (const [k, v] of htmlUrlCache) {
    if (now - v.at > HTML_URL_TTL_MS || !gated.some((r) => r.html_session === k)) htmlUrlCache.delete(k);
  }
  await Promise.all(gated.map(async (r) => {
    const key = String(r.html_session);
    const hit = htmlUrlCache.get(key);
    if (hit) { if (hit.url) r.html_url = hit.url; return; }
    const out = await readJsonAsync<{ port?: unknown }>(['url', '--session', key], HTML);
    const port = Number(out?.port);
    const url = Number.isInteger(port) && port > 0 && port < 65536 ? `http://127.0.0.1:${port}/` : null;
    htmlUrlCache.set(key, { url, at: now });
    if (url) r.html_url = url;
  }));
}

// Every herdr agent, so the board can show what a session is actually doing.
// This is the only source that knows a Claude session is blocked on input —
// smriti's trace only sees /begin's own gates.
//
// Deliberately NOT filtered on `name`: herdr drops the assigned name (an agent
// started as `t3` was later listed with no name at all, so `agent read t3`
// answered agent_not_found). Filtering on it made live sessions vanish from the
// board — no blocked indicator, and start offered again on work already running.
// `cwd` is the identifier herdr does not lose, and it equals worktree_path.
function herdrSessions(): Session[] {
  if (!Bun.which('herdr')) return [];
  const r = sh('herdr', ['agent', 'list'], 8000);
  if (!r.ok) return [];
  try {
    return (JSON.parse(r.out)?.result?.agents ?? [])
      .map((a: { name?: string; agent_status?: string; status?: string; cwd?: string; pane_id?: string }) => ({
        name: a?.name ?? '',
        status: a?.agent_status ?? a?.status ?? 'unknown',
        cwd: a?.cwd ?? '',
        pane: a?.pane_id ?? '',
      }))
      .filter((s: Session) => s.name || s.cwd);
  } catch { return []; }
}

// Is there already a session for this ticket? Without this check, starting an
// already-in-progress ticket tried to spawn a SECOND agent under the same name —
// the launch failed and the board fell back to a paste command, telling you to
// run claude by hand for a session that was already open.
//
// Matched on the worktree path first, for the name-loss reason above.
function existingAgent(name: string, dir?: string): { found: boolean; status?: string; name?: string; pane?: string } {
  const hit = herdrSessions().find((s) => (dir && s.cwd === dir) || (s.name && s.name === name));
  return hit ? { found: true, status: hit.status, name: hit.name, pane: hit.pane } : { found: false };
}

// Default is `bypass` (--dangerously-skip-permissions), because the whole point
// of starting work from the board is walking away from it: a session that stops
// to ask is a session that sits there until you notice. The board surfaces a
// blocked agent now, so a stall is visible rather than silent — but not stalling
// is better than being told about it.
//
// Opt out per machine when you want claude to ask the way it would if you
// launched it yourself:
//   smriti config set board_permissions ask
function permissionMode(): 'ask' | 'bypass' {
  const r = sh(join(SMRITI_BIN, 'smriti-config'), ['get', 'board_permissions'], 5000);
  return r.out.trim() === 'ask' ? 'ask' : 'bypass';
}

// Non-blocking spawn. The whole board runs on one event loop, so the spawnSync
// used everywhere else would freeze every other request — including the polling
// that draws the board — for as long as it waits. Prompt delivery waits on a
// human-scale UI, so it has to stay off the loop.
async function shAsync(bin: string, args: string[], timeoutMs: number): Promise<boolean> {
  const p = Bun.spawn([bin, ...args], { stdout: 'ignore', stderr: 'ignore' });
  const killer = setTimeout(() => p.kill(), timeoutMs);
  try { return (await p.exited) === 0; } finally { clearTimeout(killer); }
}

// Type the prompt into the session, the way you would.
//
// `herdr agent prompt` is the documented way to do this and it does not work
// against Claude Code — it answers agent_prompt_stalled even with the agent
// sitting at idle. Sending the keystrokes does work, but only once Claude is
// actually able to receive them, and two things stand in the way:
//
//   1. Every ticket worktree is a directory Claude has never been run in, so it
//      opens on "Is this a project you trust?" and reads nothing else until that
//      is answered. There is no flag to pre-accept it (--print skips the dialog,
//      but that is not an interactive session), and the trust record lives in
//      claude's own ~/.claude.json, which is not ours to rewrite underneath a
//      running process.
//   2. agent_status reaches `idle` several seconds before the input box exists.
//      The placeholder is the honest signal that a keystroke will land.
//
// Typing before either was settled is what "the session opened but /begin never
// ran" was: the text went nowhere, and the session sat on the welcome screen
// improvising until someone attached to it.
async function deliverPrompt(pane: string, prompt: string): Promise<boolean> {
  // A miss here is the normal case for a worktree you have already opened once,
  // so this is a bounded look, not a requirement.
  if (await shAsync('herdr', ['pane', 'wait-output', pane, '--match', 'trust', '--timeout', '15000'], 20000)) {
    await shAsync('herdr', ['pane', 'send-keys', pane, 'Enter'], 5000);
  }
  if (!await shAsync('herdr', ['pane', 'wait-output', pane, '--regex', 'Try "', '--timeout', '60000'], 65000)) {
    return false; // never became ready — leave the session alone rather than typing into it blind
  }
  await Bun.sleep(1500);
  if (!await shAsync('herdr', ['pane', 'send-text', pane, prompt], 10000)) return false;
  await Bun.sleep(500);
  return shAsync('herdr', ['pane', 'send-keys', pane, 'Enter'], 10000);
}

function launchSession(dir: string, ticketId: number, force = false): Launch {
  const prompt = `/begin ticket:${ticketId}`;
  const name = `t${ticketId}`;
  // Flags only. These are appended to the executable that --kind claude already
  // chose, so naming `claude` again ran `claude claude …` and the prompt was
  // swallowed as an argument to nothing.
  const claudeFlags = permissionMode() === 'bypass' ? ['--dangerously-skip-permissions'] : [];

  // Already running (or already run) — hand back the way in rather than
  // starting a duplicate.
  const prior = force ? { found: false as const } : existingAgent(name, dir);
  if (prior.found) {
    const target = prior.name || name;
    return { method: 'herdr', attach: `herdr agent attach ${target}`, existing: true, agentStatus: prior.status };
  }
  // Single-quoted with any ' doubled: repo paths with spaces are a supported
  // case elsewhere in this repo, and an unquoted cd silently lands you in the
  // wrong directory rather than failing loudly.
  const q = (v: string) => `'${v.replace(/'/g, `'\\''`)}'`;
  const manual = {
    method: 'manual' as const,
    attach: `cd ${q(dir)} && ${['claude', ...claudeFlags, prompt].map(q).join(' ')}`,
  };

  if (Bun.which('herdr')) {
    try {
      // Verified against herdr 0.8.0, which differs from its docs in three
      // ways — each one silently turned every start into a pasted command:
      //   - there is no --json flag; output is JSON already (--json is an error)
      //   - `worktree open` needs --cwd to name the SOURCE repo when no
      //     workspace is active, not just --path
      //   - the pane id is result.root_pane.pane_id, an object not a string
      const repoRoot = sh('git', ['-C', dir, 'worktree', 'list', '--porcelain'], 5000)
        .out.split('\n').find((l) => l.startsWith('worktree '))?.slice(9) ?? dir;

      const ws = sh('herdr', ['worktree', 'open', '--cwd', repoRoot, '--path', dir], 20000);
      let pane = '';
      if (ws.ok) {
        try { pane = JSON.parse(ws.out)?.result?.root_pane?.pane_id ?? ''; } catch {}
      }

      if (pane) {
        // A freshly-opened pane is not yet at a shell prompt, and `agent start`
        // rejects it as agent_pane_busy. Retry briefly rather than giving up —
        // in testing this succeeded on the second attempt, a second later.
        for (let i = 0; i < 8; i++) {
          const args = ['agent', 'start', name, '--kind', 'claude', '--pane', pane];
          if (claudeFlags.length) args.push('--', ...claudeFlags);
          const st = sh('herdr', args, 45000);
          if (st.ok && !/"error"/.test(st.out)) {
            // Deliberately not awaited: the answer to "did the session start" is
            // already known, and typing the prompt takes as long as claude takes
            // to boot. The board watches agent status for the rest.
            void deliverPrompt(pane, prompt);
            return { method: 'herdr', attach: `herdr agent attach ${name}`, prompting: true };
          }
          if (!/agent_pane_busy/.test(st.out + st.errOut)) break; // a real failure
          Bun.sleepSync(1000);
        }
      }
    } catch {}
  }

  return manual;
}

// ─── the server process ──────────────────────────────────────────────────

async function cmdServer(): Promise<never> {
  mkdirSync(STATE_DIR, { recursive: true });
  chmodSync(STATE_DIR, 0o700);
  const secret = rand(16);

  const cookies = new Set<string>();
  let last = Date.now();
  const touch = () => { last = Date.now(); };
  const sse = new Set<(s: string) => void>();

  const projectsRoot = (() => {
    const p = join(SMRITI_HOME, 'projects');
    mkdirSync(p, { recursive: true });
    return realpathSync(p);
  })();

  const json = (data: unknown, status = 200, headers: Record<string, string> = {}) =>
    new Response(JSON.stringify(data), { status, headers: { 'content-type': 'application/json', ...headers } });

  const server = Bun.serve({
    hostname: '127.0.0.1',
    port: 0,
    idleTimeout: 120,
    async fetch(req) {
      const url = new URL(req.url);

      // Host check first: a DNS-rebinding page reaches us with its own Host.
      if (req.headers.get('host') !== `127.0.0.1:${server.port}`) {
        return new Response('forbidden', { status: 403 });
      }
      // Cross-site checks: browsers send these; same-origin fetches pass.
      const origin = req.headers.get('origin');
      if (origin && origin !== `http://127.0.0.1:${server.port}`) {
        return new Response('forbidden', { status: 403 });
      }
      const sfs = req.headers.get('sec-fetch-site');
      if (sfs && sfs !== 'same-origin' && sfs !== 'none') {
        return new Response('forbidden', { status: 403 });
      }

      const cookie = (req.headers.get('cookie') || '').match(/smriti_board=([a-f0-9]+)/)?.[1];
      const authed = Boolean(cookie && cookies.has(cookie));

      // The bootstrap exchange: secret → cookie. The only route that works
      // without a cookie.
      if (url.pathname === '/' && req.method === 'GET') {
        const k = url.searchParams.get('k');
        if (k && k === secret) {
          touch();
          const token = rand(16);
          cookies.add(token);
          return new Response(null, {
            status: 302,
            headers: {
              location: '/',
              'set-cookie': `smriti_board=${token}; HttpOnly; SameSite=Strict; Path=/`,
            },
          });
        }
        if (authed) { touch(); return new Response(boardPage(), { headers: { 'content-type': 'text/html; charset=utf-8' } }); }
        return new Response('smriti board: not authorized — run `smriti` to open the board', { status: 403 });
      }

      if (!authed) return new Response('forbidden', { status: 403 });

      if (url.pathname === '/api/ping') { touch(); return json({ ok: true }); }

      if (url.pathname === '/api/state' && req.method === 'GET') {
        touch();
        const tickets = readJsonCmd(['list', '--all', '--json']);
        // TWO reads, not one. Finished runs are needed so a card can say "took
        // 18m", and a recency window is the right shape for that — but bounding
        // the list on recency alone silently dropped an OLD run parked at a
        // gate, and "waiting on you" showing an empty forest while a gate is
        // actually blocking is the one failure this board must never have. The
        // active read restores that guarantee; the window is decoration.
        const [recent, active] = await Promise.all([
          readJsonAsync<Run[]>(['list', '--limit', '200', '--json'], TRACE),
          readJsonAsync<Run[]>(['list', '--active', '--json'], TRACE),
        ]);
        const documents = readJsonCmd(['docs', '--json']);
        const repositories = readJsonCmd(['list', '--json'], REPO);
        const projects = readJsonCmd(['list', '--all', '--json'], PROJECT);
        if (tickets === null) {
          return json({ error: 'could not read the ticket store' }, 503);
        }
        const byUid = new Map<string, Run>();
        for (const r of [...(active ?? []), ...(recent ?? [])]) byUid.set(r.run_uid, r);
        const runs = [...byUid.values()];
        await resolveHtmlUrls(runs);
        return json({
          tickets,
          runs,
          documents: documents ?? [],
          repositories: repositories ?? [],
          projects: projects ?? [],
          sessions: herdrSessions(),
        });
      }

      // Every run for one ticket, however old — the overlay must not depend on
      // a run still being inside /api/state's window. The limit is explicit
      // because cmd_list defaults to 100, and inheriting that default would
      // reintroduce the very truncation this route exists to avoid.
      if (url.pathname === '/api/runs' && req.method === 'GET') {
        touch();
        const id = url.searchParams.get('ticket') || '';
        if (!/^\d+$/.test(id)) return json({ error: 'bad ticket' }, 400);
        const runs = await readJsonAsync<Run[]>(['list', '--ticket', id, '--limit', '1000', '--json'], TRACE);
        if (runs === null) return json({ error: 'could not read the trace' }, 503);
        return json({ runs });
      }

      // One run's phase breakdown. The uid comes from the client, so it is
      // validated against the shape `trace start` mints before it reaches the
      // CLI — the same discipline as the numeric guard on /api/doc/:id.
      const runDetail = url.pathname.match(/^\/api\/run\/(.+)$/);
      if (runDetail && req.method === 'GET') {
        touch();
        const uid = runDetail[1];
        if (!/^[0-9a-f]{8}$/.test(uid)) return json({ error: 'bad run id' }, 400);
        const detail = await readJsonAsync(['show', uid, '--json'], TRACE);
        if (detail === null) return json({ error: 'no such run' }, 404);
        return json(detail);
      }

      if (url.pathname === '/api/stats' && req.method === 'GET') {
        touch();
        const days = url.searchParams.get('days') || '30';
        if (!/^\d{1,9}$/.test(days)) return json({ error: 'bad days' }, 400);
        const stats = await readJsonAsync(['stats', '--days', days, '--json'], TRACE);
        if (stats === null) return json({ error: 'could not read the trace' }, 503);
        return json(stats);
      }

      if (url.pathname.startsWith('/api/doc/') && req.method === 'GET') {
        touch();
        const id = url.pathname.split('/').pop() || '';
        if (!/^\d+$/.test(id)) return json({ error: 'bad id' }, 400);
        const doc = readJsonCmd<{ id: number; path: string }>(['docs', '--json']).find((d) => d.id === Number(id));
        if (!doc) return json({ error: 'no such document' }, 404);
        // The one step outside the CLI contract: reading a file to render it.
        // realpath + prefix check so this can never become a file-read oracle.
        let real = '';
        try { real = realpathSync(doc.path); } catch { return json({ error: 'file is gone' }, 404); }
        if (!real.startsWith(projectsRoot + sep)) return json({ error: 'forbidden path' }, 403);
        if (statSync(real).size > 2_000_000) return json({ error: 'too large' }, 413);
        return json({ html: renderMarkdown(readFileSync(real, 'utf8')) });
      }

      // Markdown for the three DESCRIPTION surfaces — a ticket body, an app
      // description, a project description.
      //
      // A function over the wire rather than a resource, and deliberately so:
      // the client already holds all three sources (they ride along in
      // /api/state), it just cannot reach the renderer, because the whole
      // browser client is one template string with no build step. Per-entity
      // GET routes would shell out three times to fetch what the caller
      // already had. /api/doc/:id has to be per-entity for a different reason
      // — the server owns file access there, and nothing here touches a file.
      //
      // Nor does the rendered HTML belong in /api/state: that payload is
      // rebuilt on a ~1s mtime watch, and most bodies are never opened, so
      // embedding them would render every description in the store on every
      // tick to serve the one the reader actually looked at.
      if (url.pathname === '/api/render' && req.method === 'POST') {
        touch();
        // The cap is enforced while READING, not after. req.json() buffers the
        // whole body before it returns, so a length checked afterwards is a
        // length whose cost has already been paid — and content-length alone
        // cannot be trusted, since a chunked body does not declare one at all.
        // Reading with a running budget covers both, and never holds more than
        // the cap plus the chunk that crossed it.
        const declared = Number(req.headers.get('content-length') || 0);
        if (declared > MAX_RENDER_BYTES) return json({ error: 'too large' }, 413);
        const raw = await readCapped(req, MAX_RENDER_BYTES);
        if (raw === null) return json({ error: 'too large' }, 413);
        let b: { md?: string } = {};
        try { b = JSON.parse(raw); } catch {}
        return json({ html: renderMarkdown(typeof b.md === 'string' ? b.md : '') });
      }

      // ── repo-level markdown ────────────────────────────────────────────
      // The board's SECOND exception to "read nothing outside
      // $SMRITI_HOME/projects/", and deliberately the narrower of the two: the
      // filename is not user input at all.
      //   - the slug shape forbids separators, so it cannot traverse
      //   - the document name comes from a fixed two-item allowlist
      //   - the repo root comes from `smriti repo show --json`, never the client
      //   - realpath must still land under that root, so a symlinked DESIGN.md
      //     pointing at ~/.ssh/id_rsa is refused
      const repoDoc = url.pathname.match(/^\/api\/repos\/([^/]+)\/doc\/([A-Z]+)$/);
      if (repoDoc && req.method === 'GET') {
        touch();
        const slug = decodeURIComponent(repoDoc[1]);
        if (!/^[a-z0-9][a-z0-9._-]*$/i.test(slug)) return json({ error: 'bad slug' }, 400);
        const NAMES: Record<string, string> = { PROJECT: 'PROJECT.md', DESIGN: 'DESIGN.md' };
        const name = NAMES[repoDoc[2]];
        if (!name) return json({ error: 'no such document' }, 404);

        const info = sh(REPO, ['show', slug, '--json']);
        if (!info.ok) return json({ error: 'no such app' }, 404);
        let root = '';
        try { root = JSON.parse(info.out)?.repo_path || ''; } catch {}
        if (!root) return json({ error: 'this app has no repo on this machine' }, 404);

        let realRoot = '';
        try { realRoot = realpathSync(root); } catch { return json({ error: 'repo is gone' }, 404); }
        let real = '';
        try { real = realpathSync(join(realRoot, name)); } catch { return json({ error: 'no ' + name }, 404); }
        if (real !== join(realRoot, name) && !real.startsWith(realRoot + sep)) {
          return json({ error: 'forbidden path' }, 403);
        }
        if (statSync(real).size > 2_000_000) return json({ error: 'too large' }, 413);
        return json({ name, path: real, html: renderMarkdown(readFileSync(real, 'utf8')) });
      }

      if (url.pathname === '/api/tickets' && req.method === 'POST') {
        touch();
        const body = (await req.json().catch(() => ({}))) as {
          title?: string; repo?: string; project?: string;
        };
        const title = (body.title || '').trim();
        if (!title) return json({ error: 'a title is required' }, 400);
        const args = ['add', title, '--ready'];
        // No repo and no project is a legitimate capture: an idea. '-' says so
        // explicitly — omitting --repo would let smriti-ticket derive one from
        // the SERVER's cwd, which is wherever `smriti` happened to be started.
        if (body.project) args.push('--project', body.project);
        args.push('--repo', body.repo || '-');
        const r = sh(TICKET, args);
        if (!r.ok) return json({ error: r.errOut || 'could not add' }, 500);
        const id = Number(r.out.match(/#(\d+)/)?.[1] || 0);
        broadcast();
        return json({ id });
      }

      // ── apps and projects ──────────────────────────────────────────────
      const repoEdit = url.pathname.match(/^\/api\/repos\/([^/]+)$/);
      if (repoEdit && req.method === 'PATCH') {
        touch();
        const b = (await req.json().catch(() => ({}))) as { name?: string; description?: string };
        const args = ['edit', decodeURIComponent(repoEdit[1])];
        if (typeof b.name === 'string') args.push('--name', b.name);
        if (typeof b.description === 'string') args.push('--description', b.description);
        if (args.length === 2) return json({ error: 'nothing to change' }, 400);
        const r = sh(REPO, args);
        if (!r.ok) return json({ error: r.errOut || 'could not edit' }, 500);
        broadcast();
        return json({ ok: true });
      }

      if (url.pathname === '/api/projects' && req.method === 'POST') {
        touch();
        const b = (await req.json().catch(() => ({}))) as {
          name?: string; repo?: string; description?: string;
        };
        const name = (b.name || '').trim();
        if (!name) return json({ error: 'a name is required' }, 400);
        // '-' is smriti-project's explicit "no app yet", which is not the same
        // as "derive one from the cwd" — and the server's cwd is meaningless.
        const args = ['add', name, '--repo', b.repo || '-'];
        if (b.description) args.push('--description', b.description);
        const r = sh(PROJECT, args);
        if (!r.ok) return json({ error: r.errOut || 'could not add' }, 500);
        broadcast();
        return json({ id: Number(r.out.match(/#(\d+)/)?.[1] || 0) });
      }

      const projEdit = url.pathname.match(/^\/api\/projects\/(\d+)$/);
      if (projEdit && req.method === 'PATCH') {
        touch();
        const b = (await req.json().catch(() => ({}))) as {
          name?: string; description?: string; repo?: string;
        };
        const args = ['edit', projEdit[1]];
        if (typeof b.name === 'string') args.push('--name', b.name);
        if (typeof b.description === 'string') args.push('--description', b.description);
        if (typeof b.repo === 'string') args.push('--repo', b.repo || '-');
        if (args.length === 2) return json({ error: 'nothing to change' }, 400);
        const r = sh(PROJECT, args);
        if (!r.ok) return json({ error: r.errOut || 'could not edit' }, 500);
        broadcast();
        return json({ ok: true });
      }
      if (projEdit && req.method === 'DELETE') {
        touch();
        const r = sh(PROJECT, ['rm', projEdit[1], '--yes']);
        if (!r.ok) return json({ error: r.errOut || 'could not delete' }, 500);
        broadcast();
        return json({ ok: true });
      }

      const start = url.pathname.match(/^\/api\/tickets\/(\d+)\/start$/);
      if (start && req.method === 'POST') {
        touch();
        const id = Number(start[1]);
        const r = sh(TICKET, ['start', String(id)], 30000);
        if (!r.ok) return json({ error: r.errOut || 'could not start' }, 500);
        const dir = r.out.split('\n')[0].trim();
        const launch = launchSession(dir, id);
        broadcast();
        return json({ path: dir, ...launch });
      }

      // Explicitly replace a session: close the old pane, then start fresh.
      const restart = url.pathname.match(/^\/api\/tickets\/(\d+)\/restart$/);
      if (restart && req.method === 'POST') {
        touch();
        const id = Number(restart[1]);
        // `start` is idempotent and reports the existing worktree, which is how
        // we find the old session — it is the pane whose cwd is this worktree.
        const r = sh(TICKET, ['start', String(id)], 30000);
        if (!r.ok) return json({ error: r.errOut || 'could not restart' }, 500);
        const dir = r.out.split('\n')[0].trim();
        // herdr 0.8 has no `agent stop`. Closing the pane is what actually ends
        // the session: renaming the agent only frees the name, and the old claude
        // would still be sitting in that pane, so the new `agent start` would be
        // refused as agent_pane_busy forever. A restart replaces the session, so
        // losing the old pane is the point rather than a cost.
        const old = existingAgent(`t${id}`, dir);
        if (old.found && old.pane && Bun.which('herdr')) {
          sh('herdr', ['pane', 'close', old.pane], 10000);
          Bun.sleepSync(500);
        }
        // force: the session we just closed can still be listed for a moment,
        // and matching on cwd would otherwise make restart a no-op.
        const launch = launchSession(dir, id, true);
        broadcast();
        return json({ path: dir, ...launch });
      }

      const edit = url.pathname.match(/^\/api\/tickets\/(\d+)$/);
      if (edit && req.method === 'PATCH') {
        touch();
        const b = (await req.json().catch(() => ({}))) as {
          title?: string; body?: string; repo?: string; project?: string | null;
        };
        const args = ['edit', edit[1]];
        if (typeof b.title === 'string') args.push('--title', b.title);
        if (typeof b.body === 'string') args.push('--body', b.body);
        if (typeof b.repo === 'string') args.push('--repo', b.repo || '-');
        // null means "take it out of its project"; a value files it into one.
        if (b.project === null) args.push('--no-project');
        else if (typeof b.project === 'string' && b.project) args.push('--project', b.project);
        if (args.length === 2) return json({ error: 'nothing to change' }, 400);
        const r = sh(TICKET, args);
        if (!r.ok) return json({ error: r.errOut || 'could not edit' }, 500);
        broadcast();
        return json({ ok: true });
      }
      if (edit && req.method === 'DELETE') {
        touch();
        const r = sh(TICKET, ['rm', edit[1], '--yes']);
        if (!r.ok) return json({ error: r.errOut || 'could not delete' }, 500);
        broadcast();
        return json({ ok: true });
      }

      // /revive and /cancel used to sit here, one hardcoding `status ready`
      // and the other the `cancel` verb. They were the buttons' routes, and
      // the buttons became rows on the status picker — which posts here with
      // the value it wants. Two spellings of "write a status" that nothing
      // called were two more places to keep in step with validate_status.
      //
      // Kept as its own route rather than a field on PATCH: `edit` and
      // `status` are separate CLI verbs, so a PATCH carrying status alongside
      // repo would have to run two of them in sequence with nothing
      // transactional around the pair.
      const setStatus = url.pathname.match(/^\/api\/tickets\/(\d+)\/status$/);
      if (setStatus && req.method === 'POST') {
        touch();
        const b = (await req.json().catch(() => ({}))) as { status?: string };
        if (typeof b.status !== 'string' || !b.status) return json({ error: 'a status is required' }, 400);
        // The CLI owns which values are legal — validate_status rejects
        // anything else and its message names the whole set.
        const r = sh(TICKET, ['status', setStatus[1], b.status]);
        if (!r.ok) return json({ error: r.errOut || 'could not set the status' }, 500);
        broadcast();
        return json({ ok: true });
      }

      // Reorder. Relative to another card, never a raw position — the CLI owns
      // the arithmetic, so the drag and the keyboard both land on one place
      // that can decide about midpoints and renumbering.
      const move = url.pathname.match(/^\/api\/tickets\/(\d+)\/move$/);
      if (move && req.method === 'POST') {
        touch();
        const b = (await req.json().catch(() => ({}))) as
          { before?: number; after?: number; top?: boolean; bottom?: boolean };
        let args: string[];
        if (typeof b.before === 'number')     args = ['move', move[1], '--before', String(b.before)];
        else if (typeof b.after === 'number') args = ['move', move[1], '--after', String(b.after)];
        else if (b.top)                       args = ['move', move[1], '--top'];
        else if (b.bottom)                    args = ['move', move[1], '--bottom'];
        else return json({ error: 'say where it goes: before, after, top or bottom' }, 400);
        const r = sh(TICKET, args);
        // 6 is "that target is in another app or project" — an illegal drop
        // rather than a broken server, and the page says so instead of
        // reporting that the factory fell over.
        if (!r.ok) return json({ error: r.errOut || 'could not move it' }, r.code === 6 ? 409 : 500);
        broadcast();
        return json({ ok: true });
      }

      const done = url.pathname.match(/^\/api\/tickets\/(\d+)\/done$/);
      if (done && req.method === 'POST') {
        touch();
        const r = sh(TICKET, ['done', done[1]]);
        if (!r.ok) return json({ error: r.errOut || 'could not update' }, 500);
        broadcast();
        return json({ ok: true });
      }

      if (url.pathname === '/api/events' && req.method === 'GET') {
        // Deliberately does NOT touch(): an idle tab must not keep the server
        // alive forever. The client pings while visible instead.
        let send: (s: string) => void;
        const stream = new ReadableStream({
          start(c) {
            const enc = new TextEncoder();
            send = (s) => { try { c.enqueue(enc.encode(s)); } catch { sse.delete(send); } };
            sse.add(send);
            send(`event: hello\ndata: ok\n\n`);
          },
          cancel() { sse.delete(send); },
        });
        return new Response(stream, {
          headers: { 'content-type': 'text/event-stream', 'cache-control': 'no-cache', connection: 'keep-alive' },
        });
      }

      return new Response('not found', { status: 404 });
    },
  });

  function broadcast() { for (const fn of sse) fn(`event: changed\ndata: 1\n\n`); }

  // Watch the store and tell open tabs. Polling mtime is cheap and safe —
  // polling the db through the CLI every second would be 3 spawns/second.
  const dbPath = join(SMRITI_HOME, 'factory.db');
  let lastM = 0;
  const watcher = setInterval(() => {
    try {
      const m = statSync(dbPath).mtimeMs;
      if (m !== lastM) { lastM = m; broadcast(); }
    } catch {}
  }, 900);
  watcher.unref?.();

  const heartbeat = setInterval(() => { if (sse.size) for (const fn of sse) fn(': keep-alive\n\n'); }, 20000);
  heartbeat.unref?.();

  const reaper = setInterval(() => {
    if (Date.now() - last <= IDLE_MS) return;
    // Only tear down state that is still OURS. An orphan from a lost start
    // race used to delete the *live* server's portfile/pidfile/secret on its
    // way out, after which every `smriti` spawned yet another server and
    // `smriti board stop` could no longer find any of them.
    let ownsState = false;
    try { ownsState = parseInt(readFileSync(join(STATE_DIR, 'pidfile'), 'utf8').trim(), 10) === process.pid; } catch {}
    if (ownsState) { try { rmSync(STATE_DIR, { recursive: true, force: true }); } catch {} }
    process.exit(0);
  }, 5000);
  reaper.unref?.();

  // Claiming the pidfile must be ATOMIC, not check-then-write: two `smriti`
  // invocations at once both read an absent pidfile, both decide they won, and
  // both keep running — one of them orphaned forever. The 'wx' flag creates or
  // fails, which is the actual claim.
  const pidPath = join(STATE_DIR, 'pidfile');
  const claim = (): boolean => {
    try {
      writeFileSync(pidPath, `${process.pid}\n`, { mode: 0o600, flag: 'wx' });
      return true;
    } catch {
      return false;
    }
  };
  if (!claim()) {
    // Someone holds it. If they are alive, we lost and stand down; if the file
    // is a corpse from a hard kill, clear it and take the claim.
    let holder = 0;
    try { holder = parseInt(readFileSync(pidPath, 'utf8').trim(), 10); } catch {}
    if (holder && holder !== process.pid && pidAlive(holder)) {
      server.stop(true);
      process.exit(0);
    }
    try { rmSync(pidPath, { force: true }); } catch {}
    if (!claim()) { server.stop(true); process.exit(0); }
  }
  // pidfile claimed above; portfile last, because its presence means "ready".
  writeFileSync(join(STATE_DIR, 'secret'), secret + '\n', { mode: 0o600 });
  writeFileSync(join(STATE_DIR, 'portfile'), `${server.port}\n`, { mode: 0o600 });

  return await new Promise<never>(() => {});
}

// ─── CLI ─────────────────────────────────────────────────────────────────

function ensureServer(): { port: number; secret: string } {
  const existing = readState();
  if (existing && pidAlive(existing.pid)) return existing;
  if (existsSync(STATE_DIR)) rmSync(STATE_DIR, { recursive: true, force: true });
  mkdirSync(STATE_DIR, { recursive: true });

  const child = spawn(process.execPath, [SELF, '__server'], {
    detached: true,
    stdio: ['ignore', 'ignore', 'ignore'],
    env: process.env,
  });
  child.unref();

  const deadline = Date.now() + 6000;
  while (Date.now() < deadline) {
    const st = readState();
    if (st) return st;
    Bun.sleepSync(50);
  }
  try { child.kill(); } catch {}
  rmSync(STATE_DIR, { recursive: true, force: true });
  process.stderr.write('smriti-board: server did not start within 6s\n');
  process.exit(2);
}

async function main(): Promise<number> {
  const args = process.argv.slice(2);
  const cmd = args[0] || 'open';

  if (cmd === '__server') { await cmdServer(); return 0; }

  if (cmd === 'stop') {
    const st = readState();
    if (st && pidAlive(st.pid)) { try { process.kill(st.pid, 'SIGTERM'); } catch {} }
    rmSync(STATE_DIR, { recursive: true, force: true });
    process.stdout.write('stopped\n');
    return 0;
  }

  if (cmd === 'open' || cmd === '--url' || cmd === '-h' || cmd === '--help') {
    if (cmd === '-h' || cmd === '--help') {
      process.stderr.write(
        'Usage:\n  smriti board          open the board (starts the server if needed)\n' +
        '  smriti board --url    print the URL without opening a browser\n' +
        '  smriti board stop     stop the server\n' +
        'Exit codes: 0=ok 1=usage 2=runtime\n',
      );
      return 1;
    }
    const st = ensureServer();
    const url = `http://127.0.0.1:${st.port}/?k=${st.secret}`;
    process.stdout.write(url + '\n');
    if (cmd === 'open') openInBrowser(url);
    return 0;
  }

  err(`unknown command: ${cmd}`);
}

main().then((c) => process.exit(c)).catch((e) => {
  process.stderr.write(`smriti-board: ${String(e?.message ?? e)}\n`);
  process.exit(2);
});
