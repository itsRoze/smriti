#!/usr/bin/env bun
// smriti board — the factory's front door, served locally.
//
// Usage:
//   smriti board            start (or reuse) the server and open the browser
//   smriti board --url      print the URL without opening a browser
//   smriti board stop       stop the server
//
// Exit codes: 0=ok 1=usage 2=runtime
//
// A web page instead of the old raw-mode TUI, because the surface you live in
// daily needs typography, a palette, and the paper trail rendered in place —
// none of which a terminal can carry. The original objection ("a browser can't
// hand you an interactive terminal") is answered by THIS PROCESS: the server
// shells out to herdr to create the session, then shows the exact attach
// command rather than pretending it moved your focus.
//
// It holds NO SQL. All reads and writes go through the CLI verbs
// (smriti-ticket / smriti-trace), same as the TUI did. The one exception left
// is reading a repo's own PROJECT.md / DESIGN.md, off a two-name allowlist
// under a root the CLI supplies. Document bodies used to be a second exception
// — a file read driven by a client-supplied id — and are now stored in the
// factory and read through `ticket doc-show` like everything else.
//
// AUTH — this server cuts worktrees, spawns agents and reads files, so every
// route is authenticated:
//   - the CLI mints a secret (statedir, mode 0600) and opens /?k=<secret>
//   - that exchange sets an HttpOnly SameSite=Strict cookie; the page's own
//     fetches ride the cookie and never see the secret
//   - Host must be 127.0.0.1:<port> (kills DNS rebinding), and any Origin /
//     Sec-Fetch-Site present must be same-origin (kills cross-site CSRF)
//
// SINGLETON — state lives at $SMRITI_HOME/.server/factory/ (a fixed path, not
// a random session): portfile, pidfile, secret, log. Re-running `smriti`
// reuses a live server; a dead one is swept and restarted.

import { spawn, spawnSync } from 'node:child_process';
import { existsSync, mkdirSync, readFileSync, writeFileSync, rmSync, chmodSync, realpathSync, statSync } from 'node:fs';
import { dirname, join, sep } from 'node:path';
import { homedir } from 'node:os';
import { boardPage } from '../lib/board-ui.ts';
import { renderMarkdown } from '../lib/md.ts';

const SELF = realpathSync(process.argv[1]);
const SMRITI_BIN = dirname(SELF);
const TICKET = join(SMRITI_BIN, 'smriti-ticket');
const TRACE = join(SMRITI_BIN, 'smriti-trace');
const REPO = join(SMRITI_BIN, 'smriti-repo');
const PROJECT = join(SMRITI_BIN, 'smriti-project');
const HTML = join(SMRITI_BIN, 'smriti-html');
const PHOTO = join(SMRITI_BIN, 'smriti-photo');
const SMRITI_HOME = process.env.SMRITI_HOME || join(homedir(), '.smriti');
const STATE_DIR = join(SMRITI_HOME, '.server', 'factory');
const IDLE_MS = Number(process.env.SMRITI_BOARD_IDLE_MS || 45 * 60 * 1000);
// How often the close sweep looks. Ten seconds because nothing is waiting on
// it; the override exists so a test can watch a sweep decide without sitting
// through ten of them, the same way SMRITI_BOARD_IDLE_MS makes the reaper
// observable.
// Validated, unlike IDLE_MS where a NaN merely stops the reaper: setInterval
// clamps NaN to 1ms, which would turn this into a hot loop spawning herdr and
// smriti-config continuously.
const SWEEP_MS = (() => {
  const n = Number(process.env.SMRITI_BOARD_SWEEP_MS);
  return Number.isFinite(n) && n > 0 ? n : 10000;
})();
// Ceiling for /api/render. Descriptions are prose typed by one person; two
// orders of magnitude of headroom over the longest ticket in this backlog is
// plenty, and well under the 2 MB the document routes allow for whole files.
const MAX_RENDER_BYTES = 200_000;
// The photo ceiling, mirroring bin/smriti-photo's own. Checked here as well as
// there so an oversized upload is refused while it is still arriving, rather
// than after the whole of it has been held in memory and handed to a subprocess.
// Same env override, so raising it for a test raises it on both sides at once.
const MAX_PHOTO_BYTES = (() => {
  const n = Number(process.env.SMRITI_PHOTO_MAX_BYTES);
  return Number.isFinite(n) && n > 0 ? n : 10_485_760;
})();

function err(msg: string): never {
  process.stderr.write(`smriti-board: ${msg}\n`);
  process.exit(1);
}
function rand(n = 16): string {
  const b = new Uint8Array(n);
  crypto.getRandomValues(b);
  return [...b].map((x) => x.toString(16).padStart(2, '0')).join('');
}
function pidAlive(pid: number): boolean {
  try { process.kill(pid, 0); return true; } catch { return false; }
}
// Read a request body as text, refusing past `max` BYTES. Returns null when
// the body is over the cap — the caller turns that into a 413. Byte-counted
// rather than character-counted on purpose: one emoji is four bytes, so a
// character budget would admit several times the limit it advertises.
async function readCapped(req: Request, max: number): Promise<string | null> {
  if (!req.body) return '';
  const reader = req.body.getReader();
  const chunks: Uint8Array[] = [];
  let n = 0;
  for (;;) {
    const { done, value } = await reader.read();
    if (done) break;
    n += value.byteLength;
    if (n > max) { await reader.cancel(); return null; }
    chunks.push(value);
  }
  const buf = new Uint8Array(n);
  let at = 0;
  for (const c of chunks) { buf.set(c, at); at += c.byteLength; }
  return new TextDecoder().decode(buf);
}
// The same running budget, without the decode at the end — a photo is bytes and
// putting it through a TextDecoder would mangle it. null means the cap was
// crossed, and crossing it cancels the stream rather than reading the rest of
// what was sent.
async function readCappedBytes(req: Request, max: number): Promise<Uint8Array | null> {
  if (!req.body) return new Uint8Array(0);
  const reader = req.body.getReader();
  const chunks: Uint8Array[] = [];
  let n = 0;
  for (;;) {
    const { done, value } = await reader.read();
    if (done) break;
    n += value.byteLength;
    if (n > max) { await reader.cancel(); return null; }
    chunks.push(value);
  }
  const buf = new Uint8Array(n);
  let at = 0;
  for (const c of chunks) { buf.set(c, at); at += c.byteLength; }
  return buf;
}
// shOut, but feeding the child bytes on stdin. `smriti photo add` reads a photo
// that way precisely so this route never has to invent a spill directory of its
// own — the CLI owns the temp file, start to finish.
//
// Not `shIn` — that name is already taken further down by the herdr prompt
// feeder, which returns a bare boolean. Two function declarations with one name
// do not collide loudly; the later simply wins, and this route spent its first
// run reading `.errOut` off `false`.
async function shBytes(
  bin: string, args: string[], input: Uint8Array, timeoutMs = 15000,
): Promise<{ ok: boolean; out: string; errOut: string; code: number | null }> {
  const p = Bun.spawn([bin, ...args], { stdin: input, stdout: 'pipe', stderr: 'pipe' });
  const killer = setTimeout(() => p.kill(), timeoutMs);
  try {
    const [out, errOut] = await Promise.all([
      new Response(p.stdout).text(),
      new Response(p.stderr).text(),
    ]);
    const code = await p.exited;
    return { ok: code === 0, out: out.trim(), errOut: errOut.trim(), code };
  } catch {
    return { ok: false, out: '', errOut: '', code: null };
  } finally {
    clearTimeout(killer);
  }
}
function readState(): { port: number; pid: number; secret: string } | null {
  try {
    const port = parseInt(readFileSync(join(STATE_DIR, 'portfile'), 'utf8').trim(), 10);
    const pid = parseInt(readFileSync(join(STATE_DIR, 'pidfile'), 'utf8').trim(), 10);
    const secret = readFileSync(join(STATE_DIR, 'secret'), 'utf8').trim();
    if (!port || !pid || !secret) return null;
    return { port, pid, secret };
  } catch { return null; }
}
// `code` carries the CLI's own exit code through, because a few of them mean
// something specific enough that the page should react differently: a reorder
// refused for naming another group (6) is the user's mistake and deserves a
// 4xx, not the blanket 500 every other failure collapses to. null when the
// child was killed or never ran.
function sh(bin: string, args: string[], timeoutMs = 15000): { ok: boolean; out: string; errOut: string; code: number | null } {
  const r = spawnSync(bin, args, { encoding: 'utf8', timeout: timeoutMs });
  return { ok: r.status === 0, out: (r.stdout || '').trim(), errOut: (r.stderr || '').trim(), code: r.status };
}
// null means "the read failed", which is NOT the same as "there is nothing".
// Collapsing the two rendered a broken store as an inviting blank page.
function readJsonCmd<T>(args: string[], from = TICKET): T[] | null {
  const r = sh(from, args);
  if (!r.ok) return null;
  try { return JSON.parse(r.out || '[]') as T[]; } catch { return null; }
}
// Non-blocking reads. spawnSync freezes the single event loop for as long as
// the child runs — this file already says so about `shAsync` — and a trace read
// spawns sqlite3, so the timing routes must not use it: opening a ticket with
// twenty runs would otherwise stall SSE, /api/ping and every other tab.
// `errOut` is captured so a route can report WHY a CLI refused, the way the
// blocking `sh` above always could. Draining both pipes concurrently rather
// than in sequence: a child that fills the pipe we are not reading blocks on
// the write and never exits, and the kill timer would be the only thing ending
// it.
async function shOut(
  bin: string, args: string[], timeoutMs = 15000,
): Promise<{ ok: boolean; out: string; errOut: string }> {
  const p = Bun.spawn([bin, ...args], { stdout: 'pipe', stderr: 'pipe' });
  const killer = setTimeout(() => p.kill(), timeoutMs);
  try {
    const [out, errOut] = await Promise.all([
      new Response(p.stdout).text(),
      new Response(p.stderr).text(),
    ]);
    return { ok: (await p.exited) === 0, out: out.trim(), errOut: errOut.trim() };
  } catch {
    return { ok: false, out: '', errOut: '' };
  } finally {
    clearTimeout(killer);
  }
}
// null still means "the read failed", never "there is nothing".
async function readJsonAsync<T>(args: string[], from = TICKET): Promise<T | null> {
  const r = await shOut(from, args);
  if (!r.ok) return null;
  try { return JSON.parse(r.out || 'null') as T; } catch { return null; }
}
function openInBrowser(url: string): void {
  const opener = process.platform === 'darwin' ? 'open' : process.platform === 'win32' ? 'start' : 'xdg-open';
  spawnSync(opener, [url], { stdio: 'ignore' });
}

// ─── session launcher: herdr → a command you can paste ───────────────────
// herdr is the session backend. It knows a pane holds Claude Code, creates
// worktree workspaces natively, and confirms the agent is actually up before
// returning — none of which a plain multiplexer can do.
//
// There is deliberately no second multiplexer to fall back to: maintaining two
// was the thing being removed, and a silent fallback is worse than an honest
// one. herdr is pre-1.0 with observed CLI churn, so every call is still
// defensive — any failure lands on the printed command, which always works.
// The board never fails a start because the backend did.

type Launch = {
  method: 'herdr' | 'manual';
  attach: string;
  existing?: boolean;
  agentStatus?: string;
  prompting?: boolean;
};

type Session = { name: string; status: string; cwd: string; pane: string };

// Only what this file touches — the payload is passed through to the page
// verbatim, and smriti-trace owns its shape.
type Run = { run_uid: string; status: string; html_session?: string | null; html_url?: string };

// The live review page for a run parked at a gate, or nothing.
//
// Resolved on every read rather than stored, because the port dies with the
// server and a link built from a remembered port is a link to nothing. Only
// `awaiting` runs are asked about — that is the only state where a gate can be
// open — so this is bounded to the handful of rows in "waiting on you", and is
// almost always zero.
//
// The answer is treated as DATA, not gospel: only a plausible numeric port is
// accepted, and the URL is synthesized here rather than taken from the JSON.
// Memoized, because /api/state is not a once-a-minute route: the db-mtime
// watcher broadcasts a change roughly every second while a run is writing, and
// each one drives a refresh. Without this, a gated run means booting a whole
// bun process per second just to ask whether a port is answering. A gate that
// opens or closes within the window is a second late to the board and no more.
const htmlUrlCache = new Map<string, { url: string | null; at: number }>();
const HTML_URL_TTL_MS = 3000;

async function resolveHtmlUrls(runs: Run[]): Promise<void> {
  const gated = runs.filter((r) => r.status === 'awaiting' && r.html_session);
  if (!gated.length) { htmlUrlCache.clear(); return; }
  const now = Date.now();
  // Bounded by the live gates; a session that stops being one is not kept.
  for (const [k, v] of htmlUrlCache) {
    if (now - v.at > HTML_URL_TTL_MS || !gated.some((r) => r.html_session === k)) htmlUrlCache.delete(k);
  }
  await Promise.all(gated.map(async (r) => {
    const key = String(r.html_session);
    const hit = htmlUrlCache.get(key);
    if (hit) { if (hit.url) r.html_url = hit.url; return; }
    const out = await readJsonAsync<{ port?: unknown }>(['url', '--session', key], HTML);
    const port = Number(out?.port);
    const url = Number.isInteger(port) && port > 0 && port < 65536 ? `http://127.0.0.1:${port}/` : null;
    htmlUrlCache.set(key, { url, at: now });
    if (url) r.html_url = url;
  }));
}

// Every herdr agent, so the board can show what a session is actually doing.
// This is the only source that knows a Claude session is blocked on input —
// smriti's trace only sees /begin's own gates.
//
// Deliberately NOT filtered on `name`: herdr drops the assigned name (an agent
// started as `t3` was later listed with no name at all, so `agent read t3`
// answered agent_not_found). Filtering on it made live sessions vanish from the
// board — no blocked indicator, and start offered again on work already running.
// `cwd` is the identifier herdr does not lose, and it equals worktree_path.
//
// A row is kept if it can be identified AT ALL. `pane` counts: once a ticket has
// shipped, `smriti clean` has deleted the directory the session is sitting in,
// so a nameless agent reporting an empty cwd is exactly the session the close
// sweep exists to find — and dropping it here would have made the pane fallback
// permanently unreachable.
// Returns null when the output could not be decoded at all, which is NOT the
// same fact as "herdr listed no agents". The reconcile pass ends runs whose
// stamped pane is absent from this list, and an empty array is exactly the state
// where every stamped run is provably dead — so collapsing a parse failure into
// one would reap the whole board on a single bad tick. Everything that only
// needs a best-effort list keeps using parseAgents() below.
function parseAgentsOrNull(out: string): Session[] | null {
  try {
    const agents = JSON.parse(out)?.result?.agents;
    if (!Array.isArray(agents)) return null;
    return agents
      .map((a: { name?: string; agent_status?: string; status?: string; cwd?: string; pane_id?: string }) => ({
        name: a?.name ?? '',
        status: a?.agent_status ?? a?.status ?? 'unknown',
        cwd: a?.cwd ?? '',
        pane: a?.pane_id ?? '',
      }))
      .filter((s: Session) => s.name || s.cwd || s.pane);
  } catch { return null; }
}

function parseAgents(out: string): Session[] {
  return parseAgentsOrNull(out) ?? [];
}

function herdrSessions(): Session[] {
  return herdrSessionsSync() ?? [];
}

// The synchronous tri-state, for /api/state. Same distinction the reconcile
// pass needs, and the page needs it for the same reason: it decides whether a
// ticket reads as running by looking for a live session, so "herdr said
// nothing is running" and "we never got to ask" must not arrive as the same
// empty array. On a machine with no herdr at all, the second is permanent —
// and treating it as the first would mean no run ever reads as running again.
function herdrSessionsSync(): Session[] | null {
  if (!Bun.which('herdr')) return null;
  const r = sh('herdr', ['agent', 'list'], 8000);
  return r.ok ? parseAgentsOrNull(r.out) : null;
}

// Is there already a session for this ticket? Without this check, starting an
// already-in-progress ticket tried to spawn a SECOND agent under the same name —
// the launch failed and the board fell back to a paste command, telling you to
// run claude by hand for a session that was already open.
//
// Matched on the worktree path, and ONLY on it. This used to also match herdr's
// agent name (`t<id>`), which is machine-global: a `t7` belonging to some other
// checkout answered for this ticket's, and that is how a test fixture came to
// adopt a live session during ticket 3. Every caller passes `dir`, so a
// name-only hit is by definition a session in a DIFFERENT directory — never the
// one being looked for. It was never a fallback, either: the old predicate was
// one `.find()` with an OR, so whichever session herdr happened to list first
// won, and a name match could beat the cwd match the comment claimed to prefer.
type AgentHit = { found: boolean; status?: string; name?: string; pane?: string };
const matchAgent = (sessions: Session[], dir: string): AgentHit => {
  const hit = dir ? sessions.find((s) => s.cwd === dir) : undefined;
  return hit ? { found: true, status: hit.status, name: hit.name, pane: hit.pane } : { found: false };
};
// `dir` is required rather than optional now that it is the ONLY thing matched
// on: an absent one used to mean "match by name instead", and left behind it
// would silently mean "no session exists" for every caller that failed to
// resolve a worktree.
function existingAgent(dir: string): AgentHit {
  return matchAgent(herdrSessions(), dir);
}
// The non-blocking twin, for request paths. spawnSync inside a route freezes
// every other request, which this file says twice about other calls and is
// no less true of `herdr agent list`.
async function existingAgentAsync(dir: string): Promise<AgentHit> {
  return matchAgent(await herdrSessionsAsync(), dir);
}

// Default is `bypass` (--dangerously-skip-permissions), because the whole point
// of starting work from the board is walking away from it: a session that stops
// to ask is a session that sits there until you notice. The board surfaces a
// blocked agent now, so a stall is visible rather than silent — but not stalling
// is better than being told about it.
//
// Opt out per machine when you want claude to ask the way it would if you
// launched it yourself:
//   smriti config set board_permissions ask
function permissionMode(): 'ask' | 'bypass' {
  const r = sh(join(SMRITI_BIN, 'smriti-config'), ['get', 'board_permissions'], 5000);
  return r.out.trim() === 'ask' ? 'ask' : 'bypass';
}

// Non-blocking spawn. The whole board runs on one event loop, so the spawnSync
// used everywhere else would freeze every other request — including the polling
// that draws the board — for as long as it waits. Prompt delivery waits on a
// human-scale UI, so it has to stay off the loop.
async function shAsync(bin: string, args: string[], timeoutMs: number): Promise<boolean> {
  const p = Bun.spawn([bin, ...args], { stdout: 'ignore', stderr: 'ignore' });
  const killer = setTimeout(() => p.kill(), timeoutMs);
  try { return (await p.exited) === 0; } finally { clearTimeout(killer); }
}

// Same, but the child reads a body on stdin. `smriti trace report` takes the
// text that way because a captured summary is multi-line and shell-quoting one
// is a bug waiting to happen.
async function shIn(bin: string, args: string[], input: string, timeoutMs: number): Promise<boolean> {
  const p = Bun.spawn([bin, ...args], { stdin: 'pipe', stdout: 'ignore', stderr: 'ignore' });
  const killer = setTimeout(() => p.kill(), timeoutMs);
  try {
    p.stdin.write(input);
    await p.stdin.end();
    return (await p.exited) === 0;
  } catch {
    return false;
  } finally { clearTimeout(killer); }
}

// Non-blocking twin of herdrSessions(), for the close sweep. The sync one runs
// on every /api/state and must stay synchronous there; a timer has no excuse to
// freeze the loop. They share the decode below rather than carrying two copies
// of it — the first draft duplicated it and the two filters had already drifted.
async function herdrSessionsAsync(): Promise<Session[]> {
  return (await herdrSessionsRead()) ?? [];
}

// The tri-state read: Session[] means herdr answered and this IS the live set
// (empty included); null means we did not get an answer and know nothing. Only
// the reconcile pass needs the distinction — see parseAgentsOrNull.
async function herdrSessionsRead(): Promise<Session[] | null> {
  if (!Bun.which('herdr')) return null;
  const r = await shOut('herdr', ['agent', 'list'], 8000);
  return r.ok ? parseAgentsOrNull(r.out) : null;
}

// Type the prompt into the session, the way you would.
//
// `herdr agent prompt` is the documented way to do this and it does not work
// against Claude Code — it answers agent_prompt_stalled even with the agent
// sitting at idle. Sending the keystrokes does work, but only once Claude is
// actually able to receive them, and two things stand in the way:
//
//   1. Every ticket worktree is a directory Claude has never been run in, so it
//      opens on "Is this a project you trust?" and reads nothing else until that
//      is answered. There is no flag to pre-accept it (--print skips the dialog,
//      but that is not an interactive session), and the trust record lives in
//      claude's own ~/.claude.json, which is not ours to rewrite underneath a
//      running process.
//   2. agent_status reaches `idle` several seconds before the input box exists.
//      The placeholder is the honest signal that a keystroke will land.
//
// Typing before either was settled is what "the session opened but /begin never
// ran" was: the text went nowhere, and the session sat on the welcome screen
// improvising until someone attached to it.
async function deliverPrompt(pane: string, prompt: string): Promise<boolean> {
  // A miss here is the normal case for a worktree you have already opened once,
  // so this is a bounded look, not a requirement.
  if (await shAsync('herdr', ['pane', 'wait-output', pane, '--match', 'trust', '--timeout', '15000'], 20000)) {
    await shAsync('herdr', ['pane', 'send-keys', pane, 'Enter'], 5000);
  }
  if (!await shAsync('herdr', ['pane', 'wait-output', pane, '--regex', 'Try "', '--timeout', '60000'], 65000)) {
    return false; // never became ready — leave the session alone rather than typing into it blind
  }
  await Bun.sleep(1500);
  if (!await shAsync('herdr', ['pane', 'send-text', pane, prompt], 10000)) return false;
  await Bun.sleep(500);
  return shAsync('herdr', ['pane', 'send-keys', pane, 'Enter'], 10000);
}

// ─── closing a session once its ticket has shipped ──────────────────────────
//
// Shipping leaves the herdr pane open in a worktree `smriti clean` has already
// deleted. `clean` cannot be the one to close it: it almost always runs INSIDE
// the session being closed, and closing a pane mid-command kills the process
// running the command, so the tidy may not finish and its exit status is lost.
// The board is a separate long-lived process that already polls this state, so
// it is the safe actor.
//
// Nothing is closed that has not first been captured. `smriti trace report`
// normally stores the run's own closing summary and that is the licence to
// close. When a run left none — it died before Gate 3, or the session was never
// /begin — the pane is scraped first and recorded as a scrape, never passed off
// as the run's own words.
//
// The scrape is ONE VIEWPORT and cannot be more. Claude Code draws on the
// terminal's alternate screen, and herdr cannot recover rows that have left it:
// `pane read --lines 2000` returns exactly what `--lines 55` does, silently.
// That limit is the whole reason the run writes its own report rather than
// being photographed.
// `path` is load-bearing, not decoration: a path-only artifact counts as a
// capture, so leaving it off the type made the rule invisible to every reader
// and to tsc, which had nothing to check the `a.path` branch against.
type ArtifactRow = {
  run_uid: string; kind: string; source?: string; status?: string | null;
  body?: string | null; path?: string | null;
};
type RunRow = {
  run_uid: string; ticket_id?: number | null; status?: string;
  herdr_pane?: string | null; html_session?: string | null;
};
type ShipTicket = { id: number; status: string; worktree_path?: string | null };

async function closeOnShipEnabled(): Promise<boolean> {
  // Unset means on, matching how the ticket asked for it: default on, with a
  // key to opt out. Only an explicit `false` disables it.
  const r = await shOut(join(SMRITI_BIN, 'smriti-config'), ['get', 'close_session_on_ship'], 5000);
  return r.out.trim() !== 'false';
}

// Panes we have already tried and failed to capture, so a pane that cannot be
// read is attempted once rather than every ten seconds forever. Process-scoped
// on purpose: a board restart is a fair moment to try again.
const closeGaveUp = new Set<string>();
let sweeping = false;

// Tickets whose session is mid-change. Restart closes a pane and then starts a
// replacement, and between those two the ticket has no live session at all —
// so a second restart, or a `start` arriving in the gap, would launch against a
// pane the first one is still working on. It was a narrow race while restart
// was synchronous end to end; capturing first makes it slower and reachable.
//
// Now shared by everything that closes a pane or ends a run — restart, stop,
// the ship sweep and the reconcile pass. Four paths reaching captureThenClose()
// with only `sweeping` (which guards the sweep against itself) and this set
// (which guarded only restart) between them was a real race on the same pane.
const sessionBusy = new Set<number>();

// Run the body with this ticket claimed, or skip it entirely if something else
// already holds it. Returns undefined when it did not run — a caller that needs
// to tell "skipped" from "ran and produced nothing" gets it from that.
async function withSession<T>(id: number, body: () => Promise<T>): Promise<T | undefined> {
  if (sessionBusy.has(id)) return undefined;
  sessionBusy.add(id);
  try { return await body(); } finally { sessionBusy.delete(id); }
}

// Which of a ticket's runs is the one sitting in this pane.
//
// The stamped pane wins outright. Failing that, the newest run that is not
// stamped with SOME OTHER pane — which is the honest reading of an unstamped
// run: `runs.herdr_pane` only arrived in schema v4 and `trace start` fills it
// from $HERDR_PANE_ID, so a run from before that, or one started outside a
// herdr pane, has nothing to match on and would otherwise be invisible here.
//
// Both halves matter, and a caller may not have one without the other. Taking
// only the exact match loses every unstamped run, and on the restart path
// "no run" means the pane is closed having been read into nothing — the exact
// loss this whole feature exists to prevent. Taking the newest run
// unconditionally, which is what the sweep used to do alone, can file one
// pane's terminal under a run that demonstrably belongs to a different pane. A
// run carrying another pane's id is the one candidate that is never right.
async function runForPane(ticketId: number, pane: string): Promise<RunRow | undefined> {
  // Newest-first, so the first survivor of either filter is the newest one.
  const forTicket = (await readJsonAsync<RunRow[]>(['list', '--ticket', String(ticketId), '--json'], TRACE)) ?? [];
  return forTicket.find((r) => r.herdr_pane === pane)
    ?? forTicket.find((r) => !r.herdr_pane);
}

// Half of the invariant: get the run's closing text stored, by whatever means.
// Separate from the close so the sweep's opt-out can take this without the
// other — see its call site for why capture is unconditional and only closing
// is optional.
//
// A run we have no row for cannot be captured into anything. That is not a
// failure to report: a session restarted before /begin ever called `trace start`
// has printed a few seconds of boot and nothing worth keeping.
async function capturePaneReport(pane: string, run: RunRow | undefined): Promise<boolean> {
  if (!run) return false;

  const arts = (await readJsonAsync<ArtifactRow[]>(
    ['artifacts', '--run', run.run_uid, '--kind', 'report', '--json'], TRACE)) ?? [];
  // A row is not a capture — a row with something in it is. `trace report`
  // refuses to store an empty body, but a `path`-only artifact is legitimate
  // and older rows predate that rule.
  if (arts.some((a) => (a.body && a.body.trim()) || a.path)) return true;

  const read = await shOut('herdr',
    ['pane', 'read', pane, '--source', 'recent-unwrapped', '--lines', '200', '--format', 'text'], 10000);
  const text = read.ok ? read.out.trim() : '';
  if (!text) return false;

  // `--source pane` will decline rather than overwrite if the run wrote its own
  // report in the moments since the read above.
  return shIn(TRACE, ['report', '--run', run.run_uid, '--source', 'pane'], text + '\n', 10000);
}

// The invariant, in the one place panes are closed: nothing is closed that has
// not first been captured.
//
// `closeWhenUncaptured` is the only thing the two callers disagree about, and
// the disagreement is deliberate rather than an oversight:
//
//   - The SWEEP passes false. It is a timer nobody asked for, so when it cannot
//     capture it must not destroy — it leaves the pane open and yours to deal
//     with. Losing the only copy of what a run said is the bug this exists to
//     prevent.
//   - RESTART passes true. You asked for the session to be replaced, and
//     refusing would leave you holding the broken session you were trying to be
//     rid of. Leaving the old pane open and starting beside it is not an option:
//     launchSession reopens the same worktree pane, finds the old claude still
//     in it, and `agent start` is refused as agent_pane_busy until the retry
//     loop degrades to a pasted command.
//
// The window where those differ is narrower than it reads. A pane that is
// already gone fails the read and no-ops the close, so nothing is lost; a wedged
// herdr fails both.
//
// Session state is the CALLER'S precondition and is not policed here. The sweep
// only ever calls this for `idle`/`done`; restart calls it for whatever is
// there, usually `working`. Reads are not refused while an agent works —
// verified against a live `working` agent on all four --source modes — so a
// working pane captures its viewport the same way an idle one does.
async function captureThenClose(
  pane: string,
  run: RunRow | undefined,
  opts: { closeWhenUncaptured: boolean },
): Promise<{ captured: boolean; closed: boolean }> {
  const captured = await capturePaneReport(pane, run);

  if (!captured && !opts.closeWhenUncaptured) return { captured: false, closed: false };

  // herdr 0.8 has no `agent stop`; closing the pane is what ends a session.
  if (!await shAsync('herdr', ['pane', 'close', pane], 10000)) return { captured, closed: false };

  // A run whose pane we just closed never reached its own `trace end`, and the
  // process that would have called it has just been killed — so without this it
  // stays `running` forever, ticking a live duration on the board for a session
  // that no longer exists, with that time booked against you. Only when still
  // open: `trace end` rewrites ended_at unconditionally, so re-ending a finished
  // run would silently restate how long it took.
  //
  // `failed` rather than `done` because it did not finish — the sweep got here
  // by scraping a run that died before Gate 3, and restart got here because you
  // discarded one. `done` would be a lie in both cases, and they are the only
  // two honest terminal statuses there are.
  if (run && (run.status === 'running' || run.status === 'awaiting')) {
    await shAsync(TRACE, ['end', '--run', run.run_uid, '--status', 'failed'], 5000);
  }

  return { captured, closed: true };
}

// Runs that say they are alive, when nothing is.
//
// The inverse of sweepShippedSessions below, and it exists because that sweep
// cannot reach this case at all: it walks LIVE herdr agents, so a run whose pane
// already died is never visited, and its candidate filter is hardcoded to
// shipped, so a cancelled ticket is never even a candidate. Between them, four
// finished tickets sat in "waiting on you" for days with their counters still
// climbing, and every minute was booked against your time.
//
// This walks the open runs instead — `trace list --active`, a handful of rows,
// which is why the cost objection that shaped the sweep's direction (see its
// comment on `done` only ever growing) does not apply here.
//
// A run is ended ONLY on proof. Three, each independently sufficient:
//
//   1. its ticket is shipped or cancelled — the work is over, whoever ended it;
//   2. its ticket's worktree is gone from disk — nothing runs in a directory
//      that does not exist;
//   3. it recorded a herdr pane at start and a SUCCESSFUL read no longer lists
//      that pane.
//
// Rule 3 is why herdrSessionsRead is tri-state. A failed read and an empty one
// are different facts and only one of them is evidence: `null` disables this
// rule for the tick, while a genuine empty list is exactly the state in which
// every stamped run is dead. Rule 3 also applies only to runs that RECORDED a
// pane — a /begin started in a plain terminal has none, so it can never be
// reaped by liveness, only by rules 1 and 2, which hold however it was launched.
//
// Nothing here closes a pane; a run whose pane is somehow still alive is left to
// the sweep, which captures it first.
async function reconcileOpenRuns(agents: Session[] | null, tickets: ShipTicket[]): Promise<void> {
  const runs = await readJsonAsync<RunRow[]>(['list', '--active', '--json'], TRACE);
  if (!runs?.length) return;
  const byId = new Map(tickets.map((t) => [t.id, t]));
  const livePanes = agents ? new Set(agents.map((s) => s.pane).filter(Boolean)) : null;

  for (const run of runs) {
    const t = run.ticket_id != null ? byId.get(run.ticket_id) : undefined;

    // Proof of LIFE outranks every proof of death below, and this is not just
    // caution — it is a handover. A run whose pane is still up belongs to the
    // sweep, which reads the pane before closing it and records the run as
    // `failed` because it did not finish. Ending it from here first would
    // preempt that with a coarser word, for no gain: the ticket has shipped
    // either way, and the sweep reaches this case perfectly well.
    //
    // Matched on the stamped pane or on the ticket's worktree, the same two
    // handles the sweep uses. A null read proves nothing either way, so rules 1
    // and 2 — which never needed herdr — still stand on their own.
    const alive = !!agents && (
      (!!run.herdr_pane && !!livePanes?.has(run.herdr_pane)) ||
      (!!t?.worktree_path && agents.some((s) => s.cwd === t.worktree_path))
    );
    if (alive) continue;

    // `failed` for all four, including a ticket that shipped, and that is not
    // pessimism — it is what being OPEN at this moment means. Only runs still
    // `running`/`awaiting` reach here, and a run that finished properly already
    // ended itself as `done`. So everything this pass catches is by definition a
    // run that never reached its own ending, whatever became of the ticket.
    //
    // The same reading captureThenClose applies to a pane it had to close, and
    // the same one smriti-ticket applies on a terminal status. Three places
    // decide this; they must not disagree about the word.
    const doomed = !!t && (t.status === 'shipped' || t.status === 'cancelled')
      || !!t?.worktree_path && !existsSync(t.worktree_path)
      || !!run.herdr_pane && !!livePanes && !livePanes.has(run.herdr_pane);
    if (!doomed) continue;
    const status = 'failed';

    // Claimed while ending, so this cannot race the sweep or a restart working
    // the same ticket. A run with no ticket has nothing to contend over.
    const end = () => shAsync(TRACE, ['end', '--run', run.run_uid, '--status', status], 5000);
    if (run.ticket_id != null) await withSession(run.ticket_id, end);
    else await end();
  }
}

async function sweepShippedSessions(): Promise<void> {
  // A slow herdr must not let sweeps stack on top of each other.
  if (sweeping) return;
  sweeping = true;
  try {
    // The same ownership rule the reaper uses. This is the board's only timer
    // that reaches outside its own process — the watcher and heartbeat merely
    // read — so a stale server that lost the pidfile race must not be closing
    // panes belonging to the live one.
    let ownsState = false;
    try { ownsState = parseInt(readFileSync(join(STATE_DIR, 'pidfile'), 'utf8').trim(), 10) === process.pid; } catch {}
    if (!ownsState) return;

    // ONE herdr read serves both passes. Taking a second would not just cost a
    // spawn — the two passes would be reasoning about different moments, and
    // the reconcile could end a run for a pane the sweep is at that instant
    // capturing.
    const agents = await herdrSessionsRead();

    // ONE ticket read too, for the same reason as the herdr read above: taking
    // a second would not merely cost a spawn, it would have the two passes
    // reasoning about two different moments of the same table.
    const tickets = await readJsonAsync<ShipTicket[]>(['list', '--all', '--json']);
    if (!tickets) return;

    // Runs first, and unconditionally: this is the pass that reaches a run whose
    // pane is already gone, which is precisely the case the sweep below cannot
    // see. It tolerates a null read by skipping only the liveness rule.
    await reconcileOpenRuns(agents, tickets);

    if (!agents?.length) return;
    // Finished, and the worktree actually gone. Both, because a finished ticket
    // whose worktree is still there is a session someone may still be using.
    //
    // `cancelled` counts as finished here. It did not used to, which left the
    // mirror of the bug this sweep exists for: a session abandoned along with
    // its ticket kept running in a directory nobody would return to, and no
    // route on the board could reach it.
    const done = tickets.filter((t) =>
      (t.status === 'shipped' || t.status === 'cancelled') &&
      t.worktree_path && !existsSync(t.worktree_path));
    if (!done.length) return;

    // Driven by AGENTS, not by shipped tickets. `done` only ever grows — every
    // ticket ever shipped stays in it — so looking runs up per shipped ticket
    // meant a sweep whose cost climbed forever while `agents` held nought or
    // one. Live sessions are the small set, and the common case (a cwd match)
    // needs no run lookup at all.
    let allRuns: RunRow[] | null = null;
    const runsForPane = async (pane: string): Promise<RunRow | undefined> => {
      // One read per sweep, and only when a cwd match has already failed.
      allRuns ??= (await readJsonAsync<RunRow[]>(['list', '--limit', '500', '--json'], TRACE)) ?? [];
      return allRuns.find((r) => r.herdr_pane && r.herdr_pane === pane);
    };

    // Once per sweep, not once per session: it is a process-wide setting and
    // nothing in the loop below can change it.
    const mayClose = await closeOnShipEnabled();

    for (const sess of agents) {
      if (!sess.pane || closeGaveUp.has(sess.pane)) continue;

      // `done` is not a lesser `idle` — it IS idle, for work that finished while
      // nobody was looking at the tab, which is precisely this ticket's case.
      // `unknown` explicitly does not prove completion, and `blocked` is a
      // session sitting at a question.
      if (sess.status !== 'idle' && sess.status !== 'done') continue;

      // cwd first: it is the identifier herdr does not lose, and it equals
      // worktree_path. The stamped pane is the fallback for the case this
      // feature exists in — the directory is gone, so cwd may be gone with it.
      //
      // The fallback is deliberately NOT used for an agent sitting in some other
      // directory. herdr does not reuse a closed pane's id, but a pane that is
      // still open can be running something else entirely by now, and closing
      // that would destroy a live session and file its terminal under a ticket
      // it has nothing to do with. No cwd, or this ticket's cwd, or leave it be.
      let t = done.find((x) => sess.cwd && x.worktree_path === sess.cwd);
      let run: RunRow | undefined;
      if (!t) {
        if (sess.cwd) continue;
        run = await runsForPane(sess.pane);
        if (!run?.ticket_id) continue;
        t = done.find((x) => x.id === run!.ticket_id);
        if (!t) continue;
      }

      // Which run owns this pane. A ticket can have several — the board's own
      // restart action closes one session and starts another on the same
      // worktree — so an older run's report must not license closing a newer
      // session. Shared with restart, which needs the identical answer.
      run ??= await runForPane(t.id, sess.pane);
      if (!run) continue;

      // Capture is unconditional and only the closing is optional. Opting out
      // means you want the panes kept, not that you want the record given up —
      // and a pane you close by hand later must not take the summary with it.
      // So the opt-out takes capturePaneReport alone rather than skipping the
      // whole step.
      if (!mayClose) {
        if (!await capturePaneReport(sess.pane, run)) closeGaveUp.add(sess.pane);
        continue;
      }

      // false: an uncapturable pane stays open and visible, because losing the
      // only copy of what the run said is the bug this exists to prevent. See
      // the helper for why restart is allowed the opposite.
      //
      // Claimed for the duration, so a restart or a stop cannot be working the
      // same pane. Skipped entirely (undefined) means one of them already is —
      // and that path closes the pane itself, so there is nothing left to do and
      // nothing to give up on.
      const res = await withSession(t.id, () =>
        captureThenClose(sess.pane, run!, { closeWhenUncaptured: false }));
      if (!res) continue;

      // Whether the read failed or the close did, this pane is not worth
      // retrying every ten seconds for the life of the process.
      if (!res.captured || !res.closed) closeGaveUp.add(sess.pane);
    }
  } catch {
    // A sweep is housekeeping. It must never be able to take the board down.
  } finally {
    sweeping = false;
  }
}

function launchSession(dir: string, ticketId: number, force = false): Launch {
  const prompt = `/begin ticket:${ticketId}`;
  const name = `t${ticketId}`;
  // Flags only. These are appended to the executable that --kind claude already
  // chose, so naming `claude` again ran `claude claude …` and the prompt was
  // swallowed as an argument to nothing.
  const claudeFlags = permissionMode() === 'bypass' ? ['--dangerously-skip-permissions'] : [];

  // Already running (or already run) — hand back the way in rather than
  // starting a duplicate.
  const prior = force ? { found: false as const } : existingAgent(dir);
  if (prior.found) {
    const target = prior.name || name;
    return { method: 'herdr', attach: `herdr agent attach ${target}`, existing: true, agentStatus: prior.status };
  }
  // Single-quoted with any ' doubled: repo paths with spaces are a supported
  // case elsewhere in this repo, and an unquoted cd silently lands you in the
  // wrong directory rather than failing loudly.
  const q = (v: string) => `'${v.replace(/'/g, `'\\''`)}'`;
  const manual = {
    method: 'manual' as const,
    attach: `cd ${q(dir)} && ${['claude', ...claudeFlags, prompt].map(q).join(' ')}`,
  };

  if (Bun.which('herdr')) {
    try {
      // Verified against herdr 0.8.0, which differs from its docs in three
      // ways — each one silently turned every start into a pasted command:
      //   - there is no --json flag; output is JSON already (--json is an error)
      //   - `worktree open` needs --cwd to name the SOURCE repo when no
      //     workspace is active, not just --path
      //   - the pane id is result.root_pane.pane_id, an object not a string
      const repoRoot = sh('git', ['-C', dir, 'worktree', 'list', '--porcelain'], 5000)
        .out.split('\n').find((l) => l.startsWith('worktree '))?.slice(9) ?? dir;

      const ws = sh('herdr', ['worktree', 'open', '--cwd', repoRoot, '--path', dir], 20000);
      let pane = '';
      if (ws.ok) {
        try { pane = JSON.parse(ws.out)?.result?.root_pane?.pane_id ?? ''; } catch {}
      }

      if (pane) {
        // A freshly-opened pane is not yet at a shell prompt, and `agent start`
        // rejects it as agent_pane_busy. Retry briefly rather than giving up —
        // in testing this succeeded on the second attempt, a second later.
        for (let i = 0; i < 8; i++) {
          const args = ['agent', 'start', name, '--kind', 'claude', '--pane', pane];
          if (claudeFlags.length) args.push('--', ...claudeFlags);
          const st = sh('herdr', args, 45000);
          if (st.ok && !/"error"/.test(st.out)) {
            // Deliberately not awaited: the answer to "did the session start" is
            // already known, and typing the prompt takes as long as claude takes
            // to boot. The board watches agent status for the rest.
            void deliverPrompt(pane, prompt);
            return { method: 'herdr', attach: `herdr agent attach ${name}`, prompting: true };
          }
          if (!/agent_pane_busy/.test(st.out + st.errOut)) break; // a real failure
          Bun.sleepSync(1000);
        }
      }
    } catch {}
  }

  return manual;
}

// ─── the server process ──────────────────────────────────────────────────

async function cmdServer(): Promise<never> {
  mkdirSync(STATE_DIR, { recursive: true });
  chmodSync(STATE_DIR, 0o700);
  const secret = rand(16);

  const cookies = new Set<string>();
  let last = Date.now();
  const touch = () => { last = Date.now(); };
  const sse = new Set<(s: string) => void>();

  const json = (data: unknown, status = 200, headers: Record<string, string> = {}) =>
    new Response(JSON.stringify(data), { status, headers: { 'content-type': 'application/json', ...headers } });

  const server = Bun.serve({
    hostname: '127.0.0.1',
    port: 0,
    idleTimeout: 120,
    async fetch(req) {
      const url = new URL(req.url);

      // Host check first: a DNS-rebinding page reaches us with its own Host.
      if (req.headers.get('host') !== `127.0.0.1:${server.port}`) {
        return new Response('forbidden', { status: 403 });
      }
      // Cross-site checks: browsers send these; same-origin fetches pass.
      const origin = req.headers.get('origin');
      if (origin && origin !== `http://127.0.0.1:${server.port}`) {
        return new Response('forbidden', { status: 403 });
      }
      const sfs = req.headers.get('sec-fetch-site');
      if (sfs && sfs !== 'same-origin' && sfs !== 'none') {
        return new Response('forbidden', { status: 403 });
      }

      const cookie = (req.headers.get('cookie') || '').match(/smriti_board=([a-f0-9]+)/)?.[1];
      const authed = Boolean(cookie && cookies.has(cookie));

      // The bootstrap exchange: secret → cookie. The only route that works
      // without a cookie.
      if (url.pathname === '/' && req.method === 'GET') {
        const k = url.searchParams.get('k');
        if (k && k === secret) {
          touch();
          const token = rand(16);
          cookies.add(token);
          return new Response(null, {
            status: 302,
            headers: {
              location: '/',
              'set-cookie': `smriti_board=${token}; HttpOnly; SameSite=Strict; Path=/`,
            },
          });
        }
        if (authed) { touch(); return new Response(boardPage(), { headers: { 'content-type': 'text/html; charset=utf-8' } }); }
        return new Response('smriti board: not authorized — run `smriti` to open the board', { status: 403 });
      }

      if (!authed) return new Response('forbidden', { status: 403 });

      if (url.pathname === '/api/ping') { touch(); return json({ ok: true }); }

      if (url.pathname === '/api/state' && req.method === 'GET') {
        touch();
        const tickets = readJsonCmd(['list', '--all', '--json']);
        // TWO reads, not one. Finished runs are needed so a card can say "took
        // 18m", and a recency window is the right shape for that — but bounding
        // the list on recency alone silently dropped an OLD run parked at a
        // gate, and "waiting on you" showing an empty forest while a gate is
        // actually blocking is the one failure this board must never have. The
        // active read restores that guarantee; the window is decoration.
        const [recent, active] = await Promise.all([
          readJsonAsync<Run[]>(['list', '--limit', '200', '--json'], TRACE),
          readJsonAsync<Run[]>(['list', '--active', '--json'], TRACE),
        ]);
        const documents = readJsonCmd(['docs', '--json']);
        // The whole dependency graph in one read, joined per ticket on the
        // client exactly the way documents already are. The alternative was
        // widening `ticket list --json`, which smriti-factory also consumes —
        // and two mechanisms for the same job is how the two drift.
        const deps = readJsonCmd(['deps', '--json']);
        const repositories = readJsonCmd(['list', '--json'], REPO);
        const projects = readJsonCmd(['list', '--all', '--json'], PROJECT);
        if (tickets === null) {
          return json({ error: 'could not read the ticket store' }, 503);
        }
        const byUid = new Map<string, Run>();
        for (const r of [...(active ?? []), ...(recent ?? [])]) byUid.set(r.run_uid, r);
        const runs = [...byUid.values()];
        await resolveHtmlUrls(runs);
        return json({
          tickets,
          runs,
          documents: documents ?? [],
          deps: deps ?? [],
          repositories: repositories ?? [],
          projects: projects ?? [],
          // null, not [], when herdr could not be asked. The page treats an
          // empty list as proof that nothing is running and an absent one as
          // proof of nothing — see isLiveRun.
          sessions: herdrSessionsSync(),
        });
      }

      // Every run for one ticket, however old — the overlay must not depend on
      // a run still being inside /api/state's window. The limit is explicit
      // because cmd_list defaults to 100, and inheriting that default would
      // reintroduce the very truncation this route exists to avoid.
      if (url.pathname === '/api/runs' && req.method === 'GET') {
        touch();
        const id = url.searchParams.get('ticket') || '';
        if (!/^\d+$/.test(id)) return json({ error: 'bad ticket' }, 400);
        // Reports ride along with the run list, one query for the whole ticket.
        // Per-run they cost a spawn each, which doubled the subprocess count of
        // opening a ticket — and the run bodies fill from this same fetch.
        const [runs, artifacts] = await Promise.all([
          readJsonAsync<Run[]>(['list', '--ticket', id, '--limit', '1000', '--json'], TRACE),
          readJsonAsync<ArtifactRow[]>(['artifacts', '--ticket', id, '--kind', 'report', '--json'], TRACE),
        ]);
        if (runs === null) return json({ error: 'could not read the trace' }, 503);
        return json({ runs, artifacts: artifacts ?? [] });
      }

      // One run's phase breakdown. The uid comes from the client, so it is
      // validated against the shape `trace start` mints before it reaches the
      // CLI — the same discipline as the numeric guard on /api/doc/:id.
      const runDetail = url.pathname.match(/^\/api\/run\/(.+)$/);
      if (runDetail && req.method === 'GET') {
        touch();
        const uid = runDetail[1];
        if (!/^[0-9a-f]{8}$/.test(uid)) return json({ error: 'bad run id' }, 400);
        const detail = await readJsonAsync(['show', uid, '--json'], TRACE);
        if (detail === null) return json({ error: 'no such run' }, 404);
        return json(detail);
      }

      if (url.pathname === '/api/stats' && req.method === 'GET') {
        touch();
        const days = url.searchParams.get('days') || '30';
        if (!/^\d{1,9}$/.test(days)) return json({ error: 'bad days' }, 400);
        const stats = await readJsonAsync(['stats', '--days', days, '--json'], TRACE);
        if (stats === null) return json({ error: 'could not read the trace' }, 503);
        return json(stats);
      }

      // A document's content. This route USED to be the one step outside the
      // CLI contract — it opened a file whose path came from a client-supplied
      // id, guarded by realpath-confinement and a size cap. The factory stores
      // document bodies now, so the read goes through the CLI like every other
      // read, the guards are gone because the file access they guarded is gone,
      // and with it the whole path-traversal risk class.
      //
      // `doc-show` and not a body column in /api/state: it syncs from the
      // working copy when one still exists, which is what makes a plan you are
      // actively revising render as what you just wrote.
      if (url.pathname.startsWith('/api/doc/') && req.method === 'GET') {
        touch();
        const id = url.pathname.split('/').pop() || '';
        if (!/^\d+$/.test(id)) return json({ error: 'bad id' }, 400);
        const doc = await readJsonAsync<{ has_body?: number; body?: string | null }>(
          ['doc-show', id, '--json'],
        );
        if (!doc) return json({ error: 'no such document' }, 404);
        // Registered but never captured — a real state, not an error: /begin
        // registers a plan a moment before it writes it.
        if (!doc.has_body || typeof doc.body !== 'string') {
          return json({ error: 'no content stored for this document yet' }, 404);
        }
        return json({ html: renderMarkdown(doc.body) });
      }

      // Markdown for the three DESCRIPTION surfaces — a ticket body, an app
      // description, a project description.
      //
      // A function over the wire rather than a resource, and deliberately so:
      // the client already holds all three sources (they ride along in
      // /api/state), it just cannot reach the renderer, because the whole
      // browser client is one template string with no build step. Per-entity
      // GET routes would shell out three times to fetch what the caller
      // already had. /api/doc/:id stays per-entity for a different reason —
      // document bodies are deliberately kept out of /api/state, so the caller
      // does NOT already hold them.
      //
      // Nor does the rendered HTML belong in /api/state: that payload is
      // rebuilt on a ~1s mtime watch, and most bodies are never opened, so
      // embedding them would render every description in the store on every
      // tick to serve the one the reader actually looked at.
      if (url.pathname === '/api/render' && req.method === 'POST') {
        touch();
        // The cap is enforced while READING, not after. req.json() buffers the
        // whole body before it returns, so a length checked afterwards is a
        // length whose cost has already been paid — and content-length alone
        // cannot be trusted, since a chunked body does not declare one at all.
        // Reading with a running budget covers both, and never holds more than
        // the cap plus the chunk that crossed it.
        const declared = Number(req.headers.get('content-length') || 0);
        if (declared > MAX_RENDER_BYTES) return json({ error: 'too large' }, 413);
        const raw = await readCapped(req, MAX_RENDER_BYTES);
        if (raw === null) return json({ error: 'too large' }, 413);
        let b: { md?: string } = {};
        try { b = JSON.parse(raw); } catch {}
        return json({ html: renderMarkdown(typeof b.md === 'string' ? b.md : '') });
      }

      // ── photos ─────────────────────────────────────────────────────────
      //
      // Raw bytes on the way in, not multipart: the client is a paste handler
      // holding one Blob, and a form encoding would mean building and parsing a
      // wrapper around the only file there will ever be.
      //
      // The declared content-type is READ BUT NOT TRUSTED — it is not passed to
      // the CLI at all. `smriti photo add` decides what the file is by sniffing
      // its leading bytes, which is the only check that cannot be lied to, and
      // the one that keeps an SVG (a program, rendered inside this page) out.
      if (url.pathname === '/api/photos' && req.method === 'POST') {
        touch();
        const declared = Number(req.headers.get('content-length') || 0);
        if (declared > MAX_PHOTO_BYTES) return json({ error: 'that photo is too large' }, 413);
        const bytes = await readCappedBytes(req, MAX_PHOTO_BYTES);
        if (bytes === null) return json({ error: 'that photo is too large' }, 413);
        if (!bytes.byteLength) return json({ error: 'nothing was uploaded' }, 400);
        const r = await shBytes(PHOTO, ['add', '--json'], bytes);
        if (!r.ok) {
          // Exit 5 is the CLI's considered refusal — too large, or not an image
          // it stores. It carries a message written for a person, so it is
          // passed through rather than replaced with a generic failure.
          const status = r.code === 5 ? 415 : 500;
          return json({ error: r.errOut.replace(/^smriti-photo:\s*/, '') || 'could not store that photo' }, status);
        }
        try { return json(JSON.parse(r.out)); }
        catch { return json({ error: 'could not store that photo' }, 500); }
      }

      // The bytes back out. Cached hard and forever, which is only safe because
      // photo ids are never reused (see the AUTOINCREMENT note in the schema):
      // a given id is one immutable picture for the life of the store.
      const photo = url.pathname.match(/^\/api\/photo\/(\d+)$/);
      if (photo && req.method === 'GET') {
        touch();
        const r = await shOut(PHOTO, ['data', photo[1]]);
        if (!r.ok) return new Response('no such photo', { status: 404 });
        // mime on the first line, the bytes as hex on the second. Hex because a
        // shell cannot carry raw binary out of a subprocess intact — see the
        // note on `photo data`.
        const nl = r.out.indexOf('\n');
        if (nl < 0) return new Response('no such photo', { status: 404 });
        const mime = r.out.slice(0, nl).trim();
        const data = Buffer.from(r.out.slice(nl + 1).trim(), 'hex');
        if (!/^image\/(png|jpeg|gif|webp)$/.test(mime) || !data.byteLength) {
          return new Response('no such photo', { status: 404 });
        }
        return new Response(data, {
          headers: {
            'content-type': mime,
            'content-length': String(data.byteLength),
            // Belt and braces around a stored file: never re-interpret the type
            // by sniffing, and even if something non-image ever got in, give it
            // nothing it could reach.
            'x-content-type-options': 'nosniff',
            'content-security-policy': "default-src 'none'; sandbox",
            'cache-control': 'public, max-age=31536000, immutable',
          },
        });
      }

      // ── repo-level markdown ────────────────────────────────────────────
      // The board's ONLY remaining file read — /api/doc/:id was the other one,
      // and it is now a CLI read. This one survives because it is far narrower:
      // the filename is not user input at all.
      //   - the slug shape forbids separators, so it cannot traverse
      //   - the document name comes from a fixed two-item allowlist
      //   - the repo root comes from `smriti repo show --json`, never the client
      //   - realpath must still land under that root, so a symlinked DESIGN.md
      //     pointing at ~/.ssh/id_rsa is refused
      const repoDoc = url.pathname.match(/^\/api\/repos\/([^/]+)\/doc\/([A-Z]+)$/);
      if (repoDoc && req.method === 'GET') {
        touch();
        const slug = decodeURIComponent(repoDoc[1]);
        if (!/^[a-z0-9][a-z0-9._-]*$/i.test(slug)) return json({ error: 'bad slug' }, 400);
        const NAMES: Record<string, string> = { PROJECT: 'PROJECT.md', DESIGN: 'DESIGN.md' };
        const name = NAMES[repoDoc[2]];
        if (!name) return json({ error: 'no such document' }, 404);

        const info = sh(REPO, ['show', slug, '--json']);
        if (!info.ok) return json({ error: 'no such app' }, 404);
        let root = '';
        try { root = JSON.parse(info.out)?.repo_path || ''; } catch {}
        if (!root) return json({ error: 'this app has no repo on this machine' }, 404);

        let realRoot = '';
        try { realRoot = realpathSync(root); } catch { return json({ error: 'repo is gone' }, 404); }
        let real = '';
        try { real = realpathSync(join(realRoot, name)); } catch { return json({ error: 'no ' + name }, 404); }
        if (real !== join(realRoot, name) && !real.startsWith(realRoot + sep)) {
          return json({ error: 'forbidden path' }, 403);
        }
        if (statSync(real).size > 2_000_000) return json({ error: 'too large' }, 413);
        return json({ name, path: real, html: renderMarkdown(readFileSync(real, 'utf8')) });
      }

      if (url.pathname === '/api/tickets' && req.method === 'POST') {
        touch();
        const body = (await req.json().catch(() => ({}))) as {
          title?: string; repo?: string; project?: string;
        };
        const title = (body.title || '').trim();
        if (!title) return json({ error: 'a title is required' }, 400);
        const args = ['add', title, '--ready'];
        // No repo and no project is a legitimate capture: an idea. '-' says so
        // explicitly — omitting --repo would let smriti-ticket derive one from
        // the SERVER's cwd, which is wherever `smriti` happened to be started.
        if (body.project) args.push('--project', body.project);
        args.push('--repo', body.repo || '-');
        const r = sh(TICKET, args);
        if (!r.ok) return json({ error: r.errOut || 'could not add' }, 500);
        const id = Number(r.out.match(/#(\d+)/)?.[1] || 0);
        broadcast();
        return json({ id });
      }

      // ── apps and projects ──────────────────────────────────────────────
      const repoEdit = url.pathname.match(/^\/api\/repos\/([^/]+)$/);
      if (repoEdit && req.method === 'PATCH') {
        touch();
        const b = (await req.json().catch(() => ({}))) as { name?: string; description?: string };
        const args = ['edit', decodeURIComponent(repoEdit[1])];
        if (typeof b.name === 'string') args.push('--name', b.name);
        if (typeof b.description === 'string') args.push('--description', b.description);
        if (args.length === 2) return json({ error: 'nothing to change' }, 400);
        const r = sh(REPO, args);
        if (!r.ok) return json({ error: r.errOut || 'could not edit' }, 500);
        broadcast();
        return json({ ok: true });
      }

      if (url.pathname === '/api/projects' && req.method === 'POST') {
        touch();
        const b = (await req.json().catch(() => ({}))) as {
          name?: string; repo?: string; description?: string;
        };
        const name = (b.name || '').trim();
        if (!name) return json({ error: 'a name is required' }, 400);
        // '-' is smriti-project's explicit "no app yet", which is not the same
        // as "derive one from the cwd" — and the server's cwd is meaningless.
        const args = ['add', name, '--repo', b.repo || '-'];
        if (b.description) args.push('--description', b.description);
        const r = sh(PROJECT, args);
        if (!r.ok) return json({ error: r.errOut || 'could not add' }, 500);
        broadcast();
        return json({ id: Number(r.out.match(/#(\d+)/)?.[1] || 0) });
      }

      const projEdit = url.pathname.match(/^\/api\/projects\/(\d+)$/);
      if (projEdit && req.method === 'PATCH') {
        touch();
        const b = (await req.json().catch(() => ({}))) as {
          name?: string; description?: string; repo?: string;
        };
        const args = ['edit', projEdit[1]];
        if (typeof b.name === 'string') args.push('--name', b.name);
        if (typeof b.description === 'string') args.push('--description', b.description);
        if (typeof b.repo === 'string') args.push('--repo', b.repo || '-');
        if (args.length === 2) return json({ error: 'nothing to change' }, 400);
        const r = sh(PROJECT, args);
        if (!r.ok) return json({ error: r.errOut || 'could not edit' }, 500);
        broadcast();
        return json({ ok: true });
      }
      if (projEdit && req.method === 'DELETE') {
        touch();
        const r = sh(PROJECT, ['rm', projEdit[1], '--yes']);
        if (!r.ok) return json({ error: r.errOut || 'could not delete' }, 500);
        broadcast();
        return json({ ok: true });
      }

      const start = url.pathname.match(/^\/api\/tickets\/(\d+)\/start$/);
      if (start && req.method === 'POST') {
        touch();
        const id = Number(start[1]);
        // A restart in flight has already closed this ticket's pane and has not
        // yet started its replacement. Starting into that gap duplicates the
        // session the restart is about to create.
        if (sessionBusy.has(id)) return json({ error: 'that session is already being changed' }, 409);
        // The page sends {force:true} only after the user has been told what is
        // in the way and said start it anyway. An empty body is the normal case.
        const sb = (await req.json().catch(() => ({}))) as { force?: boolean };
        const args = ['start', String(id)];
        if (sb.force === true) args.push('--force');
        const r = sh(TICKET, args, 30000);
        // Same reasoning as the move route below: the CLI's exit codes carry
        // more than "it failed", and collapsing them all to 500 told the user
        // the factory had fallen over when in fact the ticket was merely
        // blocked. 7 is that refusal — a conflict with the dependency graph,
        // not a fault — and the page offers to force past it.
        if (!r.ok) {
          const code = r.code === 7 ? 409 : r.code === 4 ? 404 : r.code === 2 ? 400 : 500;
          return json({ error: r.errOut || 'could not start', blocked: r.code === 7 }, code);
        }
        const dir = r.out.split('\n')[0].trim();
        const launch = launchSession(dir, id);
        broadcast();
        return json({ path: dir, ...launch });
      }

      // Explicitly replace a session: capture what it said, close the old pane,
      // then start fresh.
      const restart = url.pathname.match(/^\/api\/tickets\/(\d+)\/restart$/);
      if (restart && req.method === 'POST') {
        touch();
        const id = Number(restart[1]);
        // One restart per ticket at a time. This route destroys a pane and then
        // starts a replacement, so two of them interleaved start two sessions
        // against one closed pane. It was a narrow race while the whole thing
        // was synchronous; capturing first makes it slower and reachable.
        if (sessionBusy.has(id)) return json({ error: 'that session is already being changed' }, 409);
        sessionBusy.add(id);
        try {
          // `start` is idempotent and reports the existing worktree, which is how
          // we find the old session — it is the pane whose cwd is this worktree.
          const r = await shOut(TICKET, ['start', String(id)], 30000);
          if (!r.ok) return json({ error: r.errOut || 'could not restart' }, 500);
          const dir = r.out.split('\n')[0].trim();
          // The worktree is the only thing this route matches a session on, so
          // an empty one does not mean "no session" — it means we do not know,
          // and carrying on would force-launch into `cd '' && claude`.
          if (!dir) return json({ error: 'could not resolve the worktree' }, 500);

          // herdr 0.8 has no `agent stop`. Closing the pane is what actually ends
          // the session: renaming the agent only frees the name, and the old claude
          // would still be sitting in that pane, so the new `agent start` would be
          // refused as agent_pane_busy forever. A restart replaces the session, so
          // losing the old pane is the point rather than a cost.
          //
          // But not before reading it. This is the action you reach for when a
          // run has gone wrong, which is exactly when what it printed is worth
          // keeping — and until this existed, restart was the one place that
          // destroyed it. `true`: unlike the sweep, a pane we could not capture
          // is still closed, because you asked for this session to be replaced
          // and refusing would leave you holding the broken one.
          const old = await existingAgentAsync(dir);
          let closed = true;
          if (old.found && old.pane) {
            ({ closed } = await captureThenClose(
              old.pane, await runForPane(id, old.pane), { closeWhenUncaptured: true }));
            // The closed session can still be listed for a moment, and
            // launchSession's own force flag covers that — but agent start is
            // refused as agent_pane_busy until herdr lets go of the pane.
            await Bun.sleep(500);
          }
          // force: the session we just closed can still be listed for a moment,
          // and matching on cwd would otherwise make restart a no-op.
          const launch = launchSession(dir, id, true);
          broadcast();
          // A close that failed leaves the old claude sitting in the pane, so
          // the relaunch below will have been refused as agent_pane_busy and
          // handed back a paste command. Say so rather than letting that read
          // as an ordinary manual fallback.
          return json({ path: dir, ...launch, ...(closed ? {} : { oldSessionSurvived: true }) });
        } finally {
          sessionBusy.delete(id);
        }
      }

      // End a session, deliberately. The board could start one and replace one
      // and had no verb for stopping one, so ending a run meant closing the pane
      // in herdr by hand — and the board then went on claiming the ticket was
      // running, because nothing reconciled that.
      //
      // Not built on `ticket start` the way restart is: that verb is idempotent
      // only in the sense that it CREATES the worktree if it is missing and flips
      // the ticket to in_progress. Stopping must not do either, so the worktree
      // is read off the ticket instead, and a ticket without one has no session
      // to end by definition.
      const stop = url.pathname.match(/^\/api\/tickets\/(\d+)\/stop$/);
      if (stop && req.method === 'POST') {
        touch();
        const id = Number(stop[1]);
        // Two different failures, told apart rather than both blamed on the
        // worktree: `show` exits 4 for a ticket that does not exist, and saying
        // "it has no worktree" about a number you mistyped is a false statement
        // about a thing that was never there.
        const shown = await readJsonAsync<{ ticket?: { worktree_path?: string | null } }>(
          ['show', String(id), '--json']);
        if (!shown?.ticket) return json({ error: 'no ticket #' + id }, 404);
        const dir = shown.ticket.worktree_path ?? '';
        if (!dir) return json({ error: 'that ticket has no worktree, so it has no session' }, 400);

        const res = await withSession(id, async () => {
          const live = await existingAgentAsync(dir);
          if (!live.found || !live.pane) return { none: true as const };
          const run = await runForPane(id, live.pane);

          // Stop the plan review BEFORE the pane, when there is one. Closing only
          // the pane leaves smriti-html serving a page for an agent that no longer
          // exists, until its own idle reaper eventually notices — and `html stop`
          // is also what closes the gate in the trace, so skipping it would leave
          // the run parked in "waiting on you" that much longer.
          if (run?.html_session) {
            await shAsync(HTML, ['stop', '--session', run.html_session], 5000);
          }

          // true, like restart and unlike the sweep: you asked for this session
          // to end, and refusing because its pane could not be read would leave
          // you holding the one you asked to be rid of. The capture still runs
          // first either way.
          const { captured, closed } = await captureThenClose(live.pane, run, { closeWhenUncaptured: true });
          return { captured, closed };
        });

        if (!res) return json({ error: 'that session is already being changed' }, 409);
        if ('none' in res) return json({ error: 'no live session for that ticket' }, 404);
        broadcast();
        return json({ ok: true, captured: res.captured, closed: res.closed });
      }

      const edit = url.pathname.match(/^\/api\/tickets\/(\d+)$/);
      if (edit && req.method === 'PATCH') {
        touch();
        const b = (await req.json().catch(() => ({}))) as {
          title?: string; body?: string; repo?: string; project?: string | null;
        };
        const args = ['edit', edit[1]];
        if (typeof b.title === 'string') args.push('--title', b.title);
        if (typeof b.body === 'string') args.push('--body', b.body);
        if (typeof b.repo === 'string') args.push('--repo', b.repo || '-');
        // null means "take it out of its project"; a value files it into one.
        if (b.project === null) args.push('--no-project');
        else if (typeof b.project === 'string' && b.project) args.push('--project', b.project);
        if (args.length === 2) return json({ error: 'nothing to change' }, 400);
        const r = sh(TICKET, args);
        if (!r.ok) return json({ error: r.errOut || 'could not edit' }, 500);
        broadcast();
        return json({ ok: true });
      }
      if (edit && req.method === 'DELETE') {
        touch();
        const r = sh(TICKET, ['rm', edit[1], '--yes']);
        if (!r.ok) return json({ error: r.errOut || 'could not delete' }, 500);
        broadcast();
        return json({ ok: true });
      }

      // /revive and /cancel used to sit here, one hardcoding `status ready`
      // and the other the `cancel` verb. They were the buttons' routes, and
      // the buttons became rows on the status picker — which posts here with
      // the value it wants. Two spellings of "write a status" that nothing
      // called were two more places to keep in step with validate_status.
      //
      // Kept as its own route rather than a field on PATCH: `edit` and
      // `status` are separate CLI verbs, so a PATCH carrying status alongside
      // repo would have to run two of them in sequence with nothing
      // transactional around the pair.
      const setStatus = url.pathname.match(/^\/api\/tickets\/(\d+)\/status$/);
      if (setStatus && req.method === 'POST') {
        touch();
        const b = (await req.json().catch(() => ({}))) as { status?: string };
        if (typeof b.status !== 'string' || !b.status) return json({ error: 'a status is required' }, 400);
        // The CLI owns which values are legal — validate_status rejects
        // anything else and its message names the whole set.
        const r = sh(TICKET, ['status', setStatus[1], b.status]);
        if (!r.ok) return json({ error: r.errOut || 'could not set the status' }, 500);
        broadcast();
        return json({ ok: true });
      }

      // Draw or cut a dependency edge. Its own route for the same reason
      // /status has one: `dep` is a separate CLI verb, and the direction is
      // part of the request rather than a field being written.
      const dep = url.pathname.match(/^\/api\/tickets\/(\d+)\/deps$/);
      if (dep && req.method === 'POST') {
        touch();
        const b = (await req.json().catch(() => ({}))) as
          { blocks?: number; blockedBy?: number; rm?: number };
        // Integer-checked here rather than trusted: these reach a command line,
        // and NaN/1.5/Infinity would arrive as strings that mean nothing to the
        // CLI. Same guard the move route already applies to before/after.
        const isId = (v: unknown): v is number => Number.isInteger(v) && (v as number) > 0;
        let args: string[];
        if (isId(b.blocks))         args = ['dep', dep[1], '--blocks', String(b.blocks)];
        else if (isId(b.blockedBy)) args = ['dep', dep[1], '--blocked-by', String(b.blockedBy)];
        else if (isId(b.rm))        args = ['dep', dep[1], '--rm', String(b.rm)];
        else return json({ error: 'say which edge: blocks, blockedBy or rm' }, 400);
        const r = sh(TICKET, args);
        // 7 is a refusal the user can act on — a self-link or a cycle — and
        // reads as a conflict, not as the factory falling over.
        if (!r.ok) {
          const code = r.code === 7 ? 409 : r.code === 4 ? 404 : r.code === 2 ? 400 : 500;
          return json({ error: r.errOut || 'could not change the dependency' }, code);
        }
        broadcast();
        return json({ ok: true });
      }

      // Reorder. Relative to another card, never a raw position — the CLI owns
      // the arithmetic, so the drag and the keyboard both land on one place
      // that can decide about midpoints and renumbering.
      const move = url.pathname.match(/^\/api\/tickets\/(\d+)\/move$/);
      if (move && req.method === 'POST') {
        touch();
        const b = (await req.json().catch(() => ({}))) as
          { before?: number; after?: number; top?: boolean; bottom?: boolean };
        // typeof 'number' alone admits NaN, 1.5 and Infinity, which reach the
        // command line as "NaN"/"1.5"/"Infinity", get rejected there as a usage
        // error, and surface as "the factory fell over". A ticket id is a
        // positive integer; ask for one.
        const isId = (v: unknown) => Number.isInteger(v) && (v as number) > 0;
        let args: string[];
        if (b.before !== undefined || b.after !== undefined) {
          const rel = b.before !== undefined ? b.before : b.after;
          if (!isId(rel)) return json({ error: 'before/after must be a ticket id' }, 400);
          args = ['move', move[1], b.before !== undefined ? '--before' : '--after', String(rel)];
        }
        else if (b.top)    args = ['move', move[1], '--top'];
        else if (b.bottom) args = ['move', move[1], '--bottom'];
        else return json({ error: 'say where it goes: before, after, top or bottom' }, 400);
        const r = sh(TICKET, args);
        // The CLI's exit codes carry more than "it failed", and the page acts
        // on the difference: 6 is a drop into another app or project, 4 is a
        // ticket that is not there, 2 is a malformed request. None of the three
        // is the factory falling over, which is what a 500 tells the user.
        if (!r.ok) {
          const code = r.code === 6 ? 409 : r.code === 4 ? 404 : r.code === 2 ? 400 : 500;
          return json({ error: r.errOut || 'could not move it' }, code);
        }
        broadcast();
        // A move can SUCCEED and still have something to say: dropping a ticket
        // above one it is blocked by is a contradiction the CLI reports on
        // stderr and deliberately does not correct. Dropping stderr on the ok
        // path meant the board — the only surface where dragging exists — never
        // said anything at all.
        const note = (r.errOut || '')
          .split('\n')
          .filter((l) => l.includes('heads up'))
          .map((l) => l.replace(/^[a-z-]+:\s*heads up —\s*/, ''))
          .join('; ');
        return json({ ok: true, ...(note ? { note } : {}) });
      }

      const done = url.pathname.match(/^\/api\/tickets\/(\d+)\/done$/);
      if (done && req.method === 'POST') {
        touch();
        const r = sh(TICKET, ['done', done[1]]);
        if (!r.ok) return json({ error: r.errOut || 'could not update' }, 500);
        broadcast();
        return json({ ok: true });
      }

      if (url.pathname === '/api/events' && req.method === 'GET') {
        // Deliberately does NOT touch(): an idle tab must not keep the server
        // alive forever. The client pings while visible instead.
        let send: (s: string) => void;
        const stream = new ReadableStream({
          start(c) {
            const enc = new TextEncoder();
            send = (s) => { try { c.enqueue(enc.encode(s)); } catch { sse.delete(send); } };
            sse.add(send);
            send(`event: hello\ndata: ok\n\n`);
          },
          cancel() { sse.delete(send); },
        });
        return new Response(stream, {
          headers: { 'content-type': 'text/event-stream', 'cache-control': 'no-cache', connection: 'keep-alive' },
        });
      }

      return new Response('not found', { status: 404 });
    },
  });

  function broadcast() { for (const fn of sse) fn(`event: changed\ndata: 1\n\n`); }

  // Watch the store and tell open tabs. Polling mtime is cheap and safe —
  // polling the db through the CLI every second would be 3 spawns/second.
  const dbPath = join(SMRITI_HOME, 'factory.db');
  let lastM = 0;
  const watcher = setInterval(() => {
    try {
      const m = statSync(dbPath).mtimeMs;
      if (m !== lastM) { lastM = m; broadcast(); }
    } catch {}
  }, 900);
  watcher.unref?.();

  const heartbeat = setInterval(() => { if (sse.size) for (const fn of sse) fn(': keep-alive\n\n'); }, 20000);
  heartbeat.unref?.();

  // Close finished sessions. Its own timer, deliberately NOT the /api/state
  // path: that already spawns herdr synchronously about once a second while an
  // agent works, and this adds several more spawns per pass.
  //
  // Ten seconds because this is a rare event and nothing is waiting on it. The
  // board is opportunistic rather than a daemon — it reaps itself after
  // IDLE_MS, so if it is not running when a ticket ships, nothing closes that
  // pane until you next open the board. That is why the sweep scans state
  // instead of reacting to an event, and why it also runs once at startup:
  // whatever shipped while the board was down is caught on the way back up.
  // Late is fine now that capture no longer depends on the pane surviving.
  const sweeper = setInterval(() => { void sweepShippedSessions(); }, SWEEP_MS);
  sweeper.unref?.();

  const reaper = setInterval(() => {
    if (Date.now() - last <= IDLE_MS) return;
    // Only tear down state that is still OURS. An orphan from a lost start
    // race used to delete the *live* server's portfile/pidfile/secret on its
    // way out, after which every `smriti` spawned yet another server and
    // `smriti board stop` could no longer find any of them.
    let ownsState = false;
    try { ownsState = parseInt(readFileSync(join(STATE_DIR, 'pidfile'), 'utf8').trim(), 10) === process.pid; } catch {}
    if (ownsState) { try { rmSync(STATE_DIR, { recursive: true, force: true }); } catch {} }
    process.exit(0);
  }, 5000);
  reaper.unref?.();

  // Claiming the pidfile must be ATOMIC, not check-then-write: two `smriti`
  // invocations at once both read an absent pidfile, both decide they won, and
  // both keep running — one of them orphaned forever. The 'wx' flag creates or
  // fails, which is the actual claim.
  const pidPath = join(STATE_DIR, 'pidfile');
  const claim = (): boolean => {
    try {
      writeFileSync(pidPath, `${process.pid}\n`, { mode: 0o600, flag: 'wx' });
      return true;
    } catch {
      return false;
    }
  };
  if (!claim()) {
    // Someone holds it. If they are alive, we lost and stand down; if the file
    // is a corpse from a hard kill, clear it and take the claim.
    let holder = 0;
    try { holder = parseInt(readFileSync(pidPath, 'utf8').trim(), 10); } catch {}
    if (holder && holder !== process.pid && pidAlive(holder)) {
      server.stop(true);
      process.exit(0);
    }
    try { rmSync(pidPath, { force: true }); } catch {}
    if (!claim()) { server.stop(true); process.exit(0); }
  }
  // pidfile claimed above; portfile last, because its presence means "ready".
  writeFileSync(join(STATE_DIR, 'secret'), secret + '\n', { mode: 0o600 });
  writeFileSync(join(STATE_DIR, 'portfile'), `${server.port}\n`, { mode: 0o600 });

  // Only now, with the pidfile actually ours, is the first sweep allowed to
  // run — it checks ownership itself, but starting it before the claim would
  // just be a guaranteed no-op.
  void sweepShippedSessions();

  return await new Promise<never>(() => {});
}

// ─── CLI ─────────────────────────────────────────────────────────────────

function ensureServer(): { port: number; secret: string } {
  const existing = readState();
  if (existing && pidAlive(existing.pid)) return existing;
  if (existsSync(STATE_DIR)) rmSync(STATE_DIR, { recursive: true, force: true });
  mkdirSync(STATE_DIR, { recursive: true });

  const child = spawn(process.execPath, [SELF, '__server'], {
    detached: true,
    stdio: ['ignore', 'ignore', 'ignore'],
    env: process.env,
  });
  child.unref();

  const deadline = Date.now() + 6000;
  while (Date.now() < deadline) {
    const st = readState();
    if (st) return st;
    Bun.sleepSync(50);
  }
  try { child.kill(); } catch {}
  rmSync(STATE_DIR, { recursive: true, force: true });
  process.stderr.write('smriti-board: server did not start within 6s\n');
  process.exit(2);
}

async function main(): Promise<number> {
  const args = process.argv.slice(2);
  const cmd = args[0] || 'open';

  if (cmd === '__server') { await cmdServer(); return 0; }

  if (cmd === 'stop') {
    const st = readState();
    if (st && pidAlive(st.pid)) { try { process.kill(st.pid, 'SIGTERM'); } catch {} }
    rmSync(STATE_DIR, { recursive: true, force: true });
    process.stdout.write('stopped\n');
    return 0;
  }

  if (cmd === 'open' || cmd === '--url' || cmd === '-h' || cmd === '--help') {
    if (cmd === '-h' || cmd === '--help') {
      process.stderr.write(
        'Usage:\n  smriti board          open the board (starts the server if needed)\n' +
        '  smriti board --url    print the URL without opening a browser\n' +
        '  smriti board stop     stop the server\n' +
        'Exit codes: 0=ok 1=usage 2=runtime\n',
      );
      return 1;
    }
    const st = ensureServer();
    const url = `http://127.0.0.1:${st.port}/?k=${st.secret}`;
    process.stdout.write(url + '\n');
    if (cmd === 'open') openInBrowser(url);
    return 0;
  }

  err(`unknown command: ${cmd}`);
}

main().then((c) => process.exit(c)).catch((e) => {
  process.stderr.write(`smriti-board: ${String(e?.message ?? e)}\n`);
  process.exit(2);
});
