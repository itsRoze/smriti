#!/usr/bin/env bash
# smriti learnings-search — query the project learnings store.
# Reads $SMRITI_HOME/projects/<slug>/learnings.jsonl (and optionally
# trusted entries from sibling projects with --cross-project).
#
# Read-time semantics:
#   • Dedup by (key, type), latest ts wins.
#   • Confidence decay: observed/inferred lose 1pt per 30 days; user-stated never decay.
#   • --cross-project loads only entries with trusted=true from other projects.
#
# Output: NDJSON (one entry per line). Caller can pipe to jq for formatting.
#
# Flags:
#   --query <substr>     case-insensitive substring of insight
#   --type <type>        filter by type
#   --limit <n>          max results (default 20)
#   --cross-project      include trusted entries from other projects
#   --format text        human-readable [type/key] insight (confidence N, source)
set -e

if ! command -v jq >/dev/null 2>&1; then
  echo "smriti-learnings-search: jq is required (brew install jq)" >&2
  exit 1
fi

SMRITI_BIN="$(cd "$(dirname "$0")" && pwd -P)"

QUERY=""; TYPE=""; LIMIT=20; CROSS_PROJECT=0; FORMAT=jsonl
while [ $# -gt 0 ]; do
  case "$1" in
    --query)         QUERY="$2"; shift 2 ;;
    --type)          TYPE="$2"; shift 2 ;;
    --limit)         LIMIT="$2"; shift 2 ;;
    --cross-project) CROSS_PROJECT=1; shift ;;
    --format)        FORMAT="$2"; shift 2 ;;
    *) echo "unknown flag: $1" >&2; exit 1 ;;
  esac
done

eval "$("$SMRITI_BIN/smriti-slug" 2>/dev/null)" 2>/dev/null
PROJ_DIR="${SMRITI_HOME:-$HOME/.smriti}/projects/${SLUG:-unknown}"
LEARNINGS_FILE="$PROJ_DIR/learnings.jsonl"

TMPFILE=$(mktemp)
trap 'rm -f "$TMPFILE"' EXIT

[ -f "$LEARNINGS_FILE" ] && cat "$LEARNINGS_FILE" >> "$TMPFILE"

if [ "$CROSS_PROJECT" -eq 1 ]; then
  for OTHER in "${SMRITI_HOME:-$HOME/.smriti}"/projects/*/learnings.jsonl; do
    [ -f "$OTHER" ] || continue
    [ "$OTHER" = "$LEARNINGS_FILE" ] && continue
    jq -c 'select(.trusted == true)' "$OTHER" >> "$TMPFILE" 2>/dev/null || true
  done
fi

[ -s "$TMPFILE" ] || exit 0

NOW_TS=$(date -u +%s)

RESULT=$(jq -s --arg query "$QUERY" --arg tfilter "$TYPE" --argjson now "$NOW_TS" '
  map(
    . as $e
    | (try (.ts | sub("Z$"; "+00:00") | fromdateiso8601) catch $now) as $ts
    | (($now - $ts) / 86400 / 30 | floor) as $periods
    | if (.source == "observed" or .source == "inferred")
      then .confidence = ((.confidence - $periods) | if . < 1 then 1 else . end)
      else .
      end
  )
  | group_by(.key + ":" + .type)
  | map(sort_by(.ts) | reverse | .[0])
  | map(select(.insight != null and (.insight | startswith("[REMOVED") | not)))
  | map(select($tfilter == "" or .type == $tfilter))
  | map(select($query == "" or (.insight | ascii_downcase | contains($query | ascii_downcase))))
  | sort_by(.ts) | reverse
  | .[]
' "$TMPFILE" | head -n "$LIMIT")

if [ "$FORMAT" = "text" ]; then
  printf '%s\n' "$RESULT" | jq -r '"[\(.type)/\(.key)] \(.insight) (confidence \(.confidence), \(.source))"'
else
  printf '%s\n' "$RESULT"
fi
