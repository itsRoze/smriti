#!/usr/bin/env bash
# smriti project — manage the *set* of smriti-tracked projects.
# State: $SMRITI_HOME/projects/<slug>/   and   $SMRITI_HOME/slug-cache/<path-hash>
#
# Subcommands:
#   smriti project new <name>                 scaffold a new project dir + git init
#   smriti project list                       columns: slug, last-used, plans, designs, path
#   smriti project current                    slug for the current repo (wraps smriti-slug --print)
#   smriti project forget <slug> [--yes]      rm -rf project dir + slug-cache entries (destructive)
#   smriti project rename <old> <new>         rename a project slug (moves state + updates cache)
#
# Per-project state (design/plan/debug docs under ~/.smriti/projects/<slug>/) is
# written by the skills themselves. This one owns the *set*: stop tracking, list
# what's tracked, resolve the current repo's slug. Direct user action, no Claude reasoning.
set -e

SMRITI_HOME="${SMRITI_HOME:-$HOME/.smriti}"
PROJECTS_DIR="$SMRITI_HOME/projects"
SLUG_CACHE_DIR="$SMRITI_HOME/slug-cache"

usage() {
  cat <<'USAGE' >&2
usage:
  smriti project new <name>                 # scaffold a new project directory + git init
  smriti project list                       # list all tracked projects
  smriti project current                    # print slug for the current repo
  smriti project forget <slug> [--yes]      # delete project state + slug-cache (destructive)
  smriti project rename <old> <new>         # rename a project slug (moves state + updates cache)
USAGE
  exit 2
}

count_designs() {
  find "$1" -maxdepth 1 -type f -name '*-design-*.md' 2>/dev/null | wc -l | tr -d ' '
}
count_plans() {
  find "$1" -maxdepth 1 -type f -name '*-plan-*.md' 2>/dev/null | wc -l | tr -d ' '
}

last_used() {
  date -r "$1" +%Y-%m-%d 2>/dev/null || echo "-"
}

# Read the SLUG value from a cache file. Handles both new KV format
# (SLUG=value on its own line) and old single-line format (entire file is the slug).
read_slug_from_cache() {
  local file="$1"
  local first_line
  first_line=$(head -1 "$file")
  if printf '%s' "$first_line" | grep -q '='; then
    grep '^SLUG=' "$file" | cut -d= -f2-
  else
    printf '%s' "$first_line"
  fi
}

# Read SOURCE_PATH from a KV-format cache file. Returns empty for old single-line files.
read_source_path_from_cache() {
  local file="$1"
  grep '^SOURCE_PATH=' "$file" 2>/dev/null | cut -d= -f2- || true
}

# Reverse-lookup: every cache file whose SLUG matches <target>.
cache_files_for_slug() {
  local target="$1"
  [ -d "$SLUG_CACHE_DIR" ] || return 0
  for f in "$SLUG_CACHE_DIR"/*; do
    [ -f "$f" ] || continue
    local slug
    slug=$(read_slug_from_cache "$f" 2>/dev/null) || continue
    if [ "$slug" = "$target" ]; then
      printf '%s\n' "$f"
    fi
  done
}

# Build an associative-style lookup: for each slug, collect all source paths
# from cache files. Outputs lines of "slug<TAB>path" for consumption by list.
build_slug_path_map() {
  [ -d "$SLUG_CACHE_DIR" ] || return 0
  for f in "$SLUG_CACHE_DIR"/*; do
    [ -f "$f" ] || continue
    local slug source_path
    slug=$(read_slug_from_cache "$f" 2>/dev/null) || continue
    source_path=$(read_source_path_from_cache "$f")
    [ -n "$slug" ] && printf '%s\t%s\n' "$slug" "$source_path"
  done
}

validate_slug() {
  # Guard against path traversal: '../slug-cache' would resolve to ~/.smriti/slug-cache.
  local slug="$1" label="$2"
  case "$slug" in
    */*|.*)
      echo "smriti-project: invalid $label '$slug' (must not contain '/' or start with '.')" >&2
      exit 2
      ;;
    _archive)
      echo "smriti-project: '$slug' is a reserved name" >&2
      exit 2
      ;;
  esac
}

cmd_list() {
  if [ ! -d "$PROJECTS_DIR" ]; then
    echo "no projects tracked yet ($PROJECTS_DIR missing)"
    return 0
  fi

  local slug_paths
  slug_paths=$(build_slug_path_map)

  printf '%-40s  %-10s  %9s  %7s  %s\n' "SLUG" "LAST-USED" "PLANS" "DESIGNS" "PATH"
  local any=0
  for dir in "$PROJECTS_DIR"/*/; do
    [ -d "$dir" ] || continue
    local slug
    slug=$(basename "$dir")
    [ "$slug" = "_archive" ] && continue
    any=1

    local paths path_display
    paths=$(printf '%s' "$slug_paths" | grep "^${slug}	" | cut -f2- || true)
    local path_count
    path_count=$(printf '%s' "$paths" | grep -c . || true)

    if [ "$path_count" -eq 0 ] || { [ "$path_count" -eq 1 ] && [ -z "$paths" ]; }; then
      path_display="(unknown)"
    elif [ "$path_count" -eq 1 ]; then
      if [ -d "$paths" ]; then
        path_display="$paths"
      else
        path_display="(stale: $paths)"
      fi
    else
      local first_path
      first_path=$(printf '%s' "$paths" | head -1)
      if [ -d "$first_path" ]; then
        path_display="$first_path ($path_count paths)"
      else
        path_display="(stale: $first_path) ($path_count paths)"
      fi
    fi

    printf '%-40s  %-10s  %9s  %7s  %s\n' \
      "$slug" \
      "$(last_used "$dir")" \
      "$(count_plans "$dir")" \
      "$(count_designs "$dir")" \
      "$path_display"
  done
  if [ "$any" -eq 0 ]; then
    echo "  (none — run /bootstrap in a project to start tracking)"
  fi
}

cmd_current() {
  local self_dir
  self_dir="$(cd "$(dirname "$0")" && pwd -P)"
  if [ -x "$self_dir/smriti-slug" ]; then
    "$self_dir/smriti-slug" --print
  elif command -v smriti-slug >/dev/null 2>&1; then
    smriti-slug --print
  else
    echo "smriti-project: smriti-slug not found (looked in $self_dir and \$PATH)" >&2
    exit 1
  fi
}

cmd_new() {
  local name="${1:-}"
  [ -z "$name" ] && { echo "usage: smriti project new <name>" >&2; exit 2; }

  if [ -d "$name" ]; then
    echo "smriti-project: directory '$name' already exists" >&2
    exit 1
  fi

  mkdir -p "$name"
  git -C "$name" init -q

  echo "Created: $name/"
  echo ""
  echo "Next steps:"
  echo "  cd $name"
  echo "  claude                    # open Claude Code"
  echo "  /bootstrap                # set up PROJECT.md + coding principles"
  echo "  /begin                    # build your first feature end to end"
}

cmd_forget() {
  local slug="${1:-}"
  [ -z "$slug" ] && { echo "usage: smriti project forget <slug> [--yes]" >&2; exit 2; }
  shift
  local yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) yes=1; shift ;;
      *) echo "smriti-project: unknown flag '$1'" >&2; exit 2 ;;
    esac
  done

  validate_slug "$slug" "slug"

  local dir="$PROJECTS_DIR/$slug"
  if [ ! -d "$dir" ]; then
    echo "smriti-project: no project named '$slug' under $PROJECTS_DIR" >&2
    exit 1
  fi

  local plans designs
  plans=$(count_plans "$dir")
  designs=$(count_designs "$dir")

  local cache_files cache_count
  cache_files=$(cache_files_for_slug "$slug")
  cache_count=$(printf '%s' "$cache_files" | grep -c . || true)

  if [ "$yes" -ne 1 ]; then
    if [ ! -t 0 ]; then
      echo "smriti-project: refusing to forget without --yes in non-interactive shell" >&2
      exit 1
    fi
    echo "About to delete:"
    echo "  $dir"
    echo "    $plans plans, $designs designs"
    echo "  $cache_count slug-cache file(s)"
    printf "Delete? [y/N] "
    read -r ans || ans=""
    case "$ans" in
      y|Y|yes|YES) ;;
      *) echo "aborted."; exit 1 ;;
    esac
  fi

  rm -rf "$dir"
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    rm -f "$f"
  done <<< "$cache_files"

  echo "forgot: $slug"
  echo "  removed $dir"
  echo "  removed $cache_count slug-cache file(s)"
  echo ""
  echo "Note: smriti's runtime state for this project is gone."
  echo "PROJECT.md and DESIGN.md (if any) are still in your repo and tracked by git."
  echo "Run 'git rm PROJECT.md DESIGN.md' if you want them gone too."
}

cmd_rename() {
  local old="${1:-}"
  local new="${2:-}"
  [ -z "$old" ] || [ -z "$new" ] && { echo "usage: smriti project rename <old-slug> <new-slug>" >&2; exit 2; }

  validate_slug "$old" "old slug"
  validate_slug "$new" "new slug"

  if [ "$old" = "$new" ]; then
    echo "smriti-project: old and new slugs are the same ('$old')" >&2
    exit 1
  fi

  local old_dir="$PROJECTS_DIR/$old"
  local new_dir="$PROJECTS_DIR/$new"

  if [ ! -d "$old_dir" ]; then
    echo "smriti-project: no project named '$old' under $PROJECTS_DIR" >&2
    exit 1
  fi

  if [ -d "$new_dir" ]; then
    echo "smriti-project: target '$new' already exists. Run 'smriti project forget $new --yes' first if you want to overwrite." >&2
    exit 1
  fi

  mv "$old_dir" "$new_dir"

  local cache_updated=0
  if [ -d "$SLUG_CACHE_DIR" ]; then
    for f in "$SLUG_CACHE_DIR"/*; do
      [ -f "$f" ] || continue
      local slug
      slug=$(read_slug_from_cache "$f" 2>/dev/null) || continue
      if [ "$slug" = "$old" ]; then
        local source_path
        source_path=$(read_source_path_from_cache "$f")
        local tmp="$f.tmp.$$"
        printf 'SLUG=%s\nSOURCE_PATH=%s\n' "$new" "$source_path" > "$tmp"
        mv "$tmp" "$f"
        cache_updated=$((cache_updated + 1))
      fi
    done
  fi

  echo "renamed: $old -> $new"
  echo "  moved $old_dir -> $new_dir"
  echo "  updated $cache_updated slug-cache file(s)"
}

CMD="${1:-}"
shift || true
case "$CMD" in
  new)          cmd_new "$@" ;;
  list)         cmd_list "$@" ;;
  current)      cmd_current "$@" ;;
  forget)       cmd_forget "$@" ;;
  rename)       cmd_rename "$@" ;;
  ""|-h|--help) usage ;;
  *) echo "smriti-project: unknown command '$CMD'" >&2; usage ;;
esac
