#!/usr/bin/env bash
# smriti — umbrella dispatcher. Routes `smriti <command> [args...]` to
# bin/smriti-<command> in the same install directory.
set -e

# Fully resolve symlink chains so $SMRITI_BIN always points to the real bin/.
_self="$0"
while [ -L "$_self" ]; do
  _target=$(readlink "$_self")
  case "$_target" in
    /*) _self="$_target" ;;
    *)  _self="$(cd "$(dirname "$_self")" && pwd -P)/$_target" ;;
  esac
done
SMRITI_BIN="$(cd "$(dirname "$_self")" && pwd -P)"

# The user-facing surface. Internal helpers (slug, latest-doc, default-branch,
# codex-probe, update-check, html) are still dispatchable by name — skills call
# them — they are just not advertised. `smriti --commands` is the single source
# the zsh completion reads, so the two can never drift.
USER_COMMANDS=(board ticket project repo trace factory clean browse config principles-install)

show_help() {
  cat <<EOF
smriti — personal Claude Code skill stack

Usage: smriti [command] [args...]

Run with no arguments in a terminal to open the board — every app, every
project, every ticket, what is running, and what is waiting on you, in your
browser.

Commands:
  board               The front door: the factory board, served locally
  ticket              Work items: add, list, show, start, edit, cancel, rm, done
  project             Bodies of work inside an app: add, list, show, edit, done, rm
  repo                Apps smriti tracks: list, show, edit, current, new, forget, rename
  trace               Run trace: start, emit, end, list, show, tail, stats
  factory             Scriptable listing of tickets and runs (--list)
  clean               Post-merge tidy: delete merged branches and their worktrees
  browse              Browser audit CLI (install, login, audit, update)
  config              Global config get/set/unset/list
  principles-install  Install coding principles into a project's CLAUDE.md

Run 'smriti <command> --help' for details on a specific command.
EOF
}

show_version() {
  local version_file="$SMRITI_BIN/../VERSION"
  if [ -f "$version_file" ]; then
    printf 'smriti %s\n' "$(cat "$version_file")"
  else
    echo "smriti (version unknown)"
  fi
}

CMD="${1:-}"

# Bare `smriti` in a terminal opens the board — the whole point is not having
# to remember what to run. Piped or redirected, it stays the predictable
# non-interactive dispatcher it has always been, so scripts and docs are
# unaffected; `smriti help` always prints help either way.
if [ -z "$CMD" ] && [ -t 1 ] && [ -t 0 ] && [ -x "$SMRITI_BIN/smriti-board" ]; then
  exec "$SMRITI_BIN/smriti-board" open
fi

case "$CMD" in
  ""|help|--help|-h)
    show_help
    exit 0
    ;;
  --version|-V)
    show_version
    exit 0
    ;;
  --commands)
    # Machine-readable, for shell completion. Keeps one list, not two.
    printf '%s\n' "${USER_COMMANDS[@]}" help
    exit 0
    ;;
esac

shift
HELPER="$SMRITI_BIN/smriti-$CMD"

if [ ! -f "$HELPER" ] || [ ! -x "$HELPER" ]; then
  echo "smriti: unknown command '$CMD'" >&2
  echo "" >&2
  echo "Available commands:" >&2
  for cmd in "${USER_COMMANDS[@]}"; do
    echo "  $cmd" >&2
  done
  echo "" >&2
  echo "Run 'smriti help' for usage." >&2
  exit 127
fi

exec "$HELPER" "$@"
