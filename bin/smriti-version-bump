#!/usr/bin/env bash
# smriti-version-bump — VERSION ↔ package.json drift detector + repair tool.
#
# Subcommands:
#   classify [base]     Print state: FRESH | ALREADY_BUMPED | DRIFT_STALE_PKG | DRIFT_UNEXPECTED
#                       'base' defaults to "origin/$(detect-base-branch)"; pass explicitly
#                       to override (e.g., for testing under fixtures).
#   apply <version>     Validate semver, write VERSION + sync package.json (if present).
#   repair              Read VERSION, sync package.json to it. No bump computed.
#   read-version        Print VERSION's contents stripped of CR + whitespace.
#                       (Useful for callers that need a clean version string.)
#
# Exit codes:
#   0   success
#   1   classifier ran, returned a state (always 0 actually — state on stdout)
#   2   malformed input (invalid semver, missing required arg, missing required tool)
#
# Versioning convention: 3-part semver (X.Y.Z). The regex is intentionally
# locked to 3 parts; if smriti ever moves to 4-part, change SEMVER_RE here.
set -e

SEMVER_RE='^[0-9]+\.[0-9]+\.[0-9]+$'

if ! command -v jq >/dev/null 2>&1; then
  echo "smriti-version-bump: jq is required (brew install jq)" >&2
  exit 2
fi

# Strip CR + leading/trailing whitespace from a version string.
# Manual edits + Windows tools love to leave CRLF in VERSION files — silent
# false-DRIFT classification is a nasty failure mode.
clean_version() {
  # Strip CR + LF, then trim surrounding whitespace. Collapsing newlines first
  # ensures multi-line input (e.g., a stray leading blank line in VERSION)
  # doesn't leak through awk's per-line processing.
  printf '%s' "$1" | tr -d '\r\n' | awk '{$1=$1; print}'
}

read_version_file() {
  if [ -f VERSION ]; then
    clean_version "$(cat VERSION)"
  else
    printf ''
  fi
}

read_pkg_version() {
  if [ -f package.json ]; then
    local v
    v=$(jq -r '.version // empty' package.json 2>/dev/null || printf '')
    clean_version "$v"
  else
    printf ''
  fi
}

# Read VERSION on the base ref. Empty if the ref or file doesn't exist.
read_base_version() {
  local base="$1"
  [ -z "$base" ] && { printf ''; return; }
  local v
  v=$(git show "$base:VERSION" 2>/dev/null || printf '')
  clean_version "$v"
}

validate_semver() {
  local v="$1"
  if [[ "$v" =~ $SEMVER_RE ]]; then
    return 0
  else
    return 1
  fi
}

# Detect base branch (origin/HEAD → main / master). Same heuristic as
# the BASE_BRANCH_DETECT resolver, inlined here so this script has no
# resolver dependency.
detect_base() {
  local base
  base=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)
  [ -z "$base" ] && base="main"
  printf 'origin/%s' "$base"
}

cmd_classify() {
  local base="${1:-$(detect_base)}"

  local cur pkg base_v
  cur=$(read_version_file)
  pkg=$(read_pkg_version)
  base_v=$(read_base_version "$base")

  # Define "synced" as: package.json absent, OR pkg.version equals VERSION.
  # An empty cur (no VERSION file) means we have nothing to compare — treat
  # as FRESH so /ship's existing logic creates one.
  if [ -z "$cur" ]; then
    printf 'FRESH\n'
    return 0
  fi

  local pkg_synced=yes
  if [ -f package.json ] && [ "$pkg" != "$cur" ]; then
    pkg_synced=no
  fi

  if [ "$cur" = "$base_v" ] || [ -z "$base_v" ]; then
    # VERSION is at base (or base unknown). pkg should be synced.
    if [ "$pkg_synced" = "yes" ]; then
      printf 'FRESH\n'
    else
      # VERSION matches base but package.json drifted — can't tell which is
      # authoritative. /ship surfaces an AskUserQuestion in this case.
      printf 'DRIFT_UNEXPECTED\n'
    fi
  else
    # VERSION moved past base.
    if [ "$pkg_synced" = "yes" ]; then
      printf 'ALREADY_BUMPED\n'
    else
      # VERSION bumped but pkg didn't follow — repair without re-bumping.
      printf 'DRIFT_STALE_PKG\n'
    fi
  fi
}

cmd_apply() {
  local new="$1"
  [ -z "$new" ] && { echo "smriti-version-bump apply: <version> required" >&2; exit 2; }
  new=$(clean_version "$new")
  validate_semver "$new" || {
    echo "smriti-version-bump apply: '$new' is not a valid 3-part semver (X.Y.Z)" >&2
    exit 2
  }

  printf '%s\n' "$new" > VERSION

  if [ -f package.json ]; then
    local tmp
    tmp=$(mktemp)
    jq --arg v "$new" '.version = $v' package.json > "$tmp" && mv "$tmp" package.json
  fi

  printf '%s\n' "$new"
}

cmd_repair() {
  local cur
  cur=$(read_version_file)
  [ -z "$cur" ] && { echo "smriti-version-bump repair: VERSION is empty or missing" >&2; exit 2; }
  validate_semver "$cur" || {
    echo "smriti-version-bump repair: VERSION ('$cur') is not valid semver — refusing to propagate" >&2
    exit 2
  }

  if [ ! -f package.json ]; then
    echo "smriti-version-bump repair: no package.json to sync" >&2
    return 0
  fi

  local tmp
  tmp=$(mktemp)
  jq --arg v "$cur" '.version = $v' package.json > "$tmp" && mv "$tmp" package.json
  printf '%s\n' "$cur"
}

cmd_read_version() {
  read_version_file
}

CMD="${1:-}"
shift || true

case "$CMD" in
  classify)     cmd_classify "$@" ;;
  apply)        cmd_apply "$@" ;;
  repair)       cmd_repair ;;
  read-version) cmd_read_version ;;
  *)
    cat <<USAGE >&2
usage:
  smriti-version-bump classify [base]      # state: FRESH | ALREADY_BUMPED | DRIFT_STALE_PKG | DRIFT_UNEXPECTED
  smriti-version-bump apply <version>      # validate + write VERSION + sync package.json
  smriti-version-bump repair               # sync package.json to VERSION (no bump)
  smriti-version-bump read-version         # print VERSION stripped of CR/whitespace
USAGE
    exit 2
    ;;
esac
