#!/usr/bin/env bash
# smriti setup — generate skill docs, register slash commands with Claude Code,
# and put bin/ helpers on PATH.
set -e
umask 077

if ! command -v bun >/dev/null 2>&1; then
  echo "Error: bun is required but not installed." >&2
  echo "Install: https://bun.sh" >&2
  exit 1
fi

SMRITI_DIR="$(cd "$(dirname "$0")" && pwd -P)"
SKILLS_DIR="$HOME/.claude/skills"
BIN_DIR="$HOME/.local/bin"

cd "$SMRITI_DIR"

# 1. Install deps
#
# Browser-audit support: ./setup asks once whether to install Chromium for
# /begin's browser verify step. Persisted to ~/.smriti/config as
# `browse_enabled=true|false`. Chromium itself (~140MB) is downloaded on first
# audit by `smriti-browse install` only when browse_enabled=true; the Playwright
# npm package itself is small and always installed.
SMRITI_HOME="${SMRITI_HOME:-$HOME/.smriti}"
SMRITI_CONFIG_FILE="$SMRITI_HOME/config"
mkdir -p "$SMRITI_HOME"
chmod 700 "$SMRITI_HOME" 2>/dev/null || true

BROWSE_ENABLED=""
if [ -f "$SMRITI_CONFIG_FILE" ]; then
  BROWSE_ENABLED=$(grep -E '^browse_enabled=' "$SMRITI_CONFIG_FILE" 2>/dev/null | tail -1 | cut -d= -f2-)
fi

if [ -z "$BROWSE_ENABLED" ]; then
  echo ""
  echo "smriti can capture screenshots + ARIA/console audits of rendered UI in /begin's verify step, via a Playwright wrapper."
  echo "First audit will download ~140MB of Chromium. The npm package itself is small."
  if [ -t 0 ]; then
    printf "Enable browser-audit support? [Y/n] "
    # Tolerate EOF (Ctrl-D) — `set -e` would otherwise kill setup on a
    # non-zero `read` exit. Empty answer hits the default branch (true) below.
    read -r ANSWER || ANSWER=""
  else
    # Non-interactive shell (e.g., CI): default to disabled, user can flip later.
    ANSWER="n"
    echo "  (non-interactive shell — defaulting to disabled; flip later with: smriti-config set browse_enabled true)"
  fi
  case "$ANSWER" in
    n|N|no|NO) BROWSE_ENABLED=false ;;
    *)         BROWSE_ENABLED=true ;;
  esac
  printf 'browse_enabled=%s\n' "$BROWSE_ENABLED" >> "$SMRITI_CONFIG_FILE"
  echo "  saved: browse_enabled=$BROWSE_ENABLED  (edit $SMRITI_CONFIG_FILE to change)"
  echo ""
fi

if [ -f package.json ]; then
  if [ "$BROWSE_ENABLED" = "true" ]; then
    bun install --silent 2>/dev/null || bun install
  else
    # User opted out: skip Playwright's postinstall Chromium download.
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 bun install --silent 2>/dev/null \
      || PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 bun install
  fi
fi

# 2. Generate SKILL.md from .tmpl files (when the engine exists)
if [ -f scripts/gen-skill-docs.ts ]; then
  bun run gen:skill-docs
fi

# 3. Register skills with Claude Code (one symlink per skill dir into ~/.claude/skills/<skill-name>/)
#
# Filesystem-driven discovery: every immediate subdir of $SMRITI_DIR that contains a SKILL.md
# is a skill. v0.6.0 renamed /office-hours → /brainstorm and added /debug in the repo but the
# old hardcoded SKILL_NAMES array was never updated — so setup silently skipped both new
# skills on every re-run. Driving registration off the filesystem makes the source of truth
# the skill dirs themselves; adding or renaming a skill no longer requires also editing setup.
mkdir -p "$SKILLS_DIR"
REGISTERED=0
for src in "$SMRITI_DIR"/*/; do
  src="${src%/}"
  [ -f "$src/SKILL.md" ] || continue
  name=$(basename "$src")
  dest="$SKILLS_DIR/$name"

  # Warn if a non-smriti skill already lives at this path
  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    echo "⚠  $dest exists and is not a symlink — skipping. Remove it manually if you want smriti to take over /$name." >&2
    continue
  fi
  if [ -L "$dest" ] && [ "$(readlink "$dest")" != "$src" ]; then
    echo "ℹ  Replacing existing symlink at $dest (pointed elsewhere)" >&2
  fi

  ln -sfn "$src" "$dest"
  echo "✓ /$name"
  REGISTERED=$((REGISTERED + 1))
done

# Clean up stale smriti-managed symlinks — ones that point into $SMRITI_DIR but whose source
# no longer exists. This is what catches a /office-hours symlink left behind after the skill
# was renamed to /brainstorm. We only touch symlinks whose target prefix is $SMRITI_DIR, so
# user-managed entries in $SKILLS_DIR are never affected.
REMOVED=0
for entry in "$SKILLS_DIR"/*; do
  [ -L "$entry" ] || continue
  target=$(readlink "$entry")
  case "$target" in
    "$SMRITI_DIR"/*)
      [ -d "$target" ] && continue
      rm "$entry"
      echo "✗ removed stale /$(basename "$entry") (source no longer in repo)"
      REMOVED=$((REMOVED + 1))
      ;;
  esac
done

# 4. Put the umbrella dispatcher on PATH (~/.local/bin/smriti)
#
# Only the dispatcher is symlinked. Individual bin/smriti-* helpers are invoked
# through the dispatcher (`smriti <command> [args...]`), which resolves the repo's
# bin/ directory via its own symlink chain. Internal helpers that call siblings
# already resolve via dirname($0) — the dispatcher's exec preserves $0.
DISPATCHER="$SMRITI_DIR/bin/smriti"
if [ -f "$DISPATCHER" ]; then
  mkdir -p "$BIN_DIR"
  chmod +x "$DISPATCHER"
  # Ensure all helpers are executable too (dispatcher exec's them directly).
  for helper in "$SMRITI_DIR"/bin/smriti-*; do
    [ -f "$helper" ] && chmod +x "$helper"
  done
  ln -sfn "$DISPATCHER" "$BIN_DIR/smriti"
  echo "✓ smriti → $DISPATCHER"

  # Clean up stale per-helper symlinks from pre-umbrella installs. Only remove
  # symlinks whose target points into this smriti repo's bin/ — never touch
  # foreign binaries that happen to share the smriti- prefix.
  CLEANED=0
  for entry in "$BIN_DIR"/smriti-*; do
    [ -L "$entry" ] || continue
    target=$(readlink "$entry")
    case "$target" in
      "$SMRITI_DIR"/bin/*)
        rm "$entry"
        echo "  ✗ removed stale $(basename "$entry") (now routed through dispatcher)"
        CLEANED=$((CLEANED + 1))
        ;;
    esac
  done
  [ "$CLEANED" -gt 0 ] && echo "  ($CLEANED stale helper symlink(s) cleaned up)"

  case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *) echo "" && echo "ℹ  Add $BIN_DIR to your PATH:" && echo "    export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
  esac
fi

# 5. Install zsh completions
COMPLETIONS_SRC="$SMRITI_DIR/completions/_smriti"
if [ -f "$COMPLETIONS_SRC" ]; then
  COMPLETIONS_DIR="$HOME/.local/share/zsh/site-functions"
  mkdir -p "$COMPLETIONS_DIR"
  ln -sfn "$COMPLETIONS_SRC" "$COMPLETIONS_DIR/_smriti"
  echo "✓ zsh completions → $COMPLETIONS_DIR/_smriti"

  # Invalidate zsh's completion cache. compinit's staleness check is a daily
  # timestamp plus a file-count heuristic — it does NOT notice that an existing
  # completion file changed. So without this, a smriti update installs new
  # subcommands that never appear in tab completion until the user happens to
  # delete the dump themselves, which nobody thinks to do.
  _dumps=$(ls -d "$HOME"/.zcompdump* 2>/dev/null | wc -l | tr -d ' ')
  if [ "${_dumps:-0}" -gt 0 ]; then
    rm -f "$HOME"/.zcompdump*
    echo "✓ cleared zsh completion cache ($_dumps file(s)) — new commands appear in the next shell"
  fi
  unset _dumps

  # Check if the completions dir is in fpath
  if [[ ":${FPATH}:" != *":$COMPLETIONS_DIR:"* ]]; then
    echo ""
    echo "ℹ  Add to your .zshrc to enable tab completion:"
    echo "    fpath=(\$HOME/.local/share/zsh/site-functions \$fpath)"
    echo "    autoload -Uz compinit && compinit"
  fi
fi

echo ""
if [ "$REGISTERED" -eq 0 ]; then
  echo "Setup complete (no skills registered yet — run again after building skill SKILL.md.tmpl files)."
else
  if [ "$REMOVED" -gt 0 ]; then
    echo "Setup complete. $REGISTERED skill(s) registered, $REMOVED stale symlink(s) removed."
  else
    echo "Setup complete. $REGISTERED skill(s) registered."
  fi
  echo "Try: /bootstrap"
fi
